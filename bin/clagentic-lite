#!/bin/sh
# clagentic-lite :: CLI entry point
# Clone once to $CLAGENTIC_LITE_HOME. Use this CLI for all lifecycle operations.
#
# Subcommands:
#   init [--reconfigure]          first-time setup: prereqs, global config, symlink, plugin install
#   enroll [--self] [--force] [PATH...]   wire hooks + init DBs for a repo
#   unenroll [--purge] [PATH]             remove clagentic hooks, deregister
#   list                                  show enrolled repos + status
#   doctor                                diagnostics punch list
#   rotate                                re-stamp every enrolled repo's settings.json with the current router token
#   update [--restamp] [--refresh-config] git pull + re-prereq + re-stamp shims + plugin update
#   recall [keywords...]                  search session memory for matching summaries
#   remember "<note>" [tags]              store a manual memory entry
#   show memory|gates [N]         pretty-print last N rows from .clagentic/ DBs
#   export [--output PATH]        write self-contained HTML report of memory + gates
#   gates <subcmd> [args...]      proxy to $CLAGENTIC_LITE_HOME/scripts/gates.sh
#                                 (ship, review, adversarial, digest, status, tail, ...)
#
# Design: tool is cloned once (default: ~/.clagentic/lite, override via
# $CLAGENTIC_LITE_HOME). Per-repo enrollment writes .clagentic/lite/{audit,memory}.db,
# thin shims in .git/hooks/ that call back to $CLAGENTIC_LITE_HOME/scripts/, and
# .claude/settings.json + symlink to .claude/commands so Claude Code picks up
# hook wiring and slash commands.
# The five role agents (builder, reviewer, auditor, merge-gate, troubleshooter) and
# commentary skills (/infosec-rt, /eng-consult) are installed globally via
# 'claude plugin install' at init time — no per-repo copies.
# The tool repo itself is never the thing under gates by default.

set -e

# Resolve CLAGENTIC_LITE_HOME: new canonical var, with back-compat for old CLAGENTIC_HOME.
# Priority: CLAGENTIC_LITE_HOME wins; else CLAGENTIC_HOME (deprecated); else default path.
: "${CLAGENTIC_LITE_HOME:=${CLAGENTIC_HOME:-$HOME/.clagentic/lite}}"
[ -n "${CLAGENTIC_HOME:-}" ] && [ -z "${CLAGENTIC_LITE_HOME_SET:-}" ] && {
  printf 'clagentic-lite: CLAGENTIC_HOME is deprecated; use CLAGENTIC_LITE_HOME\n' >&2
  export CLAGENTIC_LITE_HOME_SET=1
}
export CLAGENTIC_LITE_HOME

# _bootstrap_resolve_self
# Resolve $0 to its final on-disk target, following symlinks, WITHOUT relying
# on scripts/platform.sh (not sourced yet at this point — this function exists
# to find platform.sh in the first place, so it cannot depend on ds_realpath).
# Normal invocation is via the init-created symlink at ~/.local/bin/clagentic-lite,
# which points into the checkout's bin/ dir — dirname on the raw symlink path
# resolves to ~/.local/bin, not the checkout, breaking self-locate (lr-121496 /
# GH #135). GNU readlink -f is not assumed (absent on macOS/BSD by default).
# Resolution order, most to least capable:
#   1. readlink -f (GNU coreutils, and modern macOS since it gained -f too)
#   2. python3 os.path.realpath (present on most dev machines, symlink-safe)
#   3. manual readlink loop (POSIX readlink with no -f; follows one hop at a
#      time, bounded to avoid an infinite loop on a symlink cycle)
#   4. raw $0, unresolved (last resort — matches pre-fix behavior)
# Sets _BOOTSTRAP_SELF and _BOOTSTRAP_SELF_METHOD (used in the failure message
# below to name which attempts were made, not just the default home).
_bootstrap_resolve_self() {
  _brs_target="$1"

  if command -v readlink >/dev/null 2>&1 && readlink -f "$_brs_target" >/dev/null 2>&1; then
    _BOOTSTRAP_SELF=$(readlink -f "$_brs_target" 2>/dev/null)
    _BOOTSTRAP_SELF_METHOD="readlink -f"
    return 0
  fi

  if command -v python3 >/dev/null 2>&1; then
    _brs_py=$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$_brs_target" 2>/dev/null)
    if [ -n "$_brs_py" ]; then
      _BOOTSTRAP_SELF="$_brs_py"
      _BOOTSTRAP_SELF_METHOD="python3 os.path.realpath"
      return 0
    fi
  fi

  if command -v readlink >/dev/null 2>&1; then
    # No readlink -f: follow one symlink hop at a time (POSIX readlink without
    # -f only resolves a single level). Bounded loop guards against a cycle.
    _brs_cur="$_brs_target"
    _brs_hops=0
    while [ -L "$_brs_cur" ] && [ "$_brs_hops" -lt 20 ]; do
      _brs_link=$(readlink "$_brs_cur" 2>/dev/null) || break
      case "$_brs_link" in
        /*) _brs_cur="$_brs_link" ;;
        *)  _brs_cur="$(dirname "$_brs_cur")/$_brs_link" ;;
      esac
      _brs_hops=$((_brs_hops+1))
    done
    _brs_dir=$(cd "$(dirname "$_brs_cur")" 2>/dev/null && pwd) || _brs_dir=""
    if [ -n "$_brs_dir" ]; then
      _BOOTSTRAP_SELF="$_brs_dir/$(basename "$_brs_cur")"
      _BOOTSTRAP_SELF_METHOD="readlink (manual hop, ${_brs_hops} hop(s))"
      return 0
    fi
  fi

  # Last resort: raw $0, unresolved. Still lets the plain (non-symlinked)
  # invocation case work, and callers can tell from _BOOTSTRAP_SELF_METHOD
  # that no symlink resolution actually happened.
  _BOOTSTRAP_SELF="$_brs_target"
  _BOOTSTRAP_SELF_METHOD="unresolved (no readlink -f, no python3, no readlink)"
  return 0
}

# Source platform shims from our own install tree.
SCRIPTS_DIR="$CLAGENTIC_LITE_HOME/scripts"
if [ ! -f "$SCRIPTS_DIR/platform.sh" ]; then
  # Bootstrap path: being invoked before init has verified $CLAGENTIC_LITE_HOME, or
  # when the install directory has moved (e.g. ~/.clagentic-lite -> ~/.clagentic/lite
  # migration), or invoked through the ~/.local/bin/clagentic-lite symlink that
  # init creates. Resolve $0 through symlinks first (see _bootstrap_resolve_self)
  # before taking dirname — otherwise a symlinked $0 resolves against the symlink's
  # own directory (e.g. ~/.local/bin) instead of the real checkout (lr-121496).
  _bootstrap_resolve_self "$0"
  _SELF_RESOLVED="$_BOOTSTRAP_SELF"
  _SELF_DIR="$(cd "$(dirname "$_SELF_RESOLVED")" && pwd)"
  _SELF_SCRIPTS="$(dirname "$_SELF_DIR")/scripts"
  if [ -f "$_SELF_SCRIPTS/platform.sh" ]; then
    # Binary's own directory is valid — realign CLAGENTIC_LITE_HOME to match.
    CLAGENTIC_LITE_HOME="$(dirname "$_SELF_DIR")"
    export CLAGENTIC_LITE_HOME
    SCRIPTS_DIR="$_SELF_SCRIPTS"
  fi
fi
if [ ! -f "$SCRIPTS_DIR/platform.sh" ]; then
  printf 'clagentic-lite: cannot find scripts/platform.sh in %s\n' "$CLAGENTIC_LITE_HOME" >&2
  printf 'Resolution attempts made:\n' >&2
  printf '  invoked as ($0): %s\n' "$0" >&2
  if [ -n "${_BOOTSTRAP_SELF:-}" ]; then
    printf '  resolved self path (%s): %s\n' "${_BOOTSTRAP_SELF_METHOD:-unknown}" "$_BOOTSTRAP_SELF" >&2
    printf '  checked for scripts/platform.sh under: %s\n' "${_SELF_SCRIPTS:-$CLAGENTIC_LITE_HOME/scripts}" >&2
  fi
  printf '  default/configured CLAGENTIC_LITE_HOME: %s\n' "$CLAGENTIC_LITE_HOME" >&2
  printf 'Set CLAGENTIC_LITE_HOME to the clagentic-lite checkout directory.\n' >&2
  exit 1
fi
. "$SCRIPTS_DIR/platform.sh"

SHARE_DIR="$CLAGENTIC_LITE_HOME/share"
REGISTRY="$HOME/.local/state/clagentic/registry"

# GLOBAL_CONFIG (lr-7939f8): lives under the PRODUCT namespace
# ~/.config/clagentic/lite/, not the brand root ~/.config/clagentic/ --
# clagentic is the brand shared by multiple tools (clagentic-loadout uses
# ~/.config/clagentic/loadout/, 34 occurrences, zero exceptions -- the
# reference implementation), clagentic-lite is one product under it. This
# mirrors the two brand/product splits this codebase already performs for
# CLAGENTIC_LITE_HOME (~/.clagentic-lite -> ~/.clagentic/lite, cmd_update)
# and per-repo ephemeral state (.clagentic/<f> -> .clagentic/lite/<f>,
# cmd_update) -- the global config was the one holdout.
#
# OLD_GLOBAL_CONFIG is the pre-lr-7939f8 brand-root path. It is READ as a
# back-compat fallback (ds_load_global_env, scripts/platform.sh) during a
# deprecation window so an un-updated install does not silently lose its
# config and revert to defaults, and it is the source path for the
# migrate-and-warn step in cmd_update (_migrate_global_config_brand_path,
# below). Nothing in this file WRITES to OLD_GLOBAL_CONFIG going forward.
GLOBAL_CONFIG="$HOME/.config/clagentic/lite/config"
OLD_GLOBAL_CONFIG="$HOME/.config/clagentic/config"

# Load ~/.config/clagentic/lite/config, with a back-compat read of the old
# ~/.config/clagentic/config path (ds_load_global_env, scripts/platform.sh)
# — the same operator-owned global config every other runtime entry point
# (hooks, gates.sh, llm-client.sh, memory.sh, smoke.sh) reads via ds_load_env.
# Before lr-33fb89, bin/clagentic-lite was not on that list: every
# CLAGENTIC_* var it reads directly (chiefly CLAGENTIC_ROUTER_URL/_TOKEN/
# _INJECT_AGENT_MODEL/_BEDROCK_MODE) was silently inert unless the calling
# shell had already exported it — writing it into the config file exactly
# as share/config.example and the README instruct had no effect.
#
# THIS IS THE GLOBAL LOAD ONLY — deliberately NOT the combined ds_load_env.
# ds_load_env also dot-sources <repo-root>/.clagentic/config, which is REPO
# CONTENT, not operator content: dot-sourcing EXECUTES it. Calling the
# combined loader unconditionally here, at the CLI's own top-level dispatch,
# would mean `clagentic-lite doctor` (or `list`, or `update`) run with cwd
# inside ANY git repo — including one merely cloned out of curiosity, never
# enrolled, never trusted — executes that repo's .clagentic/config with zero
# prior trust signal (bobbie.sast.3, PR #152 review). gates.sh/llm-client.sh/
# memory.sh/smoke.sh/every hook shim keep using the combined ds_load_env
# unchanged: they only ever run post-enrollment (invoked by a repo's own
# git hooks, or by an operator already working inside a repo they enrolled),
# so that precondition holds for them and does not hold for the CLI's own
# bootstrap. See _cli_maybe_load_repo_env (below, called from dispatch)
# for where and how the repo-local layer is loaded instead — gated on
# registry membership, not unconditional.
#
# PRECEDENCE for the global layer (deliberate, matches the existing
# ds_load_env contract, not assumed inert): ds_load_global_env sources the
# global config with `set -a` around a dot-source, so a config-file value
# UNCONDITIONALLY OVERWRITES an already-exported shell value for the same
# key — that is the accepted, tested contract at every other entry point.
# This call matches it for consistency: a CLAGENTIC_ROUTER_* value set in
# the global config now behaves identically whether the CLI reads it or a
# gate script does.
#
# THE ONE DELIBERATE EXCEPTION: CLAGENTIC_LITE_HOME. SCRIPTS_DIR (above)
# and every path resolved from it (_bootstrap_resolve_self, platform.sh
# itself) were already locked in from the bootstrap block at the top of
# this file BEFORE platform.sh — and therefore ds_load_global_env — could
# even be sourced (classic chicken-and-egg: the config file that might
# redefine CLAGENTIC_LITE_HOME lives inside the tree CLAGENTIC_LITE_HOME
# points at, so it cannot be consulted to find itself). Letting the normal
# config-wins behavior silently repoint CLAGENTIC_LITE_HOME after that
# would split the process: SCRIPTS_DIR/platform.sh already loaded from tree
# A, but SHARE_DIR (above) and every subsequent path built from
# CLAGENTIC_LITE_HOME would point at tree B — a real, silent inconsistency,
# not simulated inertness. So CLAGENTIC_LITE_HOME is explicitly re-pinned
# to the bootstrap-resolved value immediately after the load, overriding
# whatever the config file said for that one key. This mirrors
# share/config.example's own framing of CLAGENTIC_LITE_HOME ("Set
# automatically by `clagentic-lite init`. Edit only if you move the
# install.") — the file's copy is meant to describe the current install,
# not redirect it live. CLAGENTIC_HOME's deprecation-warning check (doctor
# check 11, below) is unaffected either way: it only inspects whether
# CLAGENTIC_HOME is set in the environment at report time, which this load
# does not touch (share/config.example defines CLAGENTIC_LITE_HOME only,
# never the deprecated CLAGENTIC_HOME).
_PRE_ENV_LOAD_CLAGENTIC_LITE_HOME="$CLAGENTIC_LITE_HOME"
ds_load_global_env
CLAGENTIC_LITE_HOME="$_PRE_ENV_LOAD_CLAGENTIC_LITE_HOME"
export CLAGENTIC_LITE_HOME
LOCAL_BIN="$HOME/.local/bin"
CLI_SYMLINK="$LOCAL_BIN/clagentic-lite"

# Shim template version marker. Bump this string when the template content
# changes so `clagentic-lite update` knows to re-stamp enrolled repos.
SHIM_VERSION="v3"

# Claude Code artifact version markers. Bump when the corresponding template
# changes so `clagentic-lite update` re-stamps enrolled repos automatically.
# v7 -> v8 (lr-684947): MIGRATION, not a content-only change. Closes the
# empty-token regression (an enrolled repo with no router configured used
# to get an empty ANTHROPIC_AUTH_TOKEN stamped, silently shadowing ambient
# auth) and adds the apiKeyHelper single-copy path. Without this bump,
# `update` sees a matching version on an already-stamped v7 file and skips
# the restamp, leaving every existing enrolled repo on the broken behavior
# forever — see AGENTS.md "Template version-bump protocol".
CLAUDE_SETTINGS_VERSION="v8"
# CLAUDE_MD_VERSION is retired — replaced by three narrower constants below.
# The variable is kept as a tombstone so doctor/update version-compare calls
# against old installed files continue to work during the transition period.
CLAUDE_MD_VERSION="v9"
# Thin enrollment notice in the committed repo CLAUDE.md. Bump only on
# notice text changes — stable by design.
CLAUDE_NOTICE_VERSION="v2"
# Local .clagentic/lite/builder-contract.md — full builder rules, never committed.
# Bump on any content change; cheap restamp (gitignored).
CLAUDE_CONTRACT_VERSION="v3"
# Local wrapper CLAUDE.md — rich local dashboard, never committed.
# Bump on any template change; cheap restamp (local).
CLAUDE_WRAPPER_VERSION="v2"
# Wrapper .claude/settings.json — lifecycle hook wiring for wrapper-level sessions.
# Bump on any content change to trigger restamp via _restamp_repo_artifacts.
CLAUDE_WRAPPER_SETTINGS_VERSION="v1"

# Rendered plugins/clagentic-lite agent-file template version. Bump on any
# change to the RENDER LOGIC in _render_clagentic_lite_plugin_dir (e.g. the
# injection point, the triple list, the plugin.json shape) — NOT on every
# content edit to plugins/clagentic-lite/agents/*.md, which are re-read from
# the checkout on every render regardless (lr-1b5a31: single-plugin,
# config-aware render, replacing the old dual-plugin clagentic-lite-router
# design). Combined with a live config fingerprint (_render_config_fingerprint)
# into the stamp written to the rendered plugin.json's "clagenticStamp" field
# — see "Render stamp + self-heal" in AGENTS.md.
PLUGIN_RENDER_VERSION="v1"

# Claude Code lifecycle hook scripts (session-start.sh, pre-write-guard.sh,
# etc). Source of truth: share/hook-shims/<name>.template (lr-57db23 —
# relocated out of the live, tracked $CLAGENTIC_LITE_HOME/.claude/hooks/ so
# the tool's own repo no longer self-executes an always-tracked copy of its
# own product; see AGENTS.md file-map + docs/DESIGN.md). Materialized into
# $CLAGENTIC_LITE_HOME/.claude/hooks/ at `init`/`update` time — this is the
# ONE copy every enrolled repo's settings.json calls back into by absolute
# path (enrolled repos never receive their own copy of these scripts).
# Bump on any content change to any hook template so `clagentic-lite update`
# re-stamps existing installs.
CLAUDE_HOOKS_VERSION="v4"

# Single source of truth for which hook scripts are stamped into
# $CLAGENTIC_LITE_HOME/.claude/hooks/. Space-separated POSIX-sh string (no
# arrays) — _stamp_claude_hooks (init/update) is the sole consumer.
CLAGENTIC_HOOK_SCRIPTS="session-start.sh prompt-inject.sh pre-bash-guard.sh pre-write-guard.sh post-tool-nudge.sh stop-summarize.sh"

# Single source of truth for the security-gate tool list. Adding a new
# scanner means editing this one line — _run_prereq_checks (init/update)
# and cmd_doctor both iterate this list, so they stay in sync.
# Space-separated POSIX-sh string (no arrays).
CLAGENTIC_SECURITY_TOOLS="gitleaks semgrep osv-scanner"

# Global config schema version (lr-e33f73). Follows the same version-constant
# pattern as SHIM_VERSION/CLAUDE_SETTINGS_VERSION/etc above, applied to the
# one generated artifact that never had it: share/config.example. Stamped
# into $GLOBAL_CONFIG as CLAGENTIC_CONFIG_SCHEMA_VERSION by
# _write_global_config, always re-stamped to the current value on either a
# fresh `init` or `init --reconfigure` (lr-25e73e: --reconfigure now MERGES
# rather than clobbers an existing config, but this one key is exempt from
# preservation — it is auto-managed bookkeeping, never a hand-set value).
# `doctor`'s drift check and `update --refresh-config`'s append pass (below,
# lr-25e73e item 3) both compare the KEY SET in share/config.example against
# the installed config directly via the shared _config_key_set/
# _config_missing_keys helpers; neither depends on this constant. Bump on any
# structural change to config.example's key set (add/remove/rename a key) —
# content-only comment edits do not require a bump.
CONFIG_SCHEMA_VERSION="v1"

say()  { printf '[clagentic-lite] %s\n' "$*"; }
warn() { printf '[clagentic-lite] WARN: %s\n' "$*" 1>&2; }
die()  { printf '[clagentic-lite] ERROR: %s\n' "$*" 1>&2; exit 1; }

# _cli_maybe_load_repo_env — the CLI's one trust gate for
# ds_load_repo_env (scripts/platform.sh), called once from dispatch
# (lr-33fb89 fold-in, bobbie.sast.3). Loads <repo-root>/.clagentic/config
# (and legacy .env) ONLY when ds_repo_root()'s result is already a member
# of $REGISTRY — i.e. the operator ran `clagentic-lite enroll` for that
# exact repo at some point in the past. This is the ONLY place in
# bin/clagentic-lite that decides whether to trust repo content enough to
# execute it; every dispatch case that needs the repo-local layer calls
# this one function rather than re-deriving the trust check.
#
# WHY REGISTRY MEMBERSHIP IS THE RIGHT TRUST SIGNAL: it is the one
# enrollment marker that lives OUTSIDE the repo (at
# $HOME/.local/state/clagentic/registry, operator-machine-local), so a
# hostile repo cannot forge its own trust by shipping a fake marker file
# inside itself — the only way a path lands in REGISTRY is a prior,
# deliberate `enroll` run by the operator on THIS machine (bin/clagentic-lite
# _enroll_one, REGISTRY append). Compare to in-repo markers
# (.clagentic/lite/, .claude/settings.json, the CLAUDE.md notice stamp):
# those are exactly the kind of file a hostile clone could plant to look
# pre-enrolled and defeat a marker-in-repo trust check.
#
# WHY `enroll` ITSELF DOES NOT CALL THIS: enroll is how a repo BECOMES
# trusted — it cannot require prior enrollment (REGISTRY membership) as a
# precondition for reading the repo it is in the middle of enrolling
# without becoming unable to ever enroll a first repo. But it also must not
# execute that repo's OWN .clagentic/config as the price of enrolling it —
# doing so would be exactly the pre-trust execution this gate exists to
# close, just moved one subcommand over. So `enroll` skips the repo-local
# layer entirely at the CLI-bootstrap level: a per-repo CLAGENTIC_ROUTER_*
# override is not honored on the FIRST `enroll` invocation for a given
# repo, only from the next invocation onward (doctor/update/etc., once
# REGISTRY membership exists) — a narrow, deliberate behavior change from
# this PR's earlier revision (which combined ds_load_env unconditionally
# and so DID pick up a repo-local override at enroll time). The global
# config (ds_load_global_env, already loaded unconditionally above) still
# applies at enroll time exactly as before — only the repo-local override
# layer is deferred.
#
# FAIL TOWARD NOT EXECUTING: ds_repo_root() empty (not in a git repo, no
# wrapper pointer) or REGISTRY missing/repo not listed both leave the
# repo-local layer unloaded — the safe default. `enroll`/`unenroll`/`init`
# never call this at all (see dispatch, below); `unenroll` doesn't need to
# skip it explicitly since the repo being unenrolled is, by definition,
# still a REGISTRY member at the moment unenroll runs.
_cli_maybe_load_repo_env() {
  [ -f "$REGISTRY" ] || return 0
  _cmlre_root=$(ds_repo_root)
  [ -n "$_cmlre_root" ] || return 0
  grep -qxF "$_cmlre_root" "$REGISTRY" 2>/dev/null || return 0
  ds_load_repo_env
}

# ---------------------------------------------------------------- helpers

# Portable absolute path resolution (no readlink -f on macOS by default).
ds_realpath() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1" 2>/dev/null || printf '%s' "$1"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$1" 2>/dev/null
  else
    # POSIX fallback: cd to dir, print pwd + basename.
    _rp_dir="$(dirname "$1")"
    _rp_base="$(basename "$1")"
    (cd "$_rp_dir" 2>/dev/null && printf '%s/%s' "$(pwd)" "$_rp_base") || printf '%s' "$1"
  fi
}

# Read the version marker from an installed hook shim.
shim_version() {
  _sv_file="$1"
  [ -f "$_sv_file" ] || { printf ''; return; }
  awk '/clagentic-lite hook shim/ { print; exit }' "$_sv_file" 2>/dev/null | sed 's/.*· \(v[^ ]*\) ·.*/\1/'
}

# Read the version marker from an installed .claude/settings.json.
# Looks for "clagentic-settings-version: vN" in the $comment field.
claude_settings_version() {
  _csv_file="$1"
  [ -f "$_csv_file" ] || { printf ''; return; }
  grep -o 'clagentic-settings-version: v[^ ·"]*' "$_csv_file" 2>/dev/null | sed 's/clagentic-settings-version: //'
}

# Read the version marker from an installed CLAUDE.md.
# Handles both old marker (clagentic-claude-md-version) and the new notice
# marker (clagentic-notice-version) so version checks work during transition.
claude_md_version() {
  _cmv_file="$1"
  [ -f "$_cmv_file" ] || { printf ''; return; }
  grep -o 'clagentic-claude-md-version: v[^ ·>]*' "$_cmv_file" 2>/dev/null | sed 's/clagentic-claude-md-version: //'
}

# Read the thin-notice version from an installed repo CLAUDE.md.
claude_notice_version() {
  _cnv_file="$1"
  [ -f "$_cnv_file" ] || { printf ''; return; }
  grep -o 'clagentic-notice-version: v[^ ·>]*' "$_cnv_file" 2>/dev/null | sed 's/clagentic-notice-version: //'
}

# Read the builder-contract version from .clagentic/lite/builder-contract.md.
claude_contract_version() {
  _ccv_file="$1"
  [ -f "$_ccv_file" ] || { printf ''; return; }
  grep -o 'clagentic-contract-version: v[^ ·>]*' "$_ccv_file" 2>/dev/null | sed 's/clagentic-contract-version: //'
}

# Read the wrapper CLAUDE.md version.
claude_wrapper_version() {
  _cwv_file="$1"
  [ -f "$_cwv_file" ] || { printf ''; return; }
  grep -o 'clagentic-wrapper-version: v[^ ·>]*' "$_cwv_file" 2>/dev/null | sed 's/clagentic-wrapper-version: //'
}

# Read the wrapper .claude/settings.json version.
claude_wrapper_settings_version() {
  _cwsv_file="$1"
  [ -f "$_cwsv_file" ] || { printf ''; return; }
  grep -o 'clagentic-wrapper-settings-version: v[^ ·>]*' "$_cwsv_file" 2>/dev/null | sed 's/clagentic-wrapper-settings-version: //'
}

# Read the version marker from an installed Claude Code lifecycle hook script
# under $CLAGENTIC_LITE_HOME/.claude/hooks/.
claude_hooks_version() {
  _chv_file="$1"
  [ -f "$_chv_file" ] || { printf ''; return; }
  grep -o 'clagentic-hooks-version: v[^ ·>]*' "$_chv_file" 2>/dev/null | sed 's/clagentic-hooks-version: //'
}

# Materialize $CLAGENTIC_LITE_HOME/.claude/hooks/*.sh from
# share/hook-shims/*.sh.template (lr-57db23). This is the tool stamping its
# OWN .claude/hooks/ — not a per-enrolled-repo copy. Every enrolled repo's
# generated .claude/settings.json points its hook `command` entries at these
# same materialized paths by absolute $CLAGENTIC_LITE_HOME reference, so this
# is the single copy that actually executes for every enrolled machine.
#
# Explicit opt-in only: called from cmd_init and cmd_update, never implicitly
# on every invocation — a maintainer working in this checkout who wants the
# tool to dogfood itself runs `clagentic-lite init` (or `enroll --self`) once,
# same as any other consuming machine. Cloning the repo alone does not wire
# anything; see AGENTS.md and README.md "Developing clagentic-lite itself".
#
# Renders to a same-directory temp file, then atomic `mv` over the real
# target — mirrors _stamp_claude_settings's validate-then-temp-then-move
# shape (PR #146 review 5209002495, finding 3) so a failed/partial sed run
# can never leave a truncated, empty hook script sitting at the target path.
#
# Args: (none — always targets $CLAGENTIC_LITE_HOME/.claude/hooks/)
# Prints the number of hook scripts (re)stamped to stdout.
_stamp_claude_hooks() {
  _sch_dir="$CLAGENTIC_LITE_HOME/.claude/hooks"
  mkdir -p "$_sch_dir" || { warn "cannot create $_sch_dir"; printf '0\n'; return 1; }
  _sch_count=0
  for _sch_name in $CLAGENTIC_HOOK_SCRIPTS; do
    _sch_template="$SHARE_DIR/hook-shims/${_sch_name}.template"
    if [ ! -f "$_sch_template" ]; then
      warn "hook template missing: $_sch_template"
      continue
    fi
    _sch_target="$_sch_dir/$_sch_name"
    _sch_tmp="${_sch_target}.tmp.$$"
    sed "s|__CLAGENTIC_LITE_HOME__|$CLAGENTIC_LITE_HOME|g" "$_sch_template" > "$_sch_tmp"
    chmod +x "$_sch_tmp"
    mv -f "$_sch_tmp" "$_sch_target"
    _sch_count=$((_sch_count + 1))
  done
  printf '%d\n' "$_sch_count"
}

# Stamp a hook shim from share/hook-shims/<name>.template into a repo's
# .git/hooks/<name>. Substitutes __CLAGENTIC_LITE_HOME__ with the actual path.
# Args: TEMPLATE_NAME HOOKS_DIR
# Returns: 0 stamped, 1 refused (existing non-clagentic hook, no --force)
stamp_shim() {
  _ss_name="$1"
  _ss_hooks_dir="$2"
  _ss_target="$_ss_hooks_dir/$_ss_name"
  _ss_template="$SHARE_DIR/hook-shims/${_ss_name}.template"
  [ -f "$_ss_template" ] || { warn "template missing: $_ss_template"; return 1; }

  # If the hook file exists and is NOT clagentic-owned, refuse unless --force.
  if [ -f "$_ss_target" ]; then
    if grep -q 'managed-by: clagentic' "$_ss_target" 2>/dev/null; then
      : # clagentic-owned — overwrite silently
    elif [ "${ENROLL_FORCE:-0}" = "1" ]; then
      warn "overwriting existing non-clagentic hook at $_ss_target (--force)"
    else
      warn "existing hook at $_ss_target is not clagentic-managed — skipping (use --force to overwrite)"
      return 1
    fi
  fi

  # Write shim: substitute __CLAGENTIC_LITE_HOME__ with the real path.
  sed "s|__CLAGENTIC_LITE_HOME__|$CLAGENTIC_LITE_HOME|g" "$_ss_template" > "$_ss_target"
  chmod +x "$_ss_target"
  return 0
}

# _ipv4_octet_in_range / _host_is_local_ip4 / _router_url_classify were
# relocated to scripts/platform.sh as ds_ipv4_octet_in_range/
# ds_host_is_local_ip4/ds_router_url_classify (lr-02f048, BOBBIE finding on
# PR #167): scripts/llm-client.sh's invoke_router builds its own request URL
# from CLAGENTIC_ROUTER_URL and sources ONLY platform.sh, never this file --
# a second, private copy of the classifier here would have left that call
# site with no validation at all (the exact defect this move closes). See
# platform.sh's own "router URL classification" section header for the full
# rationale; behavior is unchanged, only the ds_/DS_ name prefix and file
# location moved. bin/clagentic-lite still owns _validate_router_url below
# (stamp-time die/warn wrapper, specific to this file's enroll/update/doctor
# context) which now calls the shared ds_router_url_classify.

# _validate_router_url URL
# Validates a non-empty CLAGENTIC_ROUTER_URL before it is ever written into
# settings.json as ANTHROPIC_BASE_URL. Callers MUST only invoke this when the
# value is non-empty — an unset/empty router URL must never reach this
# function at all, so the inert-when-unset property holds by construction
# (there is no "validate the empty case" branch to regress).
#
# THREAT MODEL (BOBBIE finding, PR #146 review 5208927288): this value is a
# traffic-interception primitive. Once stamped, it redirects an ENTIRE
# interactive Claude Code session — orchestrator included, not just gate-path
# calls — and in passthrough mode the operator's real Anthropic credentials
# (whatever auth header that session already carries) are forwarded verbatim
# to whatever host this names. A malformed value here does not fail loudly
# at the point of the mistake; it silently breaks every session opened
# against the enrolled repo afterward, days later, in a way that looks like
# an unrelated Claude Code problem. Failing loudly HERE, at stamp time, is
# far cheaper than debugging that later.
#
# TWO SEPARATE DECISIONS, deliberately different severities:
#   1. Malformed — REFUSE. There is no legitimate reason for this value to be
#      anything other than a well-formed URL; a router is either a real URL
#      or misconfigured, and stamping a non-URL string into ANTHROPIC_BASE_URL
#      cannot possibly route correctly, only fail mysteriously downstream.
#      die() exits non-zero, which set -e propagates out of every call site
#      (enroll, restamp, wrapper stamp) without those sites needing their
#      own failure-handling branch.
#   2. Well-formed but pointing at a non-local host — WARN, do not refuse.
#      The router is DESIGNED to run locally (README setup steps assume
#      127.0.0.1), but a non-local host is not necessarily a mistake —
#      someone may legitimately run clagentic-router on another box on their
#      own LAN. A hard refusal would block that legitimate case. A SILENT
#      accept would be the opposite failure: an arbitrary remote host that
#      will receive forwarded Anthropic credentials with no signal at all.
#      Loud-but-not-blocking is the middle ground: the operator sees exactly
#      what is being forwarded and where, at both stamp time (here) and
#      every `doctor` run (the router probe re-classifies independently, via
#      the same ds_router_url_classify, so the warning does not only appear
#      once at enroll time and then go stale in memory).
_validate_router_url() {
  _vru_url="$1"
  ds_router_url_classify "$_vru_url"

  case "$DS_ROUTER_URL_CLASS" in
    malformed)
      die "CLAGENTIC_ROUTER_URL is not a well-formed http:// or https:// URL: '$_vru_url' -- refusing to stamp this into settings.json (a bad value here breaks every Claude Code session opened against this repo). Fix CLAGENTIC_ROUTER_URL in your config and re-run."
      ;;
    nonlocal)
      warn "CLAGENTIC_ROUTER_URL points at a NON-LOCAL host: $_vru_url"
      warn "  This redirects the ENTIRE Claude Code session (interactive + gate-path) through that host."
      warn "  In the router's passthrough mode, this session's real Anthropic credentials are forwarded to it verbatim."
      warn "  This is allowed (clagentic-router can legitimately run on another box on your own network) but is NOT the common case -- the setup docs assume 127.0.0.1."
      warn "  If this is not intentional, fix CLAGENTIC_ROUTER_URL in your config now."
      ;;
    local)
      : # local — no warning
      ;;
  esac
}

# _render_api_key_helper_command
# Builds the shell command string stamped into settings.json's top-level
# "apiKeyHelper" key (lr-684947, concern 2 — "the literal need not be on
# disk at all"). Claude Code invokes this command and uses its stdout
# (trimmed) as the credential, re-invoking on a TTL — see
# code.claude.com/docs/en/settings-reference's apiKeyHelper contract.
#
# ONE HOME, not a second copy: the command reads CLAGENTIC_ROUTER_TOKEN
# straight out of $GLOBAL_CONFIG (~/.config/clagentic/lite/config, already
# chmod 600, already the sole place an operator sets this value) at RUN
# TIME, every invocation — it never embeds the token value itself into the
# command string or into settings.json. This is the mechanism that actually
# closes the N-repo fan-out: rotating the token means editing ONE file
# (GLOBAL_CONFIG), and every enrolled repo's apiKeyHelper re-reads the new
# value on its next TTL-driven invocation with no re-stamp required at all
# — a stronger property than the `rotate` subcommand below, which still has
# to visit N repos for the literal-token path.
#
# Portable POSIX sh one-liner, no external dependency beyond a shell (the
# same trust surface Claude Code's own hook `command` entries already
# require): grep the last matching KEY=VALUE line (last-wins, matching
# `set -a; . file` sourcing semantics) and print VALUE with the trailing
# newline stripped via command substitution. Absolute path to GLOBAL_CONFIG
# is used directly — $HOME is stable at settings.json read time (this is a
# per-user file, not a per-repo one), so no __CLAGENTIC_LITE_HOME__-style
# substitution is needed here.
#
# NO DOUBLE QUOTES in the generated command string, deliberately: the
# command is embedded into a JSON string value by the caller, and every
# double quote inside it would need JSON-escaping to stay valid. The whole
# command is wrapped in single quotes for the outer `sh -c '...'`, and
# GLOBAL_CONFIG is ALSO individually single-quoted inside that string via
# the standard POSIX close-escape-reopen trick ('\''), so a $HOME containing
# a space (unremarkable on macOS) still produces a single grep argv token
# instead of splitting on the space and either erroring or silently
# searching the wrong (or a nonexistent) path. GLOBAL_CONFIG is a fixed
# HOME-derived path (never operator-typed at this call site), so it never
# itself contains a single quote that would need its own escaping here —
# only whitespace-safety is in scope.
#
# FAIL-QUIET BY THE PLATFORM'S OWN CONTRACT: if GLOBAL_CONFIG is missing or
# the key is absent, this prints nothing — Claude Code's own apiKeyHelper
# contract treats empty/failing helper output as an auth failure surfaced
# to the user (not a silent fallback), which is the correct failure mode
# here: better a loud auth error than a session that silently authenticates
# with a stale or wrong credential.
_render_api_key_helper_command() {
  _raihc_q_config=$(printf '%s' "$GLOBAL_CONFIG" | sed "s/'/'\\\\''/g")
  printf "sh -c 'grep ^CLAGENTIC_ROUTER_TOKEN= '\\''%s'\\'' 2>/dev/null | tail -1 | cut -d= -f2-'" "$_raihc_q_config"
}

# _render_claude_settings_body TEMPLATE_FILE > stdout
# Pure renderer for .claude/settings.json content — NO validation, NO file
# I/O beyond reading TEMPLATE_FILE, safe to call only after the caller has
# already validated CLAGENTIC_ROUTER_URL (see _stamp_claude_settings below,
# the sole caller). Substitutes __CLAGENTIC_LITE_HOME__ and
# __CLAGENTIC_ROUTER_ENV_BLOCK__ (the sentinel line claude-settings.template
# carries right after its $comment header).
#
# Router env block is emitted ONLY when CLAGENTIC_ROUTER_URL is set —
# unset is the default and must be byte-for-byte identical to the pre-router
# template output, so the sentinel line is DELETED (not replaced with an
# empty line) when unset. sed one-liner substitution cannot conditionally
# delete-or-multiline-replace a single line, so this reads the template
# line-by-line, mirroring the established pattern in _stamp_wrapper_claude_md.
#
# ANTHROPIC_AUTH_TOKEN (not ANTHROPIC_API_KEY) is stamped because Claude Code
# sends that variable as `Authorization: Bearer <token>`, which is one of the
# two header forms clagentic-router's routed-mode auth accepts (the other is
# x-api-key) — see share/config.example's router section for the full
# citation trail.
#
# EMPTY-TOKEN REGRESSION, FIXED (lr-684947). PRECEDENCE FACT, durable —
# do not re-derive this, and do not reintroduce an empty stamp: per
# code.claude.com/docs/en/env-vars and code.claude.com/docs/en/authentication
# (retrieved 2026-09-01), a `settings.json` `env` block TAKES PRECEDENCE over
# the ambient process environment — Claude Code writes each `env` entry into
# the session's process environment, replacing whatever the shell already
# exported for that key. An EMPTY-STRING value does NOT behave like "unset":
# Claude Code treats an empty value as unset for its OWN provider-selection
# logic (this is the documented mechanism for overriding a variable you
# cannot remove from a settings file), but the empty string still REPLACES
# the shell's inherited value in the process environment, and spawned
# subprocesses inherit the empty string, not the original. Concretely: a
# user who enrolls a repo WITHOUT ever configuring CLAGENTIC_ROUTER_TOKEN
# used to get an empty ANTHROPIC_AUTH_TOKEN stamped, which silently shadowed
# any ambient ANTHROPIC_AUTH_TOKEN or stored OAuth login the session would
# otherwise have used — Claude Code does not fall back to the shell value.
# This is the DEFAULT new-user path for a released tool (enroll without
# router configured), so the fix is unconditional: ANTHROPIC_AUTH_TOKEN and
# AWS_BEARER_TOKEN_BEDROCK are OMITTED ENTIRELY (key absent, not present-
# with-empty-value) whenever their source token is empty. ANTHROPIC_BASE_URL/
# ANTHROPIC_BEDROCK_BASE_URL are not secrets and are unaffected — they keep
# stamping whenever CLAGENTIC_ROUTER_URL is set, same as before.
#
# apiKeyHelper, SINGLE-COPY ALTERNATIVE (lr-684947, concern 2). When
# CLAGENTIC_ROUTER_TOKEN is non-empty, this function ALSO stamps a top-level
# `apiKeyHelper` command instead of the literal token in ANTHROPIC_AUTH_TOKEN
# — see _render_api_key_helper_command below for the mechanism and the
# CRITICAL PRECEDENCE INTERACTION (apiKeyHelper ranks BELOW ANTHROPIC_AUTH_TOKEN
# in Claude Code's own credential chain, so the literal key MUST be removed,
# not merely supplemented, or the helper is silently inert).
#
# BEDROCK PAIR (lr-4af4c4): ANTHROPIC_BASE_URL/ANTHROPIC_AUTH_TOKEN are
# INERT for any session running CLAUDE_CODE_USE_BEDROCK=1 — that mode
# ignores both and speaks the AWS Bedrock Runtime InvokeModel wire protocol
# instead, using ANTHROPIC_BEDROCK_BASE_URL (the Bedrock-mode equivalent of
# ANTHROPIC_BASE_URL) and, per Claude Code's Bedrock API-key option,
# AWS_BEARER_TOKEN_BEDROCK as a bearer-token alternative to full SigV4
# signing (https://code.claude.com/docs/en/amazon-bedrock, "Option E:
# Amazon Bedrock API keys"). CLAGENTIC_ROUTER_TOKEN is reused verbatim as
# AWS_BEARER_TOKEN_BEDROCK — same token, different variable name, matching
# clagentic-router's auth check, which does not distinguish which header/
# variable carried the token in; a second token config key would be a false
# distinction. Gated behind its own explicit opt-in,
# CLAGENTIC_ROUTER_BEDROCK_MODE=1 (requires CLAGENTIC_ROUTER_URL also set),
# rather than auto-detected from CLAUDE_CODE_USE_BEDROCK in the enroll-time
# environment — enroll-time environment does not reliably predict
# session-time environment, so an explicit durable config key is the
# correct place for this, not an environment-shape check.
#
# SUPPLEMENT, NOT REPLACE: the Bedrock pair is stamped ALONGSIDE the
# direct-API pair, not instead of it. A single settings.json may be opened
# by sessions running in either auth mode (e.g. an operator who runs Claude
# Code both with and without CLAUDE_CODE_USE_BEDROCK=1 depending on
# terminal/profile) — each mode only ever reads the two variables it
# understands and ignores the other pair, so stamping both is safe for
# either mode and correct for both, at the cost of a settings.json that
# always carries the unused pair for whichever mode the operator is not
# currently running. The alternative (replacing the direct-API pair
# whenever Bedrock mode is configured) would silently break any
# direct-API-auth session opened against the same repo — a worse failure
# than an unused key sitting in the file.
_render_claude_settings_body() {
  _rcs_template="$1"
  _rcs_router_url="${CLAGENTIC_ROUTER_URL:-}"
  _rcs_bedrock_mode="${CLAGENTIC_ROUTER_BEDROCK_MODE:-0}"

  # DE-OVERLOAD (lr-6d4a1f): AWS_BEARER_TOKEN_BEDROCK's token source depends
  # on whether the host has declared CLAGENTIC_AUTH_MODE.
  #   UNDECLARED (the default, every pre-existing install): CLAGENTIC_ROUTER_TOKEN
  #   is reused verbatim, exactly as before this task -- AC1 requires
  #   byte-identical behavior for every existing install, and no install
  #   predating this task has ever set CLAGENTIC_ROUTER_BEDROCK_TOKEN.
  #   DECLARED (any of the four CLAGENTIC_AUTH_MODE values): the overload
  #   ends. AWS_BEARER_TOKEN_BEDROCK is sourced ONLY from the distinct
  #   CLAGENTIC_ROUTER_BEDROCK_TOKEN key -- CLAGENTIC_ROUTER_TOKEN is never
  #   read for it. An operator who has declared an auth mode but left
  #   CLAGENTIC_ROUTER_BEDROCK_TOKEN unset while still setting
  #   CLAGENTIC_ROUTER_TOKEN is attempting the OLD overload under a NEW
  #   declaration -- refused with a clear message (_stamp_claude_settings's
  #   die() path, same mechanism _validate_router_url already uses) rather
  #   than silently falling back to the router token, which is exactly the
  #   confusable-token-value defect this task exists to close (root cause
  #   of lr-b20c0a: nothing could tell a router admin token from a real AWS
  #   bearer token by value alone).
  _rcs_bedrock_token_source="router-token-reused"
  case "${CLAGENTIC_AUTH_MODE:-}" in
    anthropic-oauth|enterprise|bedrock-sso|bedrock-api-key)
      _rcs_bedrock_token_source="declared-distinct"
      if [ "$_rcs_bedrock_mode" = "1" ] && [ -n "$_rcs_router_url" ] \
        && [ -n "${CLAGENTIC_ROUTER_TOKEN:-}" ] && [ -z "${CLAGENTIC_ROUTER_BEDROCK_TOKEN:-}" ]; then
        die "CLAGENTIC_AUTH_MODE=${CLAGENTIC_AUTH_MODE} is declared and CLAGENTIC_ROUTER_BEDROCK_MODE=1, but CLAGENTIC_ROUTER_BEDROCK_TOKEN is unset while CLAGENTIC_ROUTER_TOKEN is set -- refusing to reuse CLAGENTIC_ROUTER_TOKEN as AWS_BEARER_TOKEN_BEDROCK (the old overload: nothing can tell a router token from a real AWS Bedrock bearer token by value alone). Set CLAGENTIC_ROUTER_BEDROCK_TOKEN explicitly (may be the same value if that is genuinely correct on this host), or leave it unset to stamp an empty AWS_BEARER_TOKEN_BEDROCK."
      fi
      ;;
  esac

  # Resolve the Bedrock bearer token source value up front (mirrors the
  # existing DE-OVERLOAD selection above) so the empty-vs-non-empty decision
  # below and the actual printed value never diverge.
  if [ "$_rcs_bedrock_token_source" = "declared-distinct" ]; then
    _rcs_bedrock_token="${CLAGENTIC_ROUTER_BEDROCK_TOKEN:-}"
  else
    _rcs_bedrock_token="${CLAGENTIC_ROUTER_TOKEN:-}"
  fi

  # apiKeyHelper, single-copy alternative to the literal ANTHROPIC_AUTH_TOKEN
  # (lr-684947, concern 2). Only applies to the direct-API token — the
  # Bedrock pair keeps stamping AWS_BEARER_TOKEN_BEDROCK as a literal (or
  # omitting it, per the empty-token fix below); Claude Code's apiKeyHelper
  # contract feeds ANTHROPIC_API_KEY-equivalent auth only, not the Bedrock
  # bearer-token variable, so there is no equivalent single-copy mechanism
  # for that pair to move behind.
  _rcs_use_api_key_helper=0
  if [ -n "${CLAGENTIC_ROUTER_TOKEN:-}" ] && [ "${CLAGENTIC_ROUTER_USE_API_KEY_HELPER:-0}" = "1" ]; then
    _rcs_use_api_key_helper=1
  fi

  while IFS= read -r _rcs_line || [ -n "$_rcs_line" ]; do
    case "$_rcs_line" in
      *__CLAGENTIC_ROUTER_ENV_BLOCK__*)
        if [ -n "$_rcs_router_url" ]; then
          if [ "$_rcs_use_api_key_helper" = "1" ]; then
            printf '  "apiKeyHelper": "%s",\n' "$(ds_json_escape "$(_render_api_key_helper_command)")"
          fi
          printf '  "env": {\n'
          printf '    "ANTHROPIC_BASE_URL": "%s"' "$_rcs_router_url"
          # ANTHROPIC_AUTH_TOKEN: OMITTED ENTIRELY when the router token is
          # empty (never stamped empty — see this function's doc comment,
          # "EMPTY-TOKEN REGRESSION, FIXED") and OMITTED ENTIRELY when
          # apiKeyHelper is stamped instead (apiKeyHelper ranks BELOW
          # ANTHROPIC_AUTH_TOKEN in Claude Code's credential precedence, so a
          # non-empty literal here would silently win over the helper).
          if [ "$_rcs_use_api_key_helper" != "1" ] && [ -n "${CLAGENTIC_ROUTER_TOKEN:-}" ]; then
            printf ',\n    "ANTHROPIC_AUTH_TOKEN": "%s"' "${CLAGENTIC_ROUTER_TOKEN:-}"
          fi
          if [ "$_rcs_bedrock_mode" = "1" ]; then
            printf ',\n    "ANTHROPIC_BEDROCK_BASE_URL": "%s"' "$_rcs_router_url"
            # AWS_BEARER_TOKEN_BEDROCK: same empty-omission rule as
            # ANTHROPIC_AUTH_TOKEN above — never stamp an empty bearer token.
            if [ -n "$_rcs_bedrock_token" ]; then
              printf ',\n    "AWS_BEARER_TOKEN_BEDROCK": "%s"' "$_rcs_bedrock_token"
            fi
          fi
          printf '\n  },\n'
        fi
        # Router URL unset: emit nothing — the sentinel line is dropped
        # entirely, restoring byte-identical output to the pre-router template.
        ;;
      *)
        printf '%s\n' "$_rcs_line" | sed "s|__CLAGENTIC_LITE_HOME__|$CLAGENTIC_LITE_HOME|g"
        ;;
    esac
  done < "$_rcs_template"
}

# _stamp_claude_settings TEMPLATE_FILE TARGET_FILE [COMMENT_SED_EXPR]
# The ONLY caller of _render_claude_settings_body, and the SOLE writer of a
# .claude/settings.json file anywhere in this codebase — all three stamp
# sites (git-repo enroll, git-repo restamp, wrapper) call this, never the
# body-renderer or a raw `>` redirect directly.
#
# FIXES bobbie.bleed.partial-write (PR #146 review 5209002495, finding 3):
# the previous shape called _render_claude_settings via shell `>`
# redirection at each of the three call sites — e.g.
# `_render_claude_settings "$_tmpl" > "$_target"` — and `>` TRUNCATES
# TARGET_FILE before the function body (including URL validation) ever
# runs. A die() on a malformed CLAGENTIC_ROUTER_URL during `update
# --restamp` or a re-enroll against an EXISTING settings.json therefore
# emptied a previously-working file instead of preserving it. This function
# closes that gap structurally, not by remembering to validate-before-
# redirect at each of the three call sites individually:
#   1. Validate FIRST (only when the URL is non-empty — see
#      _validate_router_url's own inert-when-unset contract). If this
#      dies, TARGET_FILE has not been touched at all yet.
#   2. Render to a TEMP file in the same directory as TARGET_FILE (same
#      filesystem, so the final `mv` is atomic, not a cross-device copy).
#   3. `mv` the temp file over TARGET_FILE only after a complete, valid
#      render succeeded. TARGET_FILE is replaced in one atomic rename —
#      never observed half-written, and never truncated by a failed render.
# COMMENT_SED_EXPR, when supplied, is applied to the rendered body before
# the atomic write (the wrapper flavor's own settings-version comment
# rewrite) — kept as a rendering-time step, not a second file write, so
# there is still only one point where TARGET_FILE itself is touched.
#
# MODE 0600, not 0644 (lr-684947, agnostic-tool hardening). This file can
# carry a live credential (ANTHROPIC_AUTH_TOKEN / AWS_BEARER_TOKEN_BEDROCK)
# whenever a router is configured — a released tool cannot know whether it
# is installed on a single-user workstation or a shared/multi-user host, so
# a world-readable file holding a live credential is wrong by default,
# matching the treatment $GLOBAL_CONFIG already gets (chmod 600,
# _secret_tmp_create). Reuses _secret_tmp_create rather than a second
# primitive — same genuinely-atomic `umask 077` subshell creation that
# closes the create-then-chmod race window (_secret_tmp_create's own doc
# comment explains why a bare `chmod 600` after the fact is not equivalent).
# Applies unconditionally, even when no router is configured and the file
# carries no secret today — the router can be configured later via
# `update`/`enroll --force` without this file's mode ever having been
# tightened retroactively otherwise.
_stamp_claude_settings() {
  _scs_template="$1"
  _scs_target="$2"
  _scs_comment_sed="${3:-}"
  _scs_router_url="${CLAGENTIC_ROUTER_URL:-}"

  # Validate BEFORE anything opens a redirection against the real target —
  # inert-when-unset holds by construction: this call is skipped entirely
  # when CLAGENTIC_ROUTER_URL is unset, so there is no code path here that
  # can emit output, warn, refuse, or touch the temp/target files in that case.
  [ -n "$_scs_router_url" ] && _validate_router_url "$_scs_router_url"

  _scs_tmp="${_scs_target}.tmp.$$"
  _secret_tmp_create "$_scs_tmp" || { warn "could not chmod 600 settings-stamp temp file — aborting to avoid a momentarily-exposed settings.json"; return 1; }
  if [ -n "$_scs_comment_sed" ]; then
    _render_claude_settings_body "$_scs_template" | sed "$_scs_comment_sed" >> "$_scs_tmp"
  else
    _render_claude_settings_body "$_scs_template" >> "$_scs_tmp"
  fi
  mv -f "$_scs_tmp" "$_scs_target"
}

# ---------------------------------------------------------------- clagentic-lite plugin render (config-aware, single plugin)
#
# lr-1b5a31: previously two plugins existed — the checked-in clagentic-lite
# (never carrying `model:`) and a separately-installed clagentic-lite-router
# overlay (carrying `model: role:<role>-chain` in frontmatter when
# CLAGENTIC_ROUTER_INJECT_AGENT_MODEL=1). Both registered agents under
# identical short names ("reviewer", "auditor", "merge-gate"); Claude Code's
# auto-dispatch between two same-name plugins is load-order-determined, not
# intent-determined, so router injection was silently inert whenever the
# base plugin happened to win dispatch. Fix: ONE plugin. init/update always
# renders plugins/clagentic-lite's agent files into a config-aware copy —
# `model:` is injected when router injection is active, omitted otherwise —
# and installs THAT rendered copy as the one and only `clagentic-lite`
# plugin. The collision is now structurally impossible: there is only ever
# one plugin named clagentic-lite, so there is nothing for Claude Code's
# dispatch to choose between.
#
# UNVERIFIED half (see README.md "Verifying on your machine" and
# share/config.example CLAGENTIC_ROUTER_INJECT_AGENT_MODEL): whether Claude
# Code actually honors a subagent frontmatter `model:` field set to a
# non-standard string like "role:reviewer-chain" — versus silently ignoring
# it and dispatching on the parent session's model instead — has not been
# confirmed against a live interactive session from this codebase. This is
# claude-code GH#44385 territory. The injection is still gated behind its
# own key, separate from CLAGENTIC_ROUTER_URL, so that setting the router
# URL alone (the settings.json env-block passthrough) carries zero risk from
# this unverified injection path.
#
# _RENDERED_PLUGIN_DIR is generated install-tree state (gitignored via the
# repo's own .clagentic/* pattern, mirrored here under CLAGENTIC_LITE_HOME
# for the same reason: it is a build artifact re-derived from the checked-in
# plugins/clagentic-lite/agents/*.md files plus live config, never a source
# of truth in its own right). It is the marketplace source for the ONE
# `clagentic-lite` plugin from lr-1b5a31 onward — the checked-in
# plugins/clagentic-lite/ tree in the repo itself is no longer registered as
# a marketplace source directly (see _install_clagentic_lite_plugin).
_RENDERED_PLUGIN_DIR="$CLAGENTIC_LITE_HOME/.clagentic/rendered-plugin"
_RENDERED_PLUGIN_NAME="clagentic-lite"
# Legacy plugin name from the pre-lr-1b5a31 dual-plugin design. Migration
# (_migrate_legacy_router_plugin) removes any install still carrying this
# name so a machine converges to the single-plugin model in one update run.
_LEGACY_ROUTER_PLUGIN_NAME="clagentic-lite-router"
# Claude Code's own plugin cache root (lr-35315f) — where `claude plugin
# install`/`uninstall` actually materialize/remove a plugin's rendered
# files. FIXED, never derived from config/env: built from $HOME (the same
# base every other fixed state path in this file uses, see REGISTRY/
# GLOBAL_CONFIG/LOCAL_BIN above) plus a hardcoded literal segment
# ("plugins/cache") plus $_LEGACY_ROUTER_PLUGIN_NAME, itself a hardcoded
# shell constant one line up — no interpolation from a config value, repo
# content, or CLAGENTIC_* env var reaches this path at any point. Per BOBBIE's
# PR #164 safety constraint: a filesystem removal must target a fixed
# literal name, never an interpolated/config-derived path — this satisfies
# that by construction, not by convention.
_LEGACY_ROUTER_PLUGIN_CACHE_DIR="$HOME/.claude/plugins/cache/$_LEGACY_ROUTER_PLUGIN_NAME"

# _plugin_agent_needs_injection ROLE_ENV_PREFIX
# Returns 0 (needs model: injected) when router injection is active
# (CLAGENTIC_ROUTER_URL set AND CLAGENTIC_ROUTER_INJECT_AGENT_MODEL=1) AND
# CLAGENTIC_<PREFIX>_CMD is set to something other than "claude" — a role
# already on claude inherits the session model, same as the checked-in
# agent files' own comment: "model_chain is not a Claude Code frontmatter
# field — do not add it here".
_plugin_agent_needs_injection() {
  _pani_prefix="$1"
  [ -n "${CLAGENTIC_ROUTER_URL:-}" ] && [ "${CLAGENTIC_ROUTER_INJECT_AGENT_MODEL:-0}" = "1" ] || return 1
  _pani_cmd=$(eval "printf '%s' \"\${CLAGENTIC_${_pani_prefix}_CMD:-}\"")
  [ -n "$_pani_cmd" ] && [ "$_pani_cmd" != "claude" ]
}

# _render_config_fingerprint
# Short, stable string summarizing every live config knob that changes the
# rendered plugin's OUTPUT — not every CLAGENTIC_* var, only the ones this
# render function actually branches on. Any future config knob that changes
# render output must be added to this list (generalizes beyond router mode
# per lr-1b5a31 comment #1: "ANY future config knob that changes render
# output is covered"). Deliberately excludes CLAGENTIC_ROUTER_TOKEN — token
# rotation must not force a plugin re-render (the frontmatter text is
# identical either way; only reachability/auth changes, which doctor's
# router probe already covers separately).
_render_config_fingerprint() {
  _rcf_reviewer=$(_plugin_agent_needs_injection REVIEWER && echo 1 || echo 0)
  _rcf_auditor=$(_plugin_agent_needs_injection AUDITOR && echo 1 || echo 0)
  _rcf_gate=$(_plugin_agent_needs_injection GATE && echo 1 || echo 0)
  printf 'reviewer=%s,auditor=%s,gate=%s' "$_rcf_reviewer" "$_rcf_auditor" "$_rcf_gate"
}

# _render_stamp
# Combines the render-logic version with the live config fingerprint into
# one comparable string. This is the "render stamp" from lr-1b5a31: written
# into the rendered plugin.json's clagenticStamp field at render time, and
# recomputed fresh (against CURRENT config) by doctor/update to detect
# staleness. Class mechanism, not router-specific — any future config knob
# that changes render output flows through _render_config_fingerprint, so
# this stamp covers it automatically without a new comparison site.
_render_stamp() {
  printf '%s;%s' "$PLUGIN_RENDER_VERSION" "$(_render_config_fingerprint)"
}

# _render_clagentic_lite_plugin_dir
# Materializes a plugin directory tree under _RENDERED_PLUGIN_DIR: one
# rendered copy of every agent file under plugins/clagentic-lite/agents/,
# plus a plugin.json and marketplace.json pointing at that rendered plugin
# directory. Checked-in files under plugins/clagentic-lite/agents/ are
# read-only inputs here — NEVER modified on disk (they are re-read from the
# real checkout on every render, so a maintainer edit to the checked-in
# agent contract always flows through).
#
# Injection point: `model: role:<role>-chain` is inserted as a new
# frontmatter line immediately after `name: <role>` (line 2 of every agent
# file in this repo — a stable anchor) ONLY when _plugin_agent_needs_injection
# says so (router injection active AND the role's CLAGENTIC_<ROLE>_CMD is a
# non-claude CLI). builder.md and troubleshooter.md are never candidates for
# injection (see the triple list below) — the task spec is explicit that a
# tool-using role must not be routed (routed mode drops tool-calling through
# clagentic-router's CLI adapters), and troubleshooter has no CLAGENTIC_*_CMD
# role mapping of its own. Both are still copied byte-for-byte into the
# rendered plugin so the single plugin carries the full five-agent set.
_render_clagentic_lite_plugin_dir() {
  _rcpd_agents_src="$CLAGENTIC_LITE_HOME/plugins/clagentic-lite/agents"
  _rcpd_out_agents="$_RENDERED_PLUGIN_DIR/plugins/$_RENDERED_PLUGIN_NAME/agents"
  rm -rf "$_RENDERED_PLUGIN_DIR" 2>/dev/null || true
  mkdir -p "$_rcpd_out_agents" || { warn "cannot create $_rcpd_out_agents"; return 1; }

  # ROLE_ENV_PREFIX:agent-filename:chain-name triples for the three roles
  # eligible for model: injection. builder/troubleshooter are handled in the
  # plain-copy loop below since they never take a chain name.
  for _rcpd_triple in "REVIEWER:reviewer:reviewer-chain" "AUDITOR:auditor:auditor-chain" "GATE:merge-gate:merge-gate-chain"; do
    _rcpd_prefix="${_rcpd_triple%%:*}"
    _rcpd_rest="${_rcpd_triple#*:}"
    _rcpd_file="${_rcpd_rest%%:*}"
    _rcpd_chain="${_rcpd_rest#*:}"

    _rcpd_src_file="$_rcpd_agents_src/${_rcpd_file}.md"
    _rcpd_dst_file="$_rcpd_out_agents/${_rcpd_file}.md"
    [ -f "$_rcpd_src_file" ] || { warn "plugin render: source missing: $_rcpd_src_file"; continue; }

    if _plugin_agent_needs_injection "$_rcpd_prefix"; then
      # Insert "model: role:<chain>" as the line immediately after "name: <role>"
      # (line 2 in every checked-in agent file). awk, not sed -i, so this works
      # identically on GNU and BSD without a DS_SED_INPLACE branch.
      awk -v model_line="model: role:${_rcpd_chain}" \
        'NR==2 { print; print model_line; next } { print }' \
        "$_rcpd_src_file" > "$_rcpd_dst_file"
    else
      cp "$_rcpd_src_file" "$_rcpd_dst_file"
    fi
  done

  # Roles never eligible for injection (builder: tool-using, must not be
  # routed; troubleshooter: no CLAGENTIC_*_CMD role mapping) — copied
  # verbatim so the rendered plugin still carries the full agent set.
  for _rcpd_plain in builder troubleshooter; do
    _rcpd_src_file="$_rcpd_agents_src/${_rcpd_plain}.md"
    _rcpd_dst_file="$_rcpd_out_agents/${_rcpd_plain}.md"
    [ -f "$_rcpd_src_file" ] || { warn "plugin render: source missing: $_rcpd_src_file"; continue; }
    cp "$_rcpd_src_file" "$_rcpd_dst_file"
  done

  # Skills are never config-rendered (no injection applies to them) — copy
  # the checked-in tree verbatim so the single plugin still ships them.
  _rcpd_skills_src="$CLAGENTIC_LITE_HOME/plugins/clagentic-lite/skills"
  if [ -d "$_rcpd_skills_src" ]; then
    _rcpd_out_skills="$_RENDERED_PLUGIN_DIR/plugins/$_RENDERED_PLUGIN_NAME/skills"
    mkdir -p "$_rcpd_out_skills"
    cp -R "$_rcpd_skills_src"/. "$_rcpd_out_skills"/ 2>/dev/null || true
  fi

  _rcpd_stamp="$(_render_stamp)"

  # Plugin manifest carries the checked-in version (source of maintainer
  # truth for plugin-level version bumps) plus the render stamp (source of
  # truth for "does this rendered copy match current config/template?").
  # The two are orthogonal: plugin.json's own "version" is bumped by
  # maintainer PRs that change agent/skill content; clagenticStamp changes
  # whenever the render LOGIC or the LIVE CONFIG that feeds it changes,
  # independent of any maintainer version bump.
  _rcpd_base_version=$(grep -o '"version": *"[^"]*"' \
    "$CLAGENTIC_LITE_HOME/plugins/clagentic-lite/.claude-plugin/plugin.json" 2>/dev/null \
    | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
  [ -z "$_rcpd_base_version" ] && _rcpd_base_version="0.0.0"

  mkdir -p "$_RENDERED_PLUGIN_DIR/plugins/$_RENDERED_PLUGIN_NAME/.claude-plugin"
  cat > "$_RENDERED_PLUGIN_DIR/plugins/$_RENDERED_PLUGIN_NAME/.claude-plugin/plugin.json" <<-EOF
	{
	  "\$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
	  "name": "$_RENDERED_PLUGIN_NAME",
	  "version": "$_rcpd_base_version",
	  "description": "The five clagentic-lite role agents (builder, reviewer, auditor, merge-gate, troubleshooter) plus commentary skills (/infosec-rt, /eng-consult). Rendered by clagentic-lite init/update -- config-aware: carries model: role:<role>-chain frontmatter on reviewer/auditor/merge-gate when CLAGENTIC_ROUTER_URL + CLAGENTIC_ROUTER_INJECT_AGENT_MODEL=1 are both set and the role's own CLAGENTIC_<ROLE>_CMD is non-claude; omits it otherwise. Regenerated on every init/update run -- do not edit by hand.",
	  "clagenticStamp": "$_rcpd_stamp"
	}
	EOF

  mkdir -p "$_RENDERED_PLUGIN_DIR/.claude-plugin"
  cat > "$_RENDERED_PLUGIN_DIR/.claude-plugin/marketplace.json" <<-EOF
	{
	  "name": "$_RENDERED_PLUGIN_NAME",
	  "owner": { "name": "clagentic-lite (generated)" },
	  "metadata": {
	    "description": "Generated marketplace for the rendered clagentic-lite plugin. Not committed to any repo -- regenerated by clagentic-lite init/update."
	  },
	  "plugins": [
	    {
	      "name": "$_RENDERED_PLUGIN_NAME",
	      "source": "./plugins/$_RENDERED_PLUGIN_NAME",
	      "description": "The five clagentic-lite role agents plus commentary skills, config-aware rendered.",
	      "version": "$_rcpd_base_version"
	    }
	  ]
	}
	EOF

  return 0
}

# _installed_plugin_render_stamp
# Reads the clagenticStamp field back out of the currently-installed
# rendered plugin.json, if any. Empty string when not found (no prior
# render, or a pre-lr-1b5a31 install of the checked-in tree directly, which
# never carried this field). Used by doctor's stamp-staleness check and by
# update to decide whether a re-render is actually needed.
_installed_plugin_render_stamp() {
  _iprs_file="$_RENDERED_PLUGIN_DIR/plugins/$_RENDERED_PLUGIN_NAME/.claude-plugin/plugin.json"
  [ -f "$_iprs_file" ] || { printf ''; return; }
  grep -o '"clagenticStamp": *"[^"]*"' "$_iprs_file" 2>/dev/null | head -1 | sed 's/.*"\([^"]*\)"$/\1/'
}

# _doctor_check_plugin_collision OK_FN FAIL_FN
# Generic backstop (lr-1b5a31): the single-plugin render makes the
# clagentic-lite-vs-clagentic-lite-router collision structurally impossible
# (there is only ever one clagentic-lite plugin now), but a THIRD-PARTY
# plugin the operator installs separately could still register an agent
# under the same short name (e.g. its own "reviewer") — Claude Code's
# dispatch between two same-name agents is load-order-determined, not
# intent-determined, same failure class as the original bug. Inspects
# `claude plugin list` output for any agent short name that appears to come
# from more than one enabled plugin.
#
# `claude plugin list` output format is not guaranteed stable across
# versions — this check is advisory (WARN via the caller's fail_fn, not a
# hard abort) and degrades to a skip (not a false positive) when the
# command's output does not parse into the expected "name@plugin" token
# shape. OK_FN/FAIL_FN are the names of the caller's reporting functions
# (cmd_doctor's _ok/_fail closures) so doctor's running tally stays
# accurate; a test harness can pass its own stand-ins.
_doctor_check_plugin_collision() {
  _dcpc_ok_fn="$1"
  _dcpc_fail_fn="$2"
  if ! command -v claude >/dev/null 2>&1; then
    printf '  (claude not on PATH — skipping)\n'
    return 0
  fi
  _dcpc_list=$(claude plugin list 2>/dev/null || true)
  if [ -z "$_dcpc_list" ]; then
    printf '  (no plugins installed, or `claude plugin list` produced no output — skipping)\n'
    return 0
  fi
  _dcpc_collisions=$(printf '%s\n' "$_dcpc_list" \
    | grep -oE '[A-Za-z0-9_-]+@[A-Za-z0-9_-]+' 2>/dev/null \
    | awk -F'@' '{print $1}' | sort | uniq -d || true)
  if [ -n "$_dcpc_collisions" ]; then
    "$_dcpc_fail_fn" "same-name agent/plugin collision detected — Claude Code's dispatch between two same-name plugins is load-order-determined, not intent-determined:"
    printf '%s\n' "$_dcpc_collisions" | while IFS= read -r _dcpc_name; do
      [ -z "$_dcpc_name" ] && continue
      printf '       %s: %s\n' "$_dcpc_name" "$(printf '%s\n' "$_dcpc_list" | grep -F "${_dcpc_name}@" | tr '\n' ' ')"
    done
    printf '       Uninstall the duplicate/third-party plugin, or rename its agents, so exactly one plugin owns each agent short name.\n'
  else
    _dcpc_count=$(printf '%s\n' "$_dcpc_list" | grep -oE '@[A-Za-z0-9_-]+' 2>/dev/null | sort -u | wc -l | tr -d ' ')
    "$_dcpc_ok_fn" "no same-name agent/plugin collisions detected across $_dcpc_count installed plugin(s)"
  fi
}

# _doctor_check_render_stamp_staleness OK_FN FAIL_FN
# Class mechanism (lr-1b5a31): compares the currently-installed rendered
# plugin.json's clagenticStamp against what CURRENT config/template would
# produce right now. A mismatch means the installed plugin was rendered
# under different config (router injection toggled, a CLAGENTIC_<ROLE>_CMD
# changed, or PLUGIN_RENDER_VERSION was bumped by a maintainer PR) and
# `update` will re-render/heal it on next run — this check exists so
# staleness is visible on a `doctor` run BEFORE the operator wonders why
# routing behavior does not match their current config. Not FAIL-worthy
# (stale-but-healable is not a broken state), so mismatch prints WARN
# without calling FAIL_FN.
_doctor_check_render_stamp_staleness() {
  _dcrss_ok_fn="$1"
  _dcrss_current="$(_render_stamp)"
  _dcrss_installed="$(_installed_plugin_render_stamp)"
  if [ -z "$_dcrss_installed" ]; then
    printf '  INFO rendered plugin not found or carries no stamp — run `clagentic-lite update` to render it (current stamp would be: %s)\n' "$_dcrss_current"
  elif [ "$_dcrss_installed" != "$_dcrss_current" ]; then
    printf '  WARN rendered plugin stamp is STALE — installed: %s ; current config/template: %s\n' "$_dcrss_installed" "$_dcrss_current"
    printf '       run `clagentic-lite update` to re-render and re-install the plugin under current config.\n'
  else
    "$_dcrss_ok_fn" "rendered plugin stamp up to date ($_dcrss_current)"
  fi
}

# _doctor_check_orphaned_router_plugin OK_FN FAIL_FN
# lr-35315f: detects the specific silent-failure class that slipped past
# _doctor_check_plugin_collision above — a legacy $_LEGACY_ROUTER_PLUGIN_NAME
# cache directory that is RESOLVABLE (its agent files are still on disk
# under $_LEGACY_ROUTER_PLUGIN_CACHE_DIR, carrying `model: role:*-chain`
# overrides) while CLAGENTIC_ROUTER_INJECT_AGENT_MODEL is unset on this
# machine right now. The collision check above only catches two plugins
# both showing up in `claude plugin list` at once; an ORPHANED cache entry
# (Claude Code marked it orphaned but did not delete it — see
# _migrate_legacy_router_plugin's lr-35315f notes) can be invisible to
# `plugin list` while still shadowing the base plugin's same-named agent at
# resolution time. This check reads the cache directory directly, not
# `plugin list`, so it catches exactly the state `plugin list`-based
# detection cannot.
#
# Not gated on injection being off — a resolvable legacy copy is wrong
# regardless of current config (with injection ON, the base plugin's own
# render already carries the correct chain names; a leftover legacy copy is
# still a same-name duplicate). The unset-injection framing in the message
# names the most confusing manifestation (silent misrouting with no
# obviously-wrong config) but the FAIL fires whenever the directory exists.
_doctor_check_orphaned_router_plugin() {
  _dcorp_ok_fn="$1"
  _dcorp_fail_fn="$2"

  if [ ! -d "$_LEGACY_ROUTER_PLUGIN_CACHE_DIR" ]; then
    "$_dcorp_ok_fn" "no orphaned $_LEGACY_ROUTER_PLUGIN_NAME cache directory found"
    return 0
  fi

  # -print0/-0 (GNU find/xargs) rather than plain -print/xargs, so a path
  # containing whitespace under the cache directory can't split across two
  # xargs arguments (BOBBIE, PR #179 review: read-only diagnostic fragility,
  # not a security finding, but worth closing while in this function).
  _dcorp_model_files=$(find "$_LEGACY_ROUTER_PLUGIN_CACHE_DIR" -type f -name '*.md' -print0 2>/dev/null \
    | xargs -0 grep -lE '^model:[[:space:]]*role:' 2>/dev/null || true)

  if [ -n "$_dcorp_model_files" ]; then
    "$_dcorp_fail_fn" "orphaned legacy plugin cache is RESOLVABLE and still carries router model: overrides — this shadows the base clagentic-lite plugin's same-named agents:"
    printf '       %s\n' "$_LEGACY_ROUTER_PLUGIN_CACHE_DIR"
    printf '%s\n' "$_dcorp_model_files" | while IFS= read -r _dcorp_f; do
      [ -n "$_dcorp_f" ] && printf '         %s\n' "$_dcorp_f"
    done
    if [ "${CLAGENTIC_ROUTER_INJECT_AGENT_MODEL:-0}" != "1" ]; then
      printf '       CLAGENTIC_ROUTER_INJECT_AGENT_MODEL is UNSET on this machine — any dispatch that resolves to this orphaned copy sends a router model: string with no injection intended, which 422s at clagentic-router in routed mode.\n'
    fi
    printf '       run `clagentic-lite update` to remove it (lr-35315f hardened migration).\n'
  else
    "$_dcorp_fail_fn" "orphaned legacy plugin cache directory found (no resolvable model: override detected in it, but it should not exist post-migration):"
    printf '       %s\n' "$_LEGACY_ROUTER_PLUGIN_CACHE_DIR"
    printf '       run `clagentic-lite update` to remove it.\n'
  fi
}

# _secret_tmp_create PATH
# lr-25e73e fold-in (BOBBIE bobbie.secret.7 + PEACHES amos.code-craft.12):
# creates PATH truncated and chmod 600 BEFORE any content ever reaches it,
# and is the ONLY sanctioned way to create a temp file anywhere in the
# secrets-bearing config read/merge/append paths below (_write_global_config,
# _append_missing_config_keys). A bare `cmd > newfile` redirection creates
# newfile at whatever the process umask dictates the INSTANT the shell opens
# it, before the command's own output ever exists — a subsequent `chmod 600`
# is provably too late, since a hostile or merely-curious local reader can
# open the file in the window between shell-open and chmod. This was the
# root cause both PEACHES and BOBBIE independently found (four sites, two
# different partial lists) in the PR #195 review round: _wgc_preserve.body,
# _wgc_merged.body.tmp, _wgc_merged.notfound, and _amck_tmp.cmt were each a
# `command > file` where `file` did not yet exist 600.
#
# THE RULE, enforced by construction from here on: a temp file that will
# ever hold config content (which may include a live credential value, e.g.
# CLAGENTIC_ROUTER_TOKEN) is NEVER the target of `cmd > newfile`. It is
# ALWAYS created via this helper first, then written to with `cmd >> file`
# (append onto an already-600 file) or `cmd > file` is replaced with
# `_secret_tmp_create file && cmd > file` is STILL WRONG (same race) --
# the correct pattern is always _secret_tmp_create, then >>-append, or
# redirect into a file this helper already created and never re-truncate it.
#
# ATOMICITY, corrected in review (own test caught it live,
# test_permissions_during_the_window_not_only_after): `: > file` FOLLOWED BY
# `chmod 600 file` is NOT atomic -- the shell's own `>` redirection creates
# `file` at whatever the process umask dictates the INSTANT it opens the
# descriptor, and `chmod` is a SEPARATE syscall milliseconds later. A reader
# racing between those two syscalls still sees the umask-derived mode (0644
# under a typical 022 umask) -- the exact same class of window this helper
# exists to close, just narrowed rather than closed. The genuinely atomic
# fix: scope a `umask 077` to a subshell around the file's creation, so the
# kernel creates it at mode 600 in ONE syscall and `chmod` is redundant
# belt-and-braces afterward (kept for defense-in-depth against an inherited
# umask that somehow bypassed the subshell, e.g. a shell without subshell
# support for `( )` -- POSIX sh always has this, so this is theoretical, but
# the chmod is one cheap statement and removing it buys nothing).
_secret_tmp_create() {
  ( umask 077 && : > "$1" ) || return 1
  chmod 600 "$1" || return 1
}

# _config_key_set FILE
# lr-25e73e: extraction shared by _doctor_check_config_drift AND cmd_update's
# --refresh-config pass, so the two never carry divergent notions of "what is
# a config key" (task requirement: "reuse the existing key-set extraction...
# do NOT write a second, divergent extractor"). Prints one key name per line,
# sorted+uniqued, for every line matching ^CLAGENTIC_[A-Za-z0-9_]*= optionally
# prefixed with a single '# ' comment marker (config.example's own convention
# for an inert/commented-out key — see the file's "Opt-in default: off"
# sections). Matches on VARIABLE NAME ONLY (up to and including the first
# '='); values are never read or emitted, so a caller can never leak a
# user-configured value through this helper by construction.
_config_key_set() {
  _cks_key_sed='s/^#[[:space:]]*\(CLAGENTIC_[A-Za-z0-9_]*\)=.*/\1/p; s/^\(CLAGENTIC_[A-Za-z0-9_]*\)=.*/\1/p'
  sed -n "$_cks_key_sed" "$1" 2>/dev/null | sort -u
}

# _config_missing_keys EXAMPLE_KEYS INSTALLED_KEYS
# lr-25e73e: given the two key-set listings (newline-separated, as produced by
# _config_key_set), prints the EXAMPLE_KEYS lines absent from INSTALLED_KEYS,
# excluding CLAGENTIC_CONFIG_SCHEMA_VERSION (auto-managed bookkeeping — see
# the drift check below for why it is excluded). Shared by the drift check
# and the --refresh-config append pass so "what counts as missing" cannot
# drift between the two call sites either.
_config_missing_keys() {
  _cmk_example_keys="$1"
  _cmk_installed_keys="$2"
  printf '%s\n' "$_cmk_example_keys" | while IFS= read -r _cmk_k; do
    [ -z "$_cmk_k" ] && continue
    [ "$_cmk_k" = "CLAGENTIC_CONFIG_SCHEMA_VERSION" ] && continue
    if ! printf '%s\n' "$_cmk_installed_keys" | grep -qxF "$_cmk_k"; then
      printf '%s\n' "$_cmk_k"
    fi
  done
}

# _doctor_check_config_drift OK_FN
# lr-e33f73: `clagentic-lite update` never refreshes an existing
# ~/.config/clagentic/config (cmd_init short-circuits when the file already
# exists — see the comment above CONFIG_SCHEMA_VERSION, top of file). A
# fully up-to-date install can therefore be missing every config key shipped
# after its own init, with zero indication anywhere that this happened —
# the field incident behind this task was an operator who lost roughly four
# hours misdiagnosing a missing CLAGENTIC_REVIEW_CHUNKING as an auth/router
# problem. This check makes that gap visible on a routine `doctor` run: it
# diffs the KEY SET (variable names only, never values — this is read-only
# and reports names, not a user's configured values) in share/config.example
# against $GLOBAL_CONFIG and names exactly which keys the installed config
# is missing, whether the key is active or commented-out in the template.
#
# Deliberately advisory (WARN via a plain printf, not FAIL_FN) — an absent
# key is not a broken install, it is a missing key the operator may or may
# not want; forcing it to FAIL would make `doctor` red on every machine that
# has ever customized a config by deleting an unwanted line. Only OK_FN is
# taken as a parameter, matching _doctor_check_render_stamp_staleness's
# WARN-only convention above.
#
# lr-25e73e: key extraction and the missing-set computation both moved to
# shared helpers (_config_key_set, _config_missing_keys, above) so cmd_update's
# --refresh-config append pass consumes the identical logic rather than a
# second, divergent extractor.
_doctor_check_config_drift() {
  _dccd_ok_fn="$1"
  _dccd_example="$SHARE_DIR/config.example"
  if [ ! -f "$_dccd_example" ]; then
    printf '  (share/config.example not found at %s — skipping)\n' "$_dccd_example"
    return 0
  fi
  if [ ! -f "$GLOBAL_CONFIG" ]; then
    printf '  (no global config at %s yet — run `clagentic-lite init` — skipping)\n' "$GLOBAL_CONFIG"
    return 0
  fi

  # Both sides use the SAME extraction (active OR commented-out key names) --
  # a freshly-init'd config is a verbatim copy of config.example, so it
  # carries the identical commented-out lines the template does. Extracting
  # only active keys from one side and both from the other would falsely
  # report every commented-out key as "missing" on a byte-identical install
  # (caught by test_doctor_config_drift.py's no-drift-on-verbatim-copy case).
  _dccd_example_keys=$(_config_key_set "$_dccd_example")
  _dccd_installed_keys=$(_config_key_set "$GLOBAL_CONFIG")

  # CLAGENTIC_CONFIG_SCHEMA_VERSION (PEACHES PR #193 review, finding 3):
  # auto-managed bookkeeping, not an operator-facing feature key -- config.
  # example itself says "Do not hand-edit" (top of file). Reporting it
  # alongside real feature keys under "review these and add any you want"
  # directly contradicted that instruction, so it is excluded from drift
  # output entirely rather than special-cased with different wording: an
  # install missing this key (e.g. one written before lr-e33f73 introduced
  # it) has nothing useful for the operator to hand-add here regardless.
  # (Exclusion now lives in the shared _config_missing_keys helper.)
  _dccd_missing=$(_config_missing_keys "$_dccd_example_keys" "$_dccd_installed_keys")

  # wc -l, not grep -c: grep -c on zero matches exits 1, which would trip an
  # `|| fallback` into printing a second "0" alongside its own zero count.
  _dccd_missing_count=$(printf '%s\n' "$_dccd_missing" | sed '/^$/d' | wc -l | tr -d ' ')
  _dccd_example_count=$(printf '%s\n' "$_dccd_example_keys" | sed '/^$/d' | wc -l | tr -d ' ')

  if [ "$_dccd_missing_count" -eq 0 ]; then
    "$_dccd_ok_fn" "global config has all $_dccd_example_count key(s) from share/config.example (no drift)"
  else
    # lr-25e73e item 5: name the actual remedy command instead of citing
    # AGENTS.md's "Template version-bump protocol" — that section governs the
    # four version-constant-stamped template artifacts (CLAUDE.md, builder-
    # contract.md, settings.json, hook shims); share/config.example is not in
    # that table and the protocol does not actually justify this behavior
    # (see lr-25e73e task thread comment #2). The append pass itself remains
    # opt-in (operator decision, lr-25e73e) — `update` reports loudly here,
    # `update --refresh-config` is the one-command remedy.
    printf '  WARN global config at %s is missing %s key(s) present in share/config.example (shipped after this config was written):\n' \
      "$GLOBAL_CONFIG" "$_dccd_missing_count"
    printf '%s\n' "$_dccd_missing" | while IFS= read -r _dccd_m; do
      [ -z "$_dccd_m" ] && continue
      printf '       %s\n' "$_dccd_m"
    done
    printf '       Run `clagentic-lite update --refresh-config` to append them as commented-out lines (never activated), or review them in %s and add any you want to %s by hand.\n' \
      "$_dccd_example" "$GLOBAL_CONFIG"
  fi
}

# _migrate_legacy_router_plugin
# lr-1b5a31 migration, hardened by lr-35315f: detects a pre-lr-1b5a31
# clagentic-lite-router install (the old overlay plugin) and removes it.
# Runs unconditionally in both cmd_init and cmd_update, before the unified
# plugin install, regardless of current router config — a machine that had
# the legacy plugin installed and has since turned router injection off
# must still lose the stale overlay, not just stop refreshing it.
#
# lr-35315f REGRESSION FIX: `claude plugin uninstall` is a package-manager
# call, not a filesystem removal — on a real enrolled machine it left the
# plugin's cache directory in place, marked ORPHANED (Claude Code's own
# `.orphaned_at` marker) rather than removed, and an orphaned-but-present
# cache entry was still RESOLVABLE by Claude Code's agent resolver (its
# reviewer.md, still carrying `model: role:reviewer-chain`, shadowed the
# correct base-plugin copy). Two independent gaps, both closed here:
#
#   1. The old code only acted when `claude plugin list` still showed the
#      legacy name. An orphaned entry can drop out of `plugin list` entirely
#      while its cache directory and agent files remain on disk and
#      resolvable — so the uninstall call was never even attempted on the
#      machine that needed it. The cache-directory removal below now runs
#      UNCONDITIONALLY (not gated on the `plugin list` grep), so it
#      converges even when `plugin list` no longer mentions the legacy name.
#   2. `claude plugin uninstall`/`marketplace remove` remain the FIRST step
#      (the correct, supported way to deregister a plugin) — but are no
#      longer trusted alone to have removed the cache entry. After they run,
#      $_LEGACY_ROUTER_PLUGIN_CACHE_DIR (a FIXED path — see its definition
#      above; never interpolated from config/env) is removed directly if
#      still present, so no orphaned-but-resolvable copy can survive a
#      migration run. One update run converges any machine to the
#      single-plugin model regardless of prior drift direction or whatever
#      state Claude Code's own plugin manager left the cache in.
_migrate_legacy_router_plugin() {
  if command -v claude >/dev/null 2>&1 && \
     claude plugin list 2>/dev/null | grep -qE "(^|[[:space:]])${_LEGACY_ROUTER_PLUGIN_NAME}(@|[[:space:]]|\$)"; then
    say "migrating: removing legacy plugin $_LEGACY_ROUTER_PLUGIN_NAME (superseded by config-aware single-plugin render, lr-1b5a31)..."
    claude plugin uninstall "${_LEGACY_ROUTER_PLUGIN_NAME}@${_LEGACY_ROUTER_PLUGIN_NAME}" 2>/dev/null || \
      claude plugin uninstall "$_LEGACY_ROUTER_PLUGIN_NAME" 2>/dev/null || \
      warn "could not uninstall legacy plugin $_LEGACY_ROUTER_PLUGIN_NAME via the plugin manager — cache directory will still be removed directly below"
    claude plugin marketplace remove "$_LEGACY_ROUTER_PLUGIN_NAME" 2>/dev/null || true
  fi

  # Cache-directory removal runs regardless of whether `claude` is on PATH
  # or the plugin still showed up in `plugin list` above (lr-35315f gap 1) —
  # this is the actual convergence step. Fixed literal path only; see
  # _LEGACY_ROUTER_PLUGIN_CACHE_DIR's definition for why this can never
  # become an interpolated/config-derived delete.
  if [ -d "$_LEGACY_ROUTER_PLUGIN_CACHE_DIR" ]; then
    say "migrating: removing orphaned legacy plugin cache directory $_LEGACY_ROUTER_PLUGIN_CACHE_DIR..."
    rm -rf "$_LEGACY_ROUTER_PLUGIN_CACHE_DIR" 2>/dev/null || \
      warn "could not remove legacy plugin cache directory $_LEGACY_ROUTER_PLUGIN_CACHE_DIR — remove manually"
  fi
}

# _install_clagentic_lite_plugin
# Renders the config-aware plugin dir, then registers/installs/updates the
# ONE clagentic-lite plugin from that rendered source — replacing both the
# old "install the checked-in tree directly" path and the old
# "separately install a router overlay" path. From lr-1b5a31 onward this is
# the ONLY plugin-install call site in cmd_init/cmd_update; there is no
# router-specific branch left to call separately.
_install_clagentic_lite_plugin() {
  # lr-35315f (PEACHES amos.path-choice.4): _migrate_legacy_router_plugin
  # MUST run before the `claude` availability check below, not after. Its
  # cache-directory removal step is meant to be unconditional -- the whole
  # point of this hardening -- but the ONLY call site in the real dispatch
  # path (cmd_init/cmd_update both go through this function) was gating
  # entry to this function on `claude` being on PATH, so a machine with no
  # `claude` binary (uninstalled, PATH-restricted context, etc.) never
  # reached the migration call at all: the exact "convergence step is still
  # conditional" defect shape as the bug this migration exists to fix, one
  # level up the call stack from where PR #164 first made it. The
  # plugin-manager calls inside _migrate_legacy_router_plugin (`claude
  # plugin uninstall`/`marketplace remove`) still legitimately require
  # `claude` and remain internally guarded by their own `command -v claude`
  # check; only the filesystem cache-directory removal is meant to survive
  # `claude`'s absence, and it now does regardless of where this function's
  # own claude-availability early-return falls.
  _migrate_legacy_router_plugin

  command -v claude >/dev/null 2>&1 || { warn "claude not on PATH — skipping clagentic-lite plugin install"; return 0; }

  _render_clagentic_lite_plugin_dir || { warn "plugin render failed — skipping plugin install"; return 1; }

  claude plugin marketplace add "$_RENDERED_PLUGIN_DIR" --scope user 2>/dev/null || true

  # Migration: uninstall the pre-v1.2.0 plugin name (clagentic-lite-agents)
  # before the exact-match check below. Without this, its presence causes
  # the check to fall through to 'plugin update', which fails because the
  # current name was never installed under the old label.
  if claude plugin list 2>/dev/null | grep -qE '(^|[[:space:]])clagentic-lite-agents(@|[[:space:]]|$)'; then
    say "migrating: removing old plugin name clagentic-lite-agents..."
    claude plugin uninstall "clagentic-lite-agents@clagentic-lite" 2>/dev/null || \
      claude plugin uninstall "clagentic-lite-agents" 2>/dev/null || \
      warn "could not uninstall old plugin clagentic-lite-agents — remove manually: claude plugin uninstall clagentic-lite-agents"
  fi

  # Exact-match check: grep for the current plugin name as a whole token, not
  # a substring. "clagentic-lite-agents" contains "clagentic-lite" as a
  # prefix; substring grep would falsely match it and skip the install of
  # the renamed plugin.
  if claude plugin list 2>/dev/null | grep -qE "(^|[[:space:]])${_RENDERED_PLUGIN_NAME}(@|[[:space:]]|\$)"; then
    claude plugin marketplace update "$_RENDERED_PLUGIN_NAME" 2>/dev/null || \
      warn "claude plugin marketplace update failed — plugin may be stale"
    if claude plugin update "${_RENDERED_PLUGIN_NAME}@${_RENDERED_PLUGIN_NAME}"; then
      say "updated plugin: $_RENDERED_PLUGIN_NAME"
    else
      warn "claude plugin update failed for $_RENDERED_PLUGIN_NAME; run manually: claude plugin update ${_RENDERED_PLUGIN_NAME}@${_RENDERED_PLUGIN_NAME}"
    fi
  else
    if claude plugin install "${_RENDERED_PLUGIN_NAME}@${_RENDERED_PLUGIN_NAME}"; then
      say "installed plugin: $_RENDERED_PLUGIN_NAME (agents and skills available globally)"
    else
      warn "claude plugin install failed — run manually: claude plugin marketplace add $_RENDERED_PLUGIN_DIR && claude plugin install ${_RENDERED_PLUGIN_NAME}@${_RENDERED_PLUGIN_NAME}"
    fi
  fi

  if [ -n "${CLAGENTIC_ROUTER_URL:-}" ] && [ "${CLAGENTIC_ROUTER_INJECT_AGENT_MODEL:-0}" = "1" ]; then
    say "router agent-model injection active (model: role:<role>-chain on reviewer/auditor/merge-gate where CLAGENTIC_<ROLE>_CMD is non-claude)"
    say "UNVERIFIED: whether Claude Code honors this frontmatter model: field has not been confirmed on this machine — see README 'Verifying on your machine'"
  fi
}

# Stamp a wrapper-flavored CLAUDE.md into a non-git wrapper directory.
# Args: WRAPPER_DIR  ENROLLED_REPOS (space-separated absolute paths)
# Note: Claude Code lifecycle hooks (SessionStart, UserPromptSubmit, PreToolUse,
# PostToolUse, Stop) are CWD-agnostic — they load from .claude/settings.json
# relative to the CWD at session open, NOT from the git repo root. Only git
# pre-commit/pre-push hooks are git-repo-rooted. Wrapper sessions must also
# have .claude/settings.json stamped so lifecycle hooks fire correctly.
# See _stamp_wrapper_settings for that wiring.
# Skips if a non-clagentic CLAUDE.md already exists (unless ENROLL_FORCE=1).
_stamp_wrapper_claude_md() {
  _wcd="$1"; _wcd_repos="$2"
  _wcd_template="$SHARE_DIR/hook-shims/CLAUDE.md.wrapper.template"
  [ -f "$_wcd_template" ] || { warn "CLAUDE.md.wrapper.template missing — skipping wrapper CLAUDE.md"; return 0; }

  _wcd_target="$_wcd/CLAUDE.md"
  if [ -f "$_wcd_target" ] && ! grep -q 'managed-by: clagentic' "$_wcd_target" 2>/dev/null; then
    if [ "${ENROLL_FORCE:-0}" = "1" ]; then
      warn "overwriting existing non-clagentic CLAUDE.md in wrapper $_wcd (--force)"
    else
      warn "existing CLAUDE.md in wrapper $_wcd is not clagentic-managed — skipping (use --force to overwrite)"
      return 0
    fi
  fi

  # Generate the file directly — multiline table substitution via sed is
  # fragile (newlines, special chars in paths). Read template line by line;
  # replace the token line with the generated table.
  {
    while IFS= read -r _tmpl_line; do
      case "$_tmpl_line" in
        *__WRAPPER_PROJECT_TABLE__*)
          # Include last-gate-run column when sqlite3 is available (best-effort).
          if command -v sqlite3 >/dev/null 2>&1; then
            printf '| Subfolder | Last gate run | Status |\n'
            printf '|---|---|---|\n'
            for _wr in $_wcd_repos; do
              _rel="${_wr#$_wcd}"
              _rel="${_rel#/}"
              [ -z "$_rel" ] && _rel="$_wr"
              _wcd_db="$_wr/.clagentic/lite/audit.db"
              _wcd_last=""
              if [ -f "$_wcd_db" ]; then
                _wcd_last=$(sqlite3 "$_wcd_db" "SELECT MAX(ts) FROM gate_runs;" 2>/dev/null || true)
              fi
              [ -z "$_wcd_last" ] && _wcd_last="never"
              # Check hook presence for a quick health indicator.
              _wcd_status="ok"
              _wcd_git_dir=$(git -C "$_wr" rev-parse --git-dir 2>/dev/null || true)
              if [ -z "$_wcd_git_dir" ]; then
                _wcd_status="not-a-repo"
              else
                case "$_wcd_git_dir" in
                  /*) _wcd_hd="$_wcd_git_dir/hooks" ;;
                  *)  _wcd_hd="$_wr/$_wcd_git_dir/hooks" ;;
                esac
                if [ ! -f "$_wcd_hd/pre-commit" ]; then
                  _wcd_status="hooks missing"
                fi
              fi
              printf '| `%s` | %s | %s |\n' "$_rel" "$_wcd_last" "$_wcd_status"
            done
          else
            # sqlite3 not available — simpler table without last-gate column.
            printf '| Subfolder | Absolute path |\n'
            printf '|---|---|\n'
            for _wr in $_wcd_repos; do
              _rel="${_wr#$_wcd}"
              _rel="${_rel#/}"
              [ -z "$_rel" ] && _rel="$_wr"
              printf '| `%s` | `%s` |\n' "$_rel" "$_wr"
            done
          fi
          ;;
        *)
          printf '%s\n' "$_tmpl_line"
          ;;
      esac
    done < "$_wcd_template"
  } > "$_wcd_target"
  say "stamped wrapper CLAUDE.md: $_wcd_target" >&2
}

# Stamp .claude/settings.json and symlink .claude/commands into a non-git
# wrapper directory so Claude Code lifecycle hooks fire when opened there.
# Args: WRAPPER_DIR
# Only adds .claude/ to .gitignore when the wrapper dir is not itself a git repo.
_stamp_wrapper_settings() {
  _sws_wrapper="$1"
  _sws_template="$SHARE_DIR/hook-shims/claude-settings.template"
  [ -f "$_sws_template" ] || { warn "claude-settings.template missing — skipping wrapper settings stamp"; return 0; }

  _sws_claude_dir="$_sws_wrapper/.claude"
  mkdir -p "$_sws_claude_dir" || { warn "cannot create $_sws_claude_dir"; return 0; }

  # Stamp settings.json with __CLAGENTIC_LITE_HOME__ substituted.
  # Use a distinct $comment marker so the wrapper file is self-describing.
  _sws_target="$_sws_claude_dir/settings.json"
  if [ -f "$_sws_target" ] && ! grep -q 'managed-by: clagentic' "$_sws_target" 2>/dev/null; then
    if [ "${ENROLL_FORCE:-0}" = "1" ]; then
      warn "overwriting existing non-clagentic .claude/settings.json in wrapper $_sws_wrapper (--force)"
    else
      warn "existing .claude/settings.json in wrapper $_sws_wrapper is not clagentic-managed — skipping (use --force to overwrite)"
      return 0
    fi
  fi

  # Generate settings.json from the shared template (router env block
  # included when CLAGENTIC_ROUTER_URL is set), then replace the $comment
  # value so it identifies this as a wrapper-settings file (version: v1).
  # _stamp_claude_settings validates CLAGENTIC_ROUTER_URL and writes
  # atomically -- see that function's doc comment.
  _stamp_claude_settings "$_sws_template" "$_sws_target" \
    "s|clagentic-settings-version: v[^ ]*|clagentic-wrapper-settings-version: $CLAUDE_WRAPPER_SETTINGS_VERSION|g"

  # Symlink commands/ so slash commands are available in wrapper sessions.
  ln -sfn "$CLAGENTIC_LITE_HOME/.claude/commands" "$_sws_claude_dir/commands"

  # Add .claude/ to .gitignore only when the wrapper dir is not a git repo.
  # (Wrapper dirs are by definition non-git, but guard for robustness.)
  if ! git -C "$_sws_wrapper" rev-parse --git-dir >/dev/null 2>&1; then
    _sws_gi="$_sws_wrapper/.gitignore"
    if [ ! -f "$_sws_gi" ]; then
      printf '.claude/\n' > "$_sws_gi"
      say "created $_sws_gi with .claude/ pattern" >&2
    elif ! grep -qxF '.claude/' "$_sws_gi" 2>/dev/null; then
      printf '.claude/\n' >> "$_sws_gi"
      say "added .claude/ to $_sws_gi" >&2
    fi
  fi

  say "stamped wrapper .claude/settings.json: $_sws_target" >&2
}

# ---------------------------------------------------------------- prereq helpers
#
# Single source of truth for "what tools does clagentic-lite need". cmd_init,
# cmd_update, and cmd_doctor all call into here so adding a new required tool
# means editing one function, not three.
#
# Required tools: hard prereqs. Init/update will offer to install; doctor
# will fail if absent.
# Security tools: needed by the secrets/sast/deps gates. Skippable via the
# ALLOW_MISSING_* env vars; doctor reports them as WARN, not FAIL.
# JSON validator: jq OR python3 satisfies the requirement (hooks fall back
# to python3 when jq is absent). Handled separately because of the "either-or".

# Look up per-OS install hints for a security tool, keyed off CLAGENTIC_SECURITY_TOOLS.
# Echoes "LINUX_HINT|DARWIN_HINT" — caller splits on '|'. Returns 1 for unknown
# names (so adding a name to CLAGENTIC_SECURITY_TOOLS without adding a hint case
# here fails loudly instead of silently degrading).
# semgrep's linux hint is dynamic (PEP 668 picker); the others are static.
_security_tool_hints() {
  _STH_NAME="$1"
  case "$_STH_NAME" in
    gitleaks)
      printf '%s|%s' \
        "see https://github.com/gitleaks/gitleaks#installing" \
        "brew install gitleaks"
      ;;
    semgrep)
      printf '%s|%s' "$(_semgrep_hint_linux)" "brew install semgrep"
      ;;
    osv-scanner)
      printf '%s|%s' \
        "see https://google.github.io/osv-scanner/installation/" \
        "brew install osv-scanner"
      ;;
    *)
      return 1
      ;;
  esac
}

# Pick the right semgrep install hint for this host. PEP 668 (Debian 12+,
# Ubuntu 23.04+, modern WSL) refuses unmanaged pip installs against system
# Python — suggesting `pip install --user` there produces the
# "externally-managed-environment" error. Order of preference:
#   1. pipx present                       -> pipx install semgrep
#   2. no pipx, Python NOT PEP-668        -> python3 -m pip install --user semgrep
#   3. no pipx, Python IS PEP-668 managed -> apt install pipx (then re-run init)
#   4. no pipx, no python3                -> point at vendor docs
_semgrep_hint_linux() {
  if command -v pipx >/dev/null 2>&1; then
    printf '%s' "pipx install semgrep"
    return
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    printf '%s' "see https://semgrep.dev/docs/getting-started/"
    return
  fi
  set -- /usr/lib/python3*/EXTERNALLY-MANAGED /usr/lib/python3/EXTERNALLY-MANAGED
  for _f in "$@"; do
    if [ -e "$_f" ]; then
      printf '%s' "apt install pipx  # then re-run \`clagentic-lite init\` (PEP 668 — system python refuses pip --user)"
      return
    fi
  done
  printf '%s' "python3 -m pip install --user semgrep"
}

# _run_prereq_checks MODE
#   MODE = "init"   -> ds_offer_install for required + security tools.
#   MODE = "update" -> same (so post-update checks match init coverage).
# Sets DS_CHECK_MISSING (required tools only) and DS_PENDING_INSTALLS.
# Prints the collated still-to-install summary at the end.
_run_prereq_checks() {
  _RPC_MODE="${1:-init}"
  DS_CHECK_MISSING=0; export DS_CHECK_MISSING
  ds_pending_reset

  # Required: sqlite3, git.
  ds_offer_install sqlite3 "apt install sqlite3" "brew install sqlite" || DS_CHECK_MISSING=$((DS_CHECK_MISSING+1))
  ds_offer_install git "apt install git" "xcode-select --install" || DS_CHECK_MISSING=$((DS_CHECK_MISSING+1))

  # Required: jq OR python3. Either one satisfies.
  if command -v jq >/dev/null 2>&1; then
    printf '  %-15s found: %s\n' "jq" "$(command -v jq)"
  elif command -v python3 >/dev/null 2>&1; then
    printf '  %-15s found (python3 fallback): %s\n' "jq" "$(command -v python3)"
  else
    ds_offer_install jq "apt install jq" "brew install jq" || DS_CHECK_MISSING=$((DS_CHECK_MISSING+1))
    warn "no JSON validator — PreToolUse hooks will fail closed until jq or python3 is installed"
  fi

  # Security gate tools — required unless ALLOW_MISSING_* opts in. Not counted
  # toward DS_CHECK_MISSING because the user might legitimately opt out.
  # List of names lives in CLAGENTIC_SECURITY_TOOLS (top of file); hints come
  # from _security_tool_hints, which fails loudly if a name lacks a case
  # (catches "added to list but forgot to add hints" drift).
  for _stool in $CLAGENTIC_SECURITY_TOOLS; do
    _sthints=$(_security_tool_hints "$_stool") || \
      die "internal: no install hint for security tool '$_stool' (update _security_tool_hints in bin/clagentic-lite)"
    _stl="${_sthints%%|*}"
    _std="${_sthints##*|}"
    ds_offer_install "$_stool" "$_stl" "$_std" || true
  done

  # Nice-to-have: timeout / gtimeout.
  if ! command -v timeout >/dev/null 2>&1 && ! command -v gtimeout >/dev/null 2>&1; then
    printf '  %-15s MISSING (optional) — install: %s\n' "timeout" \
      "brew install coreutils (macOS) | apt install coreutils (Linux)"
    warn "no timeout/gtimeout — LLM calls will run without per-call timeouts"
  fi

  # Single collated summary at the bottom of the run.
  ds_pending_summary

  if [ "$DS_CHECK_MISSING" -gt 0 ]; then
    case "$_RPC_MODE" in
      update)
        say "$DS_CHECK_MISSING required tool(s) still missing post-update — fix them before next gate run"
        ;;
      *)
        say "$DS_CHECK_MISSING required tool(s) still missing — fix them and re-run \`clagentic-lite init\`"
        ;;
    esac
    if [ "${CLAGENTIC_STRICT_PREFLIGHT:-0}" = "1" ]; then
      die "strict preflight: $DS_CHECK_MISSING required tool(s) missing"
    fi
  fi
}

# ---------------------------------------------------------------- init

cmd_init() {
  RECONFIGURE=0
  for _arg in "$@"; do
    case "$_arg" in --reconfigure) RECONFIGURE=1 ;; esac
  done

  say "clagentic-lite init"
  say "CLAGENTIC_LITE_HOME: $CLAGENTIC_LITE_HOME"

  # 1. Verify this is a clagentic-lite checkout.
  if [ ! -f "$CLAGENTIC_LITE_HOME/scripts/gates.sh" ]; then
    die "$CLAGENTIC_LITE_HOME does not look like a clagentic-lite checkout (scripts/gates.sh missing)"
  fi

  # 1.5. Freshness check. If CLAGENTIC_LITE_HOME is a git checkout and the local
  # branch is behind its upstream, nudge the user to run `clagentic-lite update`
  # before continuing — otherwise init runs against stale code (the silent
  # footgun that bit early users when PRs #3/#4/#5 landed and they kept
  # re-running init without pulling).
  # Skippable with CLAGENTIC_SKIP_FETCH=1 for offline use, and silently
  # tolerant of failure (no upstream, no network, not a worktree, etc.).
  #
  # REPO SCOPING (lr-da1f28 sweep): `rev-parse --git-dir` succeeding only
  # proves SOME ancestor of CLAGENTIC_LITE_HOME is a git repo, not that
  # CLAGENTIC_LITE_HOME itself is — `-C <dir>` changes cwd before git's own
  # repo discovery walks up the filesystem. Require the resolved toplevel to
  # actually equal CLAGENTIC_LITE_HOME before trusting any read below.
  _init_git_toplevel=$(git -C "$CLAGENTIC_LITE_HOME" rev-parse --show-toplevel 2>/dev/null || echo "")
  _init_home_canon=$(cd "$CLAGENTIC_LITE_HOME" 2>/dev/null && pwd -P || printf '%s' "$CLAGENTIC_LITE_HOME")
  if [ "${CLAGENTIC_SKIP_FETCH:-0}" != "1" ] \
      && [ -n "$_init_git_toplevel" ] && [ "$_init_git_toplevel" = "$_init_home_canon" ]; then
    # Best-effort fetch; suppress output. Network failures are non-fatal.
    git -C "$CLAGENTIC_LITE_HOME" fetch --quiet 2>/dev/null || true
    _BRANCH=$(git -C "$CLAGENTIC_LITE_HOME" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    _UPSTREAM=$(git -C "$CLAGENTIC_LITE_HOME" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "")
    if [ -n "$_BRANCH" ] && [ -n "$_UPSTREAM" ]; then
      _BEHIND=$(git -C "$CLAGENTIC_LITE_HOME" rev-list --count "HEAD..$_UPSTREAM" 2>/dev/null || echo 0)
      if [ "$_BEHIND" -gt 0 ] 2>/dev/null; then
        warn "$CLAGENTIC_LITE_HOME is $_BEHIND commit(s) behind $_UPSTREAM — run \`clagentic-lite update\` to pick up the latest fixes before re-running init"
      fi
    fi
  fi

  # 1.6. Materialize $CLAGENTIC_LITE_HOME/.claude/hooks/*.sh from
  # share/hook-shims/*.sh.template (lr-57db23). Always runs, unconditionally
  # (idempotent, cheap, no prompts) — this is the ONE copy of the Claude Code
  # lifecycle hooks every enrolled repo's settings.json calls back into by
  # absolute path; without this step a fresh checkout has no .claude/hooks/
  # at all and every enrolled repo's hooks fail closed (missing script).
  _init_hooks_stamped=$(_stamp_claude_hooks)
  say "materialized $_init_hooks_stamped Claude Code hook script(s): $CLAGENTIC_LITE_HOME/.claude/hooks/"

  # 2. Prereq detection — shared helper used by init / update / doctor.
  #    On a re-run with config already present, the prereq sweep still runs
  #    (always useful), but the two-question front door is skipped — silence
  #    when nothing will change.
  say "checking prerequisites..."
  _run_prereq_checks init

  # 2.5. Global config migration (lr-7939f8): an install with a config still
  # at the pre-lr-7939f8 brand-root path gets it moved to the product path
  # here too, not only on `update` -- otherwise a first `init` run on an
  # un-migrated machine would see no $GLOBAL_CONFIG at the new path and
  # re-run the full interactive front door, discarding the operator's
  # existing settings instead of recognizing them. No-op if already
  # migrated or if there is nothing at the old path.
  #
  # STATUS IS CHECKED EXPLICITLY, not inferred from `[ -f "$GLOBAL_CONFIG" ]`
  # below (BOBBIE bobbie.uncat.1, folded in over its own non-blocking rating
  # -- lore task lr-7939f8 comment #2). Calling this bare would still abort
  # the whole `init` run on a `return 1` today, because `set -e` (top of
  # file) propagates through an unwrapped simple-command failure -- but that
  # protection is incidental to the call SHAPE, not a property of what this
  # step actually needs, and is one `if _migrate...; then` refactor (which
  # exempts its condition from `set -e` by construction) or one `set -e`
  # removal away from silently regressing into exactly the state
  # _migrate_global_config_brand_path itself refuses to create when it
  # detects it directly: a fresh config written at $GLOBAL_CONFIG while the
  # operator's real, un-migrated credentials sit untouched and unread at
  # $OLD_GLOBAL_CONFIG. Wrapping the call in `if` here makes the check
  # explicit and durable rather than borrowed from an unrelated top-of-file
  # setting -- and, being an `if` condition, does NOT itself trigger `set -e`
  # on failure, so this is not a behavior change for a genuine hard error
  # elsewhere in `init`.
  _migration_ok=1
  if ! _migrate_global_config_brand_path; then
    _migration_ok=0
  fi

  # 3. Two-question front door. Skip entirely when global config already
  #    exists and --reconfigure was not passed — otherwise re-runs of init
  #    pointlessly ask "Accept all defaults? [Y/n]" every time. When
  #    --reconfigure IS passed against an existing config, _write_global_config
  #    MERGES (preserves every user-set value, adds new keys) rather than
  #    clobbering (lr-25e73e item 4) — see its own header comment.
  if [ "$_migration_ok" -eq 0 ] && [ -f "$OLD_GLOBAL_CONFIG" ] && [ ! -f "$GLOBAL_CONFIG" ]; then
    # A genuinely FAILED migration (old file survives untouched -- migration
    # never touches it on any failure path -- and no new file was ever
    # installed) must never fall through to _write_global_config: that would
    # write fresh DEFAULTS at $GLOBAL_CONFIG while the operator's real,
    # un-migrated credentials sit unread at $OLD_GLOBAL_CONFIG -- new-path-
    # wins precedence (ds_load_global_env) then makes every subsequent
    # command silently run on defaults instead of the operator's actual
    # config. Refuse loudly instead; the operator's config is untouched and
    # still fully readable at the old path (back-compat fallback,
    # ds_load_global_env) either way.
    die "global config migration failed -- see the WARN above for the cause. Your config is untouched at $OLD_GLOBAL_CONFIG (still honored as a read fallback). Fix the cause and re-run \`clagentic-lite init\` or \`clagentic-lite update\`; refusing to write a fresh config at $GLOBAL_CONFIG alongside your real one at the old path."
  fi
  if [ -f "$GLOBAL_CONFIG" ] && [ "$RECONFIGURE" -eq 0 ]; then
    say "global config already exists at $GLOBAL_CONFIG (use --reconfigure to re-prompt)"
  else
    _write_global_config
  fi

  # 4. Ensure ~/.local/bin/ exists.
  _ensure_local_bin

  # 5. Symlink ~/.local/bin/clagentic-lite -> $CLAGENTIC_LITE_HOME/bin/clagentic-lite.
  _install_symlink

  # 6. Render and install the ONE clagentic-lite plugin (config-aware —
  # lr-1b5a31). Replaces the old two-call sequence (install the checked-in
  # tree directly, then separately install a router overlay plugin): now
  # there is exactly one plugin-install call site, and it always renders
  # from the checked-in agent files into a config-aware copy before
  # installing, whether or not router injection is active.
  _install_clagentic_lite_plugin

  say "init complete"
  if [ -f "$GLOBAL_CONFIG" ] && [ "$RECONFIGURE" -eq 0 ]; then
    say "(no config changes — re-ran prereq + symlink only)"
  fi
  say "next: cd into any repo you want gates on, then run \`clagentic-lite enroll\`"
}

_write_global_config() {
  # lr-25e73e item 4: `init --reconfigure` on an EXISTING config must MERGE,
  # not clobber — preserve every user-set value, add new keys. Capture the
  # existing file's active (non-comment) KEY=VALUE pairs, byte-for-byte,
  # into a preservation side-file BEFORE anything below touches
  # $GLOBAL_CONFIG. A fresh (no prior config) run captures nothing, so this
  # is a strict no-op for first-time `init` — identical output to before.
  #
  # SECRETS: this side-file holds live credential VALUES (same class of data
  # as $GLOBAL_CONFIG itself) — created 600 from the start via
  # _secret_tmp_create (umask-independent, before any content is written),
  # never printed, never logged, removed at the end of this function on
  # every exit path.
  _wgc_preserve=""
  if [ -f "$GLOBAL_CONFIG" ]; then
    _wgc_preserve="$GLOBAL_CONFIG.preserve.$$"
    _secret_tmp_create "$_wgc_preserve" || { warn "could not chmod 600 preservation temp file — aborting to avoid a momentarily-exposed secrets file"; return 1; }
    # KEY=VALUE lines only (active, not commented-out) — a commented-out line
    # in the OLD config carries no user decision to preserve; the fresh
    # template's own commented form (or the append pass, separately) is
    # authoritative for those. Matches up to the FIRST '=' only, so a value
    # containing '=' round-trips: everything after the first '=' is the value,
    # untouched. CRLF: normalize to LF on read so a Windows-edited config's
    # values still resolve to plain-content matches below; the file is
    # rewritten LF-only regardless (matches config.example's own convention).
    # Appended (>>) directly onto the already-600 file created above — never
    # a bare `awk ... > newfile` (see _secret_tmp_create's own comment for
    # why that pattern is unsafe on a secrets-bearing path).
    awk -v OFS= '
      { sub(/\r$/, "") }
      /^CLAGENTIC_[A-Za-z0-9_]*=/ { print }
    ' "$GLOBAL_CONFIG" >> "$_wgc_preserve"
  fi

  # Q1: accept all defaults?
  ACCEPT_DEFAULTS="y"
  if [ -t 0 ]; then
    printf 'Accept all defaults? [Y/n]: '
    read -r _q1 || _q1=""
    [ -z "$_q1" ] && _q1="y"
    case "$_q1" in y|Y|yes|YES) ACCEPT_DEFAULTS="y" ;; *) ACCEPT_DEFAULTS="n" ;; esac
  fi

  # Q2: vendor mode (only asked when accepting defaults or in granular mode).
  VENDOR_MODE="2"
  if [ "$ACCEPT_DEFAULTS" = "y" ] && [ -t 0 ]; then
    printf 'Vendor mode?  [1] Claude only  [2] Claude + Codex (cross-vendor, default): '
    read -r _q2 || _q2=""
    [ -z "$_q2" ] && _q2="2"
    VENDOR_MODE="$_q2"
  fi

  # Start with the example as the base.
  _CONFIG_SRC="$SHARE_DIR/config.example"
  if [ ! -f "$_CONFIG_SRC" ]; then
    rm -f "$_wgc_preserve"
    die "share/config.example missing — is \$CLAGENTIC_LITE_HOME correct?"
  fi

  # Prepare destination directory.
  _config_dir="$(dirname "$GLOBAL_CONFIG")"
  if [ ! -d "$_config_dir" ]; then
    mkdir -p "$_config_dir" && chmod 700 "$_config_dir" \
      || { warn "cannot create $_config_dir"; rm -f "$_wgc_preserve"; return 1; }
  fi

  # Write the fresh template to a 600 temp file first (never briefly
  # world-readable), then move it into place — matches the append-pass
  # discipline in _append_missing_config_keys. Created via _secret_tmp_create
  # (not a bare `cp`, which would create the destination at umask-derived
  # permissions for the instant between creation and the following chmod)
  # then populated with `cat >>` onto the already-600 file, for the same
  # reason every other temp file in this function now does the same —
  # config.example itself carries no secrets, but this keeps exactly one
  # sanctioned creation pattern for every temp file in this function rather
  # than two, so the safe pattern cannot silently regress at this one site.
  _wgc_new="$GLOBAL_CONFIG.new.$$"
  _secret_tmp_create "$_wgc_new" || { warn "could not chmod 600 template temp file"; rm -f "$_wgc_preserve"; return 1; }
  cat "$_CONFIG_SRC" >> "$_wgc_new"

  # Stamp CLAGENTIC_LITE_HOME and CLAGENTIC_CONFIG_SCHEMA_VERSION (lr-e33f73).
  # CLAGENTIC_CONFIG_SCHEMA_VERSION is auto-managed bookkeeping (config.example
  # itself: "Do not hand-edit") — always re-stamped to the CURRENT constant on
  # --reconfigure, never preserved from a stale prior value; CLAGENTIC_LITE_HOME
  # is likewise always re-derived, never a hand-edited value worth preserving.
  # Every awk pass below writes to a FRESH _secret_tmp_create'd file, then
  # mv's it back onto $_wgc_new — never a bare `awk ... > $_wgc_new.tmp`
  # (see _secret_tmp_create's own comment).
  _wgc_new_tmp="$GLOBAL_CONFIG.new.stamp.$$"
  _secret_tmp_create "$_wgc_new_tmp" || { warn "could not chmod 600 stamping temp file"; rm -f "$_wgc_preserve" "$_wgc_new"; return 1; }
  awk -v home="$CLAGENTIC_LITE_HOME" -v schema="$CONFIG_SCHEMA_VERSION" '
    /^CLAGENTIC_LITE_HOME=/ { print "CLAGENTIC_LITE_HOME=" home; next }
    /^CLAGENTIC_CONFIG_SCHEMA_VERSION=/ { print "CLAGENTIC_CONFIG_SCHEMA_VERSION=" schema; next }
    { print }
  ' "$_wgc_new" >> "$_wgc_new_tmp"
  mv "$_wgc_new_tmp" "$_wgc_new"

  # Apply vendor mode: if mode=1 (Claude only), set all roles to claude.
  if [ "$VENDOR_MODE" = "1" ]; then
    _wgc_new_tmp="$GLOBAL_CONFIG.new.vendor.$$"
    _secret_tmp_create "$_wgc_new_tmp" || { warn "could not chmod 600 vendor-mode temp file"; rm -f "$_wgc_preserve" "$_wgc_new"; return 1; }
    awk '
      /^CLAGENTIC_(REVIEWER|AUDITOR)_CMD=/ { sub(/=.*/, "=claude"); }
      /^CLAGENTIC_(REVIEWER|AUDITOR)_CHAIN=/ { sub(/=.*/, "=claude:default"); }
      { print }
    ' "$_wgc_new" >> "$_wgc_new_tmp"
    mv "$_wgc_new_tmp" "$_wgc_new"
    warn "Builder and Reviewer both set to 'claude'. Cross-vendor review surfaces blind spots that same-vendor review shares."
  fi

  # Granular flow: max 6 prompts when user declined all-defaults. Operates on
  # $GLOBAL_CONFIG directly (pre-existing behavior/contract) — repoint it at
  # the new-file-in-progress for the duration of the call, then move the
  # result back, so a merge in progress isn't clobbered by a second direct
  # $GLOBAL_CONFIG write while _wgc_new is still being assembled.
  # GRANULAR_PROMPT_ANSWERS_FILE is set BY _granular_config_prompts (this-run
  # interactive answers, see its own comment) and consumed by
  # _merge_preserved_config_values below for precedence.
  GRANULAR_PROMPT_ANSWERS_FILE=""
  if [ "$ACCEPT_DEFAULTS" = "n" ] && [ -t 0 ]; then
    _wgc_real_global_config="$GLOBAL_CONFIG"
    GLOBAL_CONFIG="$_wgc_new"
    _granular_config_prompts
    GLOBAL_CONFIG="$_wgc_real_global_config"
  fi

  # lr-25e73e item 4 + fold-in (PEACHES amos.code-craft.1, BOBBIE
  # bobbie.secret.7): merge preserved OLD-config values and this-run
  # interactive answers over the freshly-assembled template. Factored into
  # _merge_preserved_config_values (below) — callable directly, without a
  # TTY, so its precedence logic is unit-testable on its own rather than
  # only through the interactive prompt path (PEACHES's preferred fix over
  # PTY plumbing). Skipped entirely on a fresh `init` (no prior config, no
  # interactive answers) — a strict no-op either way, but this avoids extra
  # temp-file churn on the common first-install path.
  if [ -n "$_wgc_preserve" ] || [ -n "$GRANULAR_PROMPT_ANSWERS_FILE" ]; then
    _wgc_new=$(_merge_preserved_config_values "$_wgc_new" "$_wgc_preserve" "$GRANULAR_PROMPT_ANSWERS_FILE") \
      || { warn "config merge failed"; rm -f "$_wgc_preserve" "$_wgc_new"; [ -n "$GRANULAR_PROMPT_ANSWERS_FILE" ] && rm -f "$GRANULAR_PROMPT_ANSWERS_FILE"; return 1; }
  fi

  mv "$_wgc_new" "$GLOBAL_CONFIG"
  chmod 600 "$GLOBAL_CONFIG"
  rm -f "$_wgc_preserve"
  [ -n "$GRANULAR_PROMPT_ANSWERS_FILE" ] && rm -f "$GRANULAR_PROMPT_ANSWERS_FILE"

  # Stamp bleed-patterns template if not already present. This is a side-by-side
  # companion to config — it lives in the same directory but is not gitignored
  # (patterns are private, so the file is never committed to the public repo).
  # Skip silently if it already exists — do not overwrite a user's pattern list.
  _BLEED_SRC="$SHARE_DIR/bleed-patterns.example"
  _BLEED_DEST="$(dirname "$GLOBAL_CONFIG")/bleed-patterns"
  if [ -f "$_BLEED_SRC" ] && [ ! -f "$_BLEED_DEST" ]; then
    cp "$_BLEED_SRC" "$_BLEED_DEST"
    chmod 600 "$_BLEED_DEST"
    say "wrote bleed-patterns template: $_BLEED_DEST (add your private patterns there)"
  fi

  say "wrote global config: $GLOBAL_CONFIG (chmod 600)"
}

# _merge_preserved_config_values TARGET_FILE PRESERVE_FILE [ANSWERS_FILE]
# lr-25e73e item 4 + fold-in (PEACHES amos.code-craft.1, BOBBIE
# bobbie.secret.7). Merges preserved OLD-config values and this-run
# interactive answers over TARGET_FILE (the freshly-assembled template,
# already stamped/vendor-adjusted). Echoes the path to a new 600 temp file
# holding the merge result on success (caller mv's it into place); returns
# nonzero on failure with no path echoed.
#
# PRECEDENCE, explicit and load-bearing (PEACHES finding 2 — the prompt
# answers used to be silently discarded by the preservation merge that ran
# after them):
#     interactive answer (THIS run, ANSWERS_FILE) > preserved existing
#     value (PRESERVE_FILE, from the OLD config) > template default
#     (already baked into TARGET_FILE).
# Mechanically: PRESERVE_FILE is applied FIRST, then ANSWERS_FILE is applied
# SECOND, on top — so any key present in both wins on the ANSWERS_FILE side.
# If this order is ever changed, update this comment at the same time; nothing
# else in this file re-derives or re-states the precedence rule.
#
# Factored out of _write_global_config specifically so this logic is
# unit-testable by calling it directly with a synthetic ANSWERS_FILE — no
# TTY, no PTY plumbing, no `read` involved — while still being the exact
# code path the interactive prompt flow exercises for real.
#
# SECRETS: every temp file this function creates is 600-from-creation via
# _secret_tmp_create; content only ever reaches an already-600 file via `>>`
# append, mirroring the discipline documented on _secret_tmp_create.
# Skips CLAGENTIC_LITE_HOME/CLAGENTIC_CONFIG_SCHEMA_VERSION even if present
# in either input file, so the caller's own fresh stamp is never overwritten.
_merge_preserved_config_values() {
  _mpcv_target="$1"
  _mpcv_preserve="$2"
  _mpcv_answers="${3:-}"

  _mpcv_body="$_mpcv_target.merge-body.$$"
  _secret_tmp_create "$_mpcv_body" || return 1
  cat "$_mpcv_target" >> "$_mpcv_body"

  # Apply PRESERVE_FILE first, then ANSWERS_FILE — see precedence comment
  # above. Same substitution shape for both: one KEY=VALUE line at a time,
  # awk substitutes only the matching `KEY=` or `# KEY=` line (activating
  # it), leaving every other line — formatting, ordering, unrelated
  # comments — byte-for-byte untouched. A key with no corresponding line
  # anywhere in the target is appended verbatim at end of file rather than
  # silently dropped (e.g. a preserved key retired from the template since
  # this install's last init).
  for _mpcv_src in "$_mpcv_preserve" "$_mpcv_answers"; do
    [ -n "$_mpcv_src" ] || continue
    [ -s "$_mpcv_src" ] || continue
    while IFS= read -r _mpcv_line; do
      [ -z "$_mpcv_line" ] && continue
      _mpcv_key="${_mpcv_line%%=*}"
      case "$_mpcv_key" in
        CLAGENTIC_LITE_HOME|CLAGENTIC_CONFIG_SCHEMA_VERSION) continue ;;
        ''|*[!A-Za-z0-9_]*) continue ;;  # malformed key name -- skip, do not error
      esac

      _mpcv_step="$_mpcv_target.merge-step.$$"
      _mpcv_notfound="$_mpcv_target.merge-notfound.$$"
      _secret_tmp_create "$_mpcv_step" || { rm -f "$_mpcv_body"; return 1; }
      _secret_tmp_create "$_mpcv_notfound" || { rm -f "$_mpcv_body" "$_mpcv_step"; return 1; }

      awk -v key="$_mpcv_key" -v line="$_mpcv_line" '
        BEGIN { active_pat = "^" key "="; comment_pat = "^#[ \t]*" key "=" }
        $0 ~ active_pat { print line; found=1; next }
        $0 ~ comment_pat { print line; found=1; next }
        { print }
        END { if (!found) print line >> "/dev/stderr" }
      ' "$_mpcv_body" 1>>"$_mpcv_step" 2>>"$_mpcv_notfound"
      mv "$_mpcv_step" "$_mpcv_body"

      if [ -s "$_mpcv_notfound" ]; then
        printf '%s\n' "$_mpcv_line" >> "$_mpcv_body"
      fi
      rm -f "$_mpcv_notfound"
    done < "$_mpcv_src"
  done

  printf '%s\n' "$_mpcv_body"
}

_granular_config_prompts() {
  # 6 prompts max: vendor mode, default branch, repo host, block severity,
  # builder primary, reviewer primary.
  printf 'Vendor mode?  [1] Claude only  [2] Claude + Codex (cross-vendor, default): '
  read -r _vm || _vm=""; [ -z "$_vm" ] && _vm="2"

  printf 'Default branch [main]: '
  read -r _db || _db=""; [ -z "$_db" ] && _db="main"

  printf 'Repo host (github|gitlab|gitea|none) [github]: '
  read -r _rh || _rh=""; [ -z "$_rh" ] && _rh="github"

  printf 'Block severity (low|medium|high|critical) [high]: '
  read -r _bs || _bs=""; [ -z "$_bs" ] && _bs="high"

  printf 'Builder CLI command [claude]: '
  read -r _bc || _bc=""; [ -z "$_bc" ] && _bc="claude"

  if [ "$_vm" = "2" ]; then
    printf 'Reviewer CLI command [codex]: '
    read -r _rc || _rc=""; [ -z "$_rc" ] && _rc="codex"
  else
    _rc="$_bc"
  fi

  # lr-25e73e fold-in (PEACHES amos.code-craft.1): record these answers as
  # THIS-RUN interactive input, keyed by name, so _write_global_config's
  # preservation merge (which runs AFTER this function returns) can give
  # them precedence over a same-named preserved value from the OLD config.
  # Precedence, explicit: interactive answer (this run) > preserved existing
  # value > template default. Without this, an operator who changes e.g.
  # default branch at the prompt had that answer silently discarded by the
  # merge step -- the exact defect class item 4 exists to fix, inverted.
  # One "KEY=VALUE" pair per line, matching PRESERVE_FILE's own shape so
  # _merge_preserved_config_values can consume both identically. Values here
  # are never secrets (no prompt above ever asks for CLAGENTIC_ROUTER_TOKEN
  # or similar), but the file is still created via _secret_tmp_create for
  # uniform discipline rather than carving out an exception.
  GRANULAR_PROMPT_ANSWERS_FILE="$GLOBAL_CONFIG.granular-answers.$$"
  _secret_tmp_create "$GRANULAR_PROMPT_ANSWERS_FILE" || { warn "could not chmod 600 granular-answers temp file"; return 1; }
  {
    printf 'CLAGENTIC_DEFAULT_BRANCH=%s\n' "$_db"
    printf 'CLAGENTIC_REPO_HOST=%s\n' "$_rh"
    printf 'CLAGENTIC_BLOCK_SEVERITY=%s\n' "$_bs"
    printf 'CLAGENTIC_BUILDER_CMD=%s\n' "$_bc"
    printf 'CLAGENTIC_REVIEWER_CMD=%s\n' "$_rc"
  } >> "$GRANULAR_PROMPT_ANSWERS_FILE"

  _gcp_tmp="$GLOBAL_CONFIG.tmp.$$"
  _secret_tmp_create "$_gcp_tmp" || { warn "could not chmod 600 granular-prompts temp file"; return 1; }
  awk -v vm="$_vm" -v db="$_db" -v rh="$_rh" -v bs="$_bs" -v bc="$_bc" -v rc="$_rc" '
    /^CLAGENTIC_DEFAULT_BRANCH=/    { print "CLAGENTIC_DEFAULT_BRANCH=" db; next }
    /^CLAGENTIC_REPO_HOST=/         { print "CLAGENTIC_REPO_HOST=" rh; next }
    /^CLAGENTIC_BLOCK_SEVERITY=/    { print "CLAGENTIC_BLOCK_SEVERITY=" bs; next }
    /^CLAGENTIC_BUILDER_CMD=/       { print "CLAGENTIC_BUILDER_CMD=" bc; next }
    /^CLAGENTIC_REVIEWER_CMD=/      { print "CLAGENTIC_REVIEWER_CMD=" rc; next }
    /^CLAGENTIC_(AUDITOR|GATE)_CMD=/ { print $0; next }
    { print }
  ' "$GLOBAL_CONFIG" >> "$_gcp_tmp"
  mv "$_gcp_tmp" "$GLOBAL_CONFIG"
  chmod 600 "$GLOBAL_CONFIG"

  if [ "$_vm" = "1" ] || [ "$_bc" = "$_rc" ]; then
    warn "Builder and Reviewer both set to '$_bc'. Cross-vendor review surfaces blind spots that same-vendor review shares."
  fi
}

_ensure_local_bin() {
  if [ ! -d "$LOCAL_BIN" ]; then
    mkdir -p "$LOCAL_BIN" \
      || { warn "cannot create $LOCAL_BIN"; return 1; }
  fi
  # Warn if LOCAL_BIN is not on PATH.
  case ":$PATH:" in
    *":$LOCAL_BIN:"*) : ;;
    *)
      warn "$LOCAL_BIN is not on \$PATH"
      warn "Add this line to your shell profile (~/.bashrc, ~/.zshrc, ~/.profile):"
      warn '  export PATH="$HOME/.local/bin:$PATH"'
      ;;
  esac
}

_install_symlink() {
  _CLI_TARGET="$CLAGENTIC_LITE_HOME/bin/clagentic-lite"
  if [ ! -f "$_CLI_TARGET" ]; then
    warn "bin/clagentic-lite not found at $_CLI_TARGET — cannot create symlink"
    return 1
  fi
  chmod +x "$_CLI_TARGET"

  if [ -e "$CLI_SYMLINK" ] && [ ! -L "$CLI_SYMLINK" ]; then
    warn "$CLI_SYMLINK exists and is a regular file, not a symlink — refusing to overwrite"
    warn "Remove it manually then re-run \`clagentic-lite init\`"
    return 1
  fi
  # Remove existing symlink (may point to old path) and recreate.
  rm -f "$CLI_SYMLINK"
  ln -s "$_CLI_TARGET" "$CLI_SYMLINK"
  say "symlinked: $CLI_SYMLINK -> $_CLI_TARGET"
}

# ---------------------------------------------------------------- enroll

cmd_enroll() {
  ENROLL_SELF=0
  ENROLL_FORCE=0
  _paths=""

  for _a in "$@"; do
    case "$_a" in
      --self)  ENROLL_SELF=1 ;;
      --force) ENROLL_FORCE=1 ;;
      -*)      warn "unknown flag: $_a" ;;
      *)       _paths="$_paths $_a" ;;
    esac
  done
  export ENROLL_FORCE

  # Default to $PWD if no paths given.
  [ -z "$_paths" ] && _paths="$PWD"

  for _raw_path in $_paths; do
    _enroll_one "$(ds_realpath "$_raw_path")"
  done
}


# _register_wrapper_repo WRAPPER_DIR REPO_PATH
# Appends REPO_PATH to WRAPPER_DIR/.clagentic-project, stamps wrapper CLAUDE.md,
# stamps wrapper .claude/settings.json so lifecycle hooks fire from wrapper CWD,
# then enrolls the repo.
_register_wrapper_repo() {
  _rwr_wrapper="$1"
  _rwr_repo="$2"
  printf '%s\n' "$_rwr_repo" >> "$_rwr_wrapper/.clagentic-project"
  _stamp_wrapper_claude_md "$_rwr_wrapper" "$_rwr_repo"
  _stamp_wrapper_settings "$_rwr_wrapper"
  _enroll_one "$_rwr_repo"
}

_enroll_one() {
  _ep="$1"
  # _ep_orig tracks the original argument so we can write .clagentic-project
  # to the wrapper directory rather than to the enrolled repo.
  _ep_orig="$_ep"

  # Verify it's a git repo. If not, offer wrapper detection (tty only) or
  # fall through to a git init offer.
  #
  # REPO SCOPING (lr-da1f28 sweep): `git -C "$_ep" rev-parse --git-dir`
  # succeeding only proves SOME ancestor of $_ep is a git repo, not that
  # $_ep itself is — `-C <dir>` changes cwd before git's own repo discovery
  # walks up the filesystem. This is the ROOT CAUSE of the same defect
  # reappearing at every consumer of the enrollment registry (list/doctor/
  # update --restamp all re-check `git -C "$_rpath" rev-parse --git-dir` on
  # values that ultimately trace back to this check): if $_ep is not a git
  # repo but an ancestor is, this check wrongly succeeds, skips the
  # nested-repo detection entirely, and enrollment proceeds treating $_ep as
  # if it were the actual repo — `_canon` (below) is set to $_ep verbatim,
  # and every later `git -C "$_canon" ...` call (hook stamping, etc.) then
  # silently operates on the wrong ancestor repo's .git too. Require the
  # resolved toplevel to actually equal $_ep before trusting it.
  _eo_git_toplevel=$(git -C "$_ep" rev-parse --show-toplevel 2>/dev/null || echo "")
  _eo_ep_canon=$(cd "$_ep" 2>/dev/null && pwd -P || printf '%s' "$_ep")
  if [ -z "$_eo_git_toplevel" ] || [ "$_eo_git_toplevel" != "$_eo_ep_canon" ]; then
    if [ -t 0 ]; then
      # Scan for nested git repos up to 3 levels deep.
      _nested_raw=$(find "$_ep" -maxdepth 3 -name .git -type d 2>/dev/null)
      _nested_count=0
      _nested_list=""
      for _ng in $_nested_raw; do
        # Strip trailing /.git to get repo path.
        _nr="${_ng%/.git}"
        _nested_count=$((_nested_count+1))
        _nested_list="$_nested_list $_nr"
      done

      if [ "$_nested_count" -gt 0 ]; then
        printf 'enroll: %s is not a git repo — found %d nested repo(s):\n' "$_ep" "$_nested_count"
        _i=0
        for _nr in $_nested_list; do
          _i=$((_i+1))
          printf '  %d) %s\n' "$_i" "$_nr"
        done

        if [ "$_nested_count" -eq 1 ]; then
          # Single nested repo: simple Y/n/q prompt.
          _single_repo=""
          for _nr in $_nested_list; do _single_repo="$_nr"; done
          printf 'Enroll it? [Y/n/q(uit)]: '
          read -r _reply || _reply=""
          [ -z "$_reply" ] && _reply="Y"
          case "$_reply" in
            q|Q)
              return 1
              ;;
            n|N)
              # Fall through to git init offer below.
              _nested_count=0
              ;;
            *)
              # Y or blank: enroll the nested repo.
              _register_wrapper_repo "$_ep_orig" "$_single_repo"
              return $?
              ;;
          esac
        else
          # Multiple nested repos: A / # / n / q prompt.
          printf 'Enroll: [A]ll / [#] pick one / [n]one (git init instead) / [q]uit: '
          read -r _reply || _reply=""
          case "$_reply" in
            q|Q)
              return 1
              ;;
            n|N)
              # Fall through to git init offer below.
              _nested_count=0
              ;;
            a|A)
              # Enroll all nested repos.
              for _nr in $_nested_list; do
                _register_wrapper_repo "$_ep_orig" "$_nr"
              done
              return 0
              ;;
            *)
              # Digit: enroll the numbered repo.
              _pick="$_reply"
              _i=0
              _found=""
              for _nr in $_nested_list; do
                _i=$((_i+1))
                if [ "$_i" = "$_pick" ]; then
                  _found="$_nr"
                fi
              done
              if [ -n "$_found" ]; then
                _register_wrapper_repo "$_ep_orig" "$_found"
                return $?
              else
                warn "enroll: invalid selection '$_reply' — skipping"
                return 1
              fi
              ;;
          esac
        fi
      fi

      # git init offer: reached when no nested repos found, or user chose n.
      printf 'enroll: no git repo found under %s.\n' "$_ep"
      printf 'Initialize a new git repo here with `git init`? [Y/n]: '
      read -r _reply || _reply=""
      [ -z "$_reply" ] && _reply="Y"
      case "$_reply" in
        n|N)
          warn "enroll: skipping — no git repo and user declined git init"
          return 1
          ;;
        *)
          git init "$_ep" || { warn "enroll: git init failed for $_ep"; return 1; }
          # Fall through: _ep is now a git repo; the check below will pass.
          ;;
      esac
    else
      # Non-tty: original behavior.
      warn "enroll: $_ep is not a git repository — skipping"
      return 1
    fi
  fi

  _canon=$(ds_realpath "$_ep")
  _home_canon=$(ds_realpath "$CLAGENTIC_LITE_HOME")

  # Snake's-head check: refuse to enroll $CLAGENTIC_LITE_HOME itself unless --self.
  if [ "$_canon" = "$_home_canon" ] && [ "$ENROLL_SELF" -ne 1 ]; then
    warn "enroll: refusing to enroll \$CLAGENTIC_LITE_HOME itself ($_canon)"
    warn "Use --self if you intentionally want the tool to gate itself."
    return 1
  fi

  # Already enrolled check.
  if [ -f "$REGISTRY" ] && grep -qxF "$_canon" "$REGISTRY" 2>/dev/null; then
    if [ "$ENROLL_FORCE" -ne 1 ]; then
      warn "enroll: $_canon is already enrolled (use --force to re-enroll)"
      return 0
    fi
  fi

  # Initialize .clagentic/lite/ DBs in the enrolled repo.
  _dot="$_canon/.clagentic/lite"
  mkdir -p "$_dot" && chmod 755 "$_dot" \
    || { warn "cannot create $_dot"; return 1; }

  # A repo-local .clagentic/config present at enroll time is NOT read on
  # this call (see docs/DESIGN.md "Trust boundary: global config vs.
  # per-repo config" — the CLI's own dispatch skips the repo-local load for
  # the `enroll` subcommand specifically, deliberately and unconditionally,
  # never mind registry state). Converting that into a visible, one-time
  # notice rather than a silent surprise: fires on every `enroll` call
  # (including a --force re-enroll, since the CLI-dispatch skip applies to
  # the subcommand itself, not to first-enroll-only), never on doctor,
  # update, or any other subcommand, which all load it normally once the
  # repo is a registry member.
  if [ -f "$_canon/.clagentic/config" ]; then
    say "note: $_canon/.clagentic/config exists but is not read during enroll (see docs/DESIGN.md)"
  fi

  CLAGENTIC_PROJECT_ROOT="$_canon" "$CLAGENTIC_LITE_HOME/scripts/memory.sh" init
  # lr-bdddcf: gates.sh is invoked as a script here, never sourced. An
  # ambiently exported CLAGENTIC_GATES_SOURCE_ONLY (e.g. from a developer's
  # shell profile) would otherwise reach gates.sh's own fail-closed check
  # and abort enroll's init step instead of running it.
  unset CLAGENTIC_GATES_SOURCE_ONLY CLAGENTIC_GATES_DELIBERATE_SOURCE
  CLAGENTIC_PROJECT_ROOT="$_canon" "$CLAGENTIC_LITE_HOME/scripts/gates.sh" init

  # Stamp hook shims.
  _git_dir=$(git -C "$_canon" rev-parse --git-dir)
  # git rev-parse --git-dir may return a relative path when inside the repo.
  case "$_git_dir" in
    /*) _hooks_dir="$_git_dir/hooks" ;;
    *)  _hooks_dir="$_canon/$_git_dir/hooks" ;;
  esac
  mkdir -p "$_hooks_dir" || true

  stamp_shim pre-commit "$_hooks_dir" || true
  stamp_shim pre-push   "$_hooks_dir" || true

  # Stamp Claude Code integration (.claude/ inside the enrolled repo).
  # settings.json: absolute paths so hook scripts resolve back to CLAGENTIC_LITE_HOME.
  # commands/: symlink — pure markdown, no path traversal, stays in sync
  # automatically when the tool updates.
  # agents and skills: installed globally via the clagentic-lite plugin; no per-repo
  # files needed.
  _claude_settings_template="$SHARE_DIR/hook-shims/claude-settings.template"
  if [ -f "$_claude_settings_template" ]; then
    _claude_dir="$_canon/.claude"
    mkdir -p "$_claude_dir" || { warn "cannot create $_claude_dir"; }

    # Generate settings.json with absolute hook paths substituted in.
    _cs_target="$_claude_dir/settings.json"
    if [ -f "$_cs_target" ] && ! grep -q 'managed-by: clagentic' "$_cs_target" 2>/dev/null; then
      if [ "${ENROLL_FORCE:-0}" = "1" ]; then
        warn "overwriting existing non-clagentic .claude/settings.json (--force)"
      else
        warn "existing .claude/settings.json in $_canon is not clagentic-managed — skipping Claude Code wiring (use --force to overwrite)"
        _claude_dir=""
      fi
    fi

    if [ -n "$_claude_dir" ]; then
      _stamp_claude_settings "$_claude_settings_template" "$_cs_target"

      # Symlink commands/ — markdown only, no path traversal.
      ln -sfn "$CLAGENTIC_LITE_HOME/.claude/commands" "$_claude_dir/commands"

      # Skills (/infosec-rt, /eng-consult) are installed globally via the
      # clagentic-lite plugin (claude plugin install, run during init).
      # No per-repo symlink needed — Claude Code discovers them from the plugin.

      # Agent files are installed globally via the clagentic-lite plugin
      # (claude plugin install, run during init). No per-repo copy needed.

      say "wired Claude Code hooks: $_claude_dir"
    fi
  else
    warn "claude-settings.template missing — skipping Claude Code hook wiring"
  fi

  # Stamp CLAUDE.md in the enrolled repo root with a thin enrollment notice.
  # The notice is unconditionally true: it describes enrollment support without
  # binding rules that assume clagentic-lite is installed for all teammates.
  # CLAUDE.md is NOT gitignored — it's a legitimate project file the user may
  # extend. The notice block is ~5 lines; user content below it is preserved on
  # restamp (see _restamp_repo_artifacts).
  _claude_md_template="$SHARE_DIR/hook-shims/CLAUDE.md.template"
  _claude_md_target="$_canon/CLAUDE.md"
  if [ -f "$_claude_md_template" ]; then
    if [ -f "$_claude_md_target" ]; then
      if grep -q 'managed-by: clagentic' "$_claude_md_target" 2>/dev/null; then
        # Already clagentic-managed — splice in the new notice block while
        # preserving any project-owned content below the sentinel.  This is
        # the same path update uses; a bare cp would destroy the user's block.
        _restamp_notice_block "$_claude_md_target" "$_claude_md_template"
        say "re-stamped CLAUDE.md (preserved project-owned content): $_claude_md_target"
      elif [ "${ENROLL_FORCE:-0}" = "1" ]; then
        # Not clagentic-managed + --force: full overwrite.  No project-owned
        # block to preserve (clagentic never wrote one here before).
        warn "overwriting existing non-clagentic CLAUDE.md (--force)"
        cp "$_claude_md_template" "$_claude_md_target"
        say "stamped CLAUDE.md: $_claude_md_target"
      else
        warn "existing CLAUDE.md in $_canon is not clagentic-managed — skipping (use --force to overwrite)"
      fi
    else
      # No existing file — plain stamp.
      cp "$_claude_md_template" "$_claude_md_target"
      say "stamped CLAUDE.md: $_claude_md_target"
    fi
  else
    warn "CLAUDE.md.template missing — skipping enrollment notice stamp"
  fi

  # Stamp .clagentic/lite/builder-contract.md — full builder rules, agent table,
  # slash commands, hooks, and gate reference. Gitignored (local machine only).
  # Injected by session-start.sh at session open so Claude Code gets the full
  # contract every session without it living in a committed file.
  _contract_template="$SHARE_DIR/hook-shims/builder-contract.template"
  _contract_target="$_canon/.clagentic/lite/builder-contract.md"
  _default_branch="${CLAGENTIC_DEFAULT_BRANCH:-main}"
  if [ -f "$_contract_template" ]; then
    mkdir -p "$_canon/.clagentic/lite" 2>/dev/null || true
    sed -e "s|__CLAGENTIC_LITE_HOME__|$CLAGENTIC_LITE_HOME|g" \
        -e "s|__CLAGENTIC_DEFAULT_BRANCH__|$_default_branch|g" \
        "$_contract_template" > "$_contract_target"
    say "stamped builder contract: $_contract_target"
  else
    warn "builder-contract.template missing — skipping builder contract stamp"
  fi

  # Add .claude/ to .gitignore (fully tool-generated, never committed).
  # For .clagentic/, ignore the entire lite/ subdir (all ephemeral tool-state).
  # Governance files (adversarial-acks.json, osv-ignore, accepted-risks.md, config)
  # live at .clagentic/ top level and are unaffected by the .clagentic/lite/ blanket.
  # Each pattern is idempotent: skipped if already present.
  _gitignore="$_canon/.gitignore"
  # Single blanket pattern for all ephemeral state under .clagentic/lite/.
  _clagentic_ignores='.clagentic/lite/'
  if [ ! -f "$_gitignore" ]; then
    printf '.claude/\n' > "$_gitignore"
    printf '%s\n' "$_clagentic_ignores" >> "$_gitignore"
    say "created $_gitignore with .claude/ and .clagentic/lite/ patterns"
  else
    if ! grep -qxF '.claude/' "$_gitignore" 2>/dev/null; then
      printf '.claude/\n' >> "$_gitignore"
      say "added .claude/ to $_gitignore"
    fi
    # If a prior enrollment wrote the blanket .clagentic/ line, note it so the
    # user knows governance files may be untrackable under that broad pattern.
    if grep -qxF '.clagentic/' "$_gitignore" 2>/dev/null; then
      say "note: $_gitignore has blanket .clagentic/ — governance files (adversarial-acks.json, osv-ignore, accepted-risks.md) may be untrackable; consider replacing with .clagentic/lite/"
    else
      if ! grep -qxF "$_clagentic_ignores" "$_gitignore" 2>/dev/null; then
        printf '%s\n' "$_clagentic_ignores" >> "$_gitignore"
        say "added .clagentic/lite/ to $_gitignore"
      fi
    fi
  fi
  # Migration warning: detect tracked .clagentic/lite/ files that should be ephemeral.
  # These cause perpetual dirty state and polluted commits.
  _tracked_ephemeral=""
  if git -C "$_canon" rev-parse --git-dir >/dev/null 2>&1; then
    _tracked_ephemeral=$(git -C "$_canon" ls-files \
      '.clagentic/lite/audit.db' '.clagentic/lite/memory.db' \
      '.clagentic/lite/builder-contract.md' '.clagentic/lite/last-review.json' \
      '.clagentic/lite/last-adversarial.md' '.clagentic/lite/last-merge-gate.json' \
      '.clagentic/lite/gate-summary.json' '.clagentic/lite/stop-summarize.lock' \
      '.clagentic/lite/report.html' 2>/dev/null || true)
  fi
  if [ -n "$_tracked_ephemeral" ]; then
    warn "migration needed: the following ephemeral .clagentic/lite/ files are tracked in git and will cause perpetual dirty state:"
    printf '%s\n' "$_tracked_ephemeral" | while IFS= read -r _tf; do
      printf '    %s\n' "$_tf" >&2
    done
    warn "run: git rm --cached $(printf '%s\n' "$_tracked_ephemeral" | tr '\n' ' ') && git commit -m 'chore: untrack ephemeral .clagentic/lite/ files'"
  fi

  # Register.
  _reg_dir="$(dirname "$REGISTRY")"
  mkdir -p "$_reg_dir" || true

  # Remove any stale entry for this path before appending.
  if [ -f "$REGISTRY" ]; then
    grep -vxF "$_canon" "$REGISTRY" > "$REGISTRY.tmp" 2>/dev/null || true
    mv "$REGISTRY.tmp" "$REGISTRY"
  fi
  printf '%s\n' "$_canon" >> "$REGISTRY"

  say "enrolled: $_canon"
}

# ---------------------------------------------------------------- unenroll

cmd_unenroll() {
  UNENROLL_PURGE=0
  _path="$PWD"

  for _a in "$@"; do
    case "$_a" in
      --purge) UNENROLL_PURGE=1 ;;
      -*)      warn "unknown flag: $_a" ;;
      *)       _path="$_a" ;;
    esac
  done

  _canon=$(ds_realpath "$_path")

  if ! git -C "$_canon" rev-parse --git-dir >/dev/null 2>&1; then
    warn "unenroll: $_canon is not a git repository"
    return 1
  fi

  _git_dir=$(git -C "$_canon" rev-parse --git-dir)
  case "$_git_dir" in
    /*) _hooks_dir="$_git_dir/hooks" ;;
    *)  _hooks_dir="$_canon/$_git_dir/hooks" ;;
  esac

  # Remove only clagentic-owned hooks.
  for _hook in pre-commit pre-push; do
    _hf="$_hooks_dir/$_hook"
    if [ -f "$_hf" ]; then
      if grep -q 'managed-by: clagentic' "$_hf" 2>/dev/null; then
        rm -f "$_hf"
        say "removed hook: $_hf"
      else
        say "skipping non-clagentic hook: $_hf"
      fi
    fi
  done

  # Remove clagentic-owned Claude Code integration (.claude/).
  _cs_file="$_canon/.claude/settings.json"
  if [ -f "$_cs_file" ] && grep -q 'managed-by: clagentic' "$_cs_file" 2>/dev/null; then
    rm -f "$_cs_file"
    # Remove symlink we own for commands/.
    rm -f "$_canon/.claude/commands"
    # Agents and skills are installed globally via the plugin — no per-repo files to remove.
    # Remove .claude/ dir only if now empty.
    rmdir "$_canon/.claude" 2>/dev/null || true
    say "removed Claude Code wiring: $_canon/.claude"
  fi

  # Remove clagentic-managed CLAUDE.md.
  _cm_file="$_canon/CLAUDE.md"
  if [ -f "$_cm_file" ] && grep -q 'managed-by: clagentic' "$_cm_file" 2>/dev/null; then
    rm -f "$_cm_file"
    say "removed CLAUDE.md: $_cm_file"
  fi

  # Deregister.
  if [ -f "$REGISTRY" ]; then
    grep -vxF "$_canon" "$REGISTRY" > "$REGISTRY.tmp" 2>/dev/null || true
    mv "$REGISTRY.tmp" "$REGISTRY"
  fi

  # Purge .clagentic/lite/ if requested.
  # Note: .clagentic/lite/ contains audit.db, memory.db, and builder-contract.md —
  # all local machine state (gitignored). The --purge flag removes this data.
  # Without --purge, .clagentic/lite/ is left in place (data is preserved).
  # Governance files at .clagentic/ top level (adversarial-acks.json, osv-ignore,
  # accepted-risks.md, config) are never removed by unenroll.
  if [ "$UNENROLL_PURGE" -eq 1 ]; then
    _dot="$_canon/.clagentic/lite"
    if [ -d "$_dot" ]; then
      rm -rf -- "$_dot"
      say "purged: $_dot"
    fi
  else
    say "note: .clagentic/lite/ left in place (use --purge to remove audit.db, memory.db, and builder-contract.md)"
  fi

  say "unenrolled: $_canon"
}

# ---------------------------------------------------------------- list

cmd_list() {
  if [ ! -f "$REGISTRY" ]; then
    say "no enrolled repos (registry not found at $REGISTRY)"
    return 0
  fi

  _HR='------------------------------------------------------------------------------------------'
  printf '%-50s  %-24s  %s\n' "PATH" "LAST GATE RUN" "STATUS"
  printf '%s\n' "$_HR"

  while IFS= read -r _rpath; do
    [ -z "$_rpath" ] && continue

    # Determine status.
    _status="ok"
    if [ ! -d "$_rpath" ]; then
      _status="stale"
    elif ! git -C "$_rpath" rev-parse --git-dir >/dev/null 2>&1; then
      _status="not-a-repo"
    else
      _git_dir=$(git -C "$_rpath" rev-parse --git-dir)
      case "$_git_dir" in
        /*) _hooks_dir="$_git_dir/hooks" ;;
        *)  _hooks_dir="$_rpath/$_git_dir/hooks" ;;
      esac
      # Check both shims are present and clagentic-owned.
      for _hook in pre-commit pre-push; do
        _hf="$_hooks_dir/$_hook"
        if [ ! -f "$_hf" ]; then
          _status="hooks missing"
        elif ! grep -q 'managed-by: clagentic' "$_hf" 2>/dev/null; then
          _status="hooks replaced"
        fi
      done
      # Check tool still exists at the baked-in path.
      if [ -f "$_hooks_dir/pre-commit" ]; then
        _baked=$(grep -E '__CLAGENTIC_LITE_HOME__|CLAGENTIC_LITE_HOME:=' "$_hooks_dir/pre-commit" 2>/dev/null | head -1)
        if [ -z "$_baked" ] && ! grep -q "$CLAGENTIC_LITE_HOME" "$_hooks_dir/pre-commit" 2>/dev/null; then
          _status="tool missing"
        fi
      fi
    fi

    # Last gate run from audit.db.
    _db="$_rpath/.clagentic/lite/audit.db"
    _last_run=""
    if [ -f "$_db" ]; then
      _last_run=$(sqlite3 "$_db" "SELECT MAX(ts) FROM gate_runs;" 2>/dev/null || true)
    fi
    [ -z "$_last_run" ] && _last_run="(never)"

    printf '%-50s  %-24s  %s\n' "$_rpath" "$_last_run" "$_status"
  done < "$REGISTRY"
}

# ---------------------------------------------------------------- doctor

cmd_doctor() {
  _ok=0; _fail=0
  _ok()   { printf '  OK   %s\n' "$*"; _ok=$((_ok+1)); }
  _fail() { printf '  FAIL %s\n' "$*" 1>&2; _fail=$((_fail+1)); }

  printf '\n== clagentic-lite doctor ==\n\n'

  # 1. CLAGENTIC_LITE_HOME exists and is a valid checkout.
  if [ -f "$CLAGENTIC_LITE_HOME/scripts/gates.sh" ]; then
    _ok "CLAGENTIC_LITE_HOME=$CLAGENTIC_LITE_HOME (valid checkout)"
  else
    _fail "CLAGENTIC_LITE_HOME=$CLAGENTIC_LITE_HOME (gates.sh missing — is this a clagentic-lite checkout?)"
  fi

  # 2. Symlink correct.
  if [ -L "$CLI_SYMLINK" ]; then
    _sym_target=$(readlink "$CLI_SYMLINK" 2>/dev/null || true)
    if [ "$_sym_target" = "$CLAGENTIC_LITE_HOME/bin/clagentic-lite" ]; then
      _ok "$CLI_SYMLINK -> $CLAGENTIC_LITE_HOME/bin/clagentic-lite"
    else
      _fail "$CLI_SYMLINK points to $_sym_target (expected $CLAGENTIC_LITE_HOME/bin/clagentic-lite)"
    fi
  elif [ -e "$CLI_SYMLINK" ]; then
    _fail "$CLI_SYMLINK exists but is not a symlink"
  else
    _fail "$CLI_SYMLINK missing — run \`clagentic-lite init\`"
  fi

  # 2b. Claude Code lifecycle hooks materialized (lr-57db23). This is the
  # ONE copy every enrolled repo's settings.json calls back into by absolute
  # path — missing or stale here means every enrolled repo's hooks fail
  # closed or run stale logic, not just this checkout's own dogfood wiring.
  for _dh_name in $CLAGENTIC_HOOK_SCRIPTS; do
    _dh_file="$CLAGENTIC_LITE_HOME/.claude/hooks/$_dh_name"
    if [ ! -f "$_dh_file" ]; then
      _fail "$_dh_file missing — run \`clagentic-lite init\` or \`clagentic-lite update\` to materialize"
    else
      _dh_ver=$(claude_hooks_version "$_dh_file")
      if [ "$_dh_ver" != "$CLAUDE_HOOKS_VERSION" ]; then
        _fail "$_dh_file version $_dh_ver (current: $CLAUDE_HOOKS_VERSION) — run \`clagentic-lite update\`"
      else
        _ok "$_dh_file version $CLAUDE_HOOKS_VERSION OK"
      fi
    fi
  done

  # 3. LOCAL_BIN on PATH.
  case ":$PATH:" in
    *":$LOCAL_BIN:"*) _ok "$LOCAL_BIN is on \$PATH" ;;
    *) _fail "$LOCAL_BIN is NOT on \$PATH — add: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
  esac

  # 4. Required prereqs.
  printf '\nprerequisites:\n'
  for _tool in sqlite3 git; do
    if command -v "$_tool" >/dev/null 2>&1; then
      _ok "$_tool found"
    else
      _fail "$_tool missing"
    fi
  done
  if command -v jq >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; then
    _ok "JSON validator (jq or python3) found"
  else
    _fail "JSON validator missing (need jq or python3)"
  fi
  if command -v python3 >/dev/null 2>&1; then
    _ok "python3 found (W-002 path normalization: full)"
  else
    printf "  WARN python3 not found — W-002 uses POSIX fallback normalization (symlink targets not resolved)\n"
  fi

  # 5. Security tool status (advisory — missing is a warn, not a fail).
  # Tool names come from CLAGENTIC_SECURITY_TOOLS (top of file), same source
  # _run_prereq_checks uses — they cannot drift apart.
  printf '\nsecurity tools:\n'
  for _stool in $CLAGENTIC_SECURITY_TOOLS; do
    if command -v "$_stool" >/dev/null 2>&1; then
      _ok "$_stool found"
    else
      printf '  WARN %s not installed (security gate will block unless ALLOW_MISSING set)\n' "$_stool"
    fi
  done

  # 5a. gitleaks version floor (lr-170808 scope item 4). `gitleaks git`
  # (feature-branch history scanning — scripts/gates.sh cmd_secrets,
  # docs/GATES.md "4a. Secrets") landed in gitleaks 8.18; below that floor,
  # cmd_secrets falls back to a staged-only scan that is a documented no-op
  # on a clean index (a Builder commit always leaves the index clean), so
  # committed-but-not-staged secrets on a feature branch go unscanned on
  # EVERY run, silently, until the operator happens to have unstaged work.
  # This is a STANDING COVERAGE GAP, not a per-run surprise — report it once,
  # here, rather than leaving it to be rediscovered as an intermittent-looking
  # gate behavior. GITLEAKS_MIN_VERSION mirrors the .gitleaks.toml header
  # comment's own floor (8.25, required for [[allowlists]] array-of-tables +
  # condition = "AND" semantics) as a SEPARATE, higher bar from the 8.18
  # history-scan floor — both are reported, since they gate different
  # capabilities and a repo can be below one but not the other.
  printf '\ngitleaks version:\n'
  GITLEAKS_HISTORY_MIN_VERSION="8.18.0"
  GITLEAKS_ALLOWLIST_MIN_VERSION="8.25.0"
  if command -v gitleaks >/dev/null 2>&1; then
    _gl_ver_raw=$(gitleaks version 2>/dev/null || true)
    _gl_ver=$(printf '%s' "$_gl_ver_raw" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    if [ -z "$_gl_ver" ]; then
      printf '  INFO gitleaks: on PATH but version unparseable (output: %s)\n' \
        "$(printf '%s' "$_gl_ver_raw" | head -1 | cut -c1-80)"
      printf '       Cannot confirm feature-branch history scanning (requires >= %s) or [[allowlists]]/condition="AND" support (requires >= %s).\n' \
        "$GITLEAKS_HISTORY_MIN_VERSION" "$GITLEAKS_ALLOWLIST_MIN_VERSION"
    else
      _gl_history_ok=0
      _gl_allowlist_ok=0
      if sort -V /dev/null 2>/dev/null; then
        _gl_lowest_h=$(printf '%s\n%s\n' "$_gl_ver" "$GITLEAKS_HISTORY_MIN_VERSION" | sort -V | head -1)
        [ "$_gl_lowest_h" = "$GITLEAKS_HISTORY_MIN_VERSION" ] && _gl_history_ok=1
        _gl_lowest_a=$(printf '%s\n%s\n' "$_gl_ver" "$GITLEAKS_ALLOWLIST_MIN_VERSION" | sort -V | head -1)
        [ "$_gl_lowest_a" = "$GITLEAKS_ALLOWLIST_MIN_VERSION" ] && _gl_allowlist_ok=1
      else
        # Arithmetic fallback, same shape as the codex version check above.
        _gvi_maj=$(printf '%s' "$_gl_ver" | cut -d. -f1 | tr -cd '0-9'); _gvi_maj="${_gvi_maj:-0}"
        _gvi_min=$(printf '%s' "$_gl_ver" | cut -d. -f2 | tr -cd '0-9'); _gvi_min="${_gvi_min:-0}"
        _gvi_pat=$(printf '%s' "$_gl_ver" | cut -d. -f3 | tr -cd '0-9'); _gvi_pat="${_gvi_pat:-0}"
        for _gvm_pair in "$GITLEAKS_HISTORY_MIN_VERSION:_gl_history_ok" "$GITLEAKS_ALLOWLIST_MIN_VERSION:_gl_allowlist_ok"; do
          _gvm_ver="${_gvm_pair%%:*}"
          _gvm_maj=$(printf '%s' "$_gvm_ver" | cut -d. -f1 | tr -cd '0-9'); _gvm_maj="${_gvm_maj:-0}"
          _gvm_min=$(printf '%s' "$_gvm_ver" | cut -d. -f2 | tr -cd '0-9'); _gvm_min="${_gvm_min:-0}"
          _gvm_pat=$(printf '%s' "$_gvm_ver" | cut -d. -f3 | tr -cd '0-9'); _gvm_pat="${_gvm_pat:-0}"
          _gvm_ok=0
          if   [ "$_gvi_maj" -gt "$_gvm_maj" ]; then _gvm_ok=1
          elif [ "$_gvi_maj" -lt "$_gvm_maj" ]; then _gvm_ok=0
          elif [ "$_gvi_min" -gt "$_gvm_min" ]; then _gvm_ok=1
          elif [ "$_gvi_min" -lt "$_gvm_min" ]; then _gvm_ok=0
          elif [ "$_gvi_pat" -ge "$_gvm_pat" ]; then _gvm_ok=1
          fi
          case "$_gvm_pair" in *_gl_history_ok) _gl_history_ok=$_gvm_ok ;; *_gl_allowlist_ok) _gl_allowlist_ok=$_gvm_ok ;; esac
        done
      fi
      if [ "$_gl_history_ok" -eq 1 ]; then
        _ok "gitleaks $_gl_ver (>= $GITLEAKS_HISTORY_MIN_VERSION — feature-branch history scanning available)"
      else
        printf '  WARN gitleaks %s < %s — feature-branch history scanning is UNAVAILABLE.\n' "$_gl_ver" "$GITLEAKS_HISTORY_MIN_VERSION"
        printf '       On a feature branch with a clean index (the normal state after a commit), the staged-only scan this version falls back to is a no-op — committed secrets go unscanned on every such run, not just intermittently. This is the version apt installs on Ubuntu 24.04 as of this writing.\n'
        printf '       Upgrade: https://github.com/gitleaks/gitleaks#installing\n'
      fi
      if [ "$_gl_allowlist_ok" -ne 1 ]; then
        printf '  WARN gitleaks %s < %s — [[allowlists]] (array-of-tables) and condition = "AND" are misread by older gitleaks (default OR semantics), which can let a real secret slip past a path-scoped allowlist meant only for known fixtures. See .gitleaks.toml'"'"'s own header comment.\n' \
          "$_gl_ver" "$GITLEAKS_ALLOWLIST_MIN_VERSION"
      fi
    fi
  else
    printf '  INFO gitleaks: not on PATH (minimum for history scanning: %s; for AND-semantics allowlists: %s)\n' \
      "$GITLEAKS_HISTORY_MIN_VERSION" "$GITLEAKS_ALLOWLIST_MIN_VERSION"
  fi

  # 5b. sha256 soft dependency (used by review-merge.sh for finding dedup keys).
  # Warn-only: the identity fallback works but dedup keys become less robust.
  printf '\nsha256 (soft dep, chunked-review dedup):\n'
  if command -v sha256sum >/dev/null 2>&1; then
    _ok "sha256sum found (GNU coreutils — preferred)"
  elif command -v shasum >/dev/null 2>&1; then
    _ok "shasum found (BSD/macOS — will use shasum -a 256)"
  else
    printf '  WARN sha256sum and shasum both missing — chunked-review dedup will use identity fallback\n'
    printf '       Install: brew install coreutils (macOS) | usually pre-installed on Linux (coreutils)\n'
    printf '       The gate still works but findings with different whitespace may not deduplicate.\n'
  fi

  # 6. Registry + enrolled repos.
  printf '\nenrolled repos:\n'
  # lr-684947, concern 4 -- fan-out visibility: count how many enrolled
  # repos hold a stamped credential (ANTHROPIC_AUTH_TOKEN or
  # AWS_BEARER_TOKEN_BEDROCK present and non-empty in .claude/settings.json),
  # separately from apiKeyHelper (a stamped helper command is NOT a
  # credential copy -- see _render_api_key_helper_command's doc comment).
  # Unbounded N by design (agnostic-tool hardening) -- no assumption this
  # host has few enrolled repos.
  _dc_token_count=0
  _dc_helper_count=0
  if [ ! -f "$REGISTRY" ]; then
    printf '  (no registry at %s)\n' "$REGISTRY"
  else
    while IFS= read -r _rpath; do
      [ -z "$_rpath" ] && continue
      if [ ! -d "$_rpath" ]; then
        _fail "registered repo no longer exists: $_rpath"
        continue
      fi
      _git_dir=$(git -C "$_rpath" rev-parse --git-dir 2>/dev/null || true)
      if [ -z "$_git_dir" ]; then
        _fail "$_rpath: not a git repo"
        continue
      fi
      _dc_cs="$_rpath/.claude/settings.json"
      if [ -f "$_dc_cs" ]; then
        if grep -q '"apiKeyHelper"' "$_dc_cs" 2>/dev/null; then
          _dc_helper_count=$((_dc_helper_count+1))
        elif grep -qE '"(ANTHROPIC_AUTH_TOKEN|AWS_BEARER_TOKEN_BEDROCK)": "[^"]' "$_dc_cs" 2>/dev/null; then
          _dc_token_count=$((_dc_token_count+1))
        fi
      fi
      case "$_git_dir" in
        /*) _hd="$_git_dir/hooks" ;;
        *)  _hd="$_rpath/$_git_dir/hooks" ;;
      esac
      for _hook in pre-commit pre-push; do
        _hf="$_hd/$_hook"
        if [ ! -f "$_hf" ]; then
          _fail "$_rpath: .git/hooks/$_hook missing"
        elif ! grep -q 'managed-by: clagentic' "$_hf" 2>/dev/null; then
          _fail "$_rpath: .git/hooks/$_hook not clagentic-managed"
        elif ! grep -q "$CLAGENTIC_LITE_HOME" "$_hf" 2>/dev/null; then
          _fail "$_rpath: .git/hooks/$_hook points to different CLAGENTIC_LITE_HOME (run \`clagentic-lite update\`)"
        else
          _ok "$_rpath: .git/hooks/$_hook OK"
        fi
      done
      # Check CLAUDE.md enrollment notice in enrolled repo.
      _cm_file="$_rpath/CLAUDE.md"
      if [ ! -f "$_cm_file" ]; then
        printf '  WARN  %s: CLAUDE.md missing (run `clagentic-lite enroll --force`)\n' "$_rpath"
      elif ! grep -q 'managed-by: clagentic' "$_cm_file" 2>/dev/null; then
        printf '  WARN  %s: CLAUDE.md not clagentic-managed (manual CLAUDE.md?)\n' "$_rpath"
      else
        # Check for new thin-notice marker first; fall back to legacy marker.
        _repo_notice_ver=$(claude_notice_version "$_cm_file")
        _repo_old_ver=$(claude_md_version "$_cm_file")
        if [ -n "$_repo_notice_ver" ]; then
          if [ "$_repo_notice_ver" != "$CLAUDE_NOTICE_VERSION" ]; then
            # Notice drift is low-risk — INFO not FAIL.
            printf '  INFO  %s: CLAUDE.md notice version %s (current: %s) — run `clagentic-lite update` to refresh\n' \
              "$_rpath" "$_repo_notice_ver" "$CLAUDE_NOTICE_VERSION"
          else
            _ok "$_rpath: CLAUDE.md notice version $CLAUDE_NOTICE_VERSION OK"
          fi
        elif [ -n "$_repo_old_ver" ]; then
          # Old fat CLAUDE.md — warn; update will migrate to thin notice.
          printf '  WARN  %s: CLAUDE.md uses old format (clagentic-claude-md-version: %s) — run `clagentic-lite update` to migrate to thin notice\n' \
            "$_rpath" "$_repo_old_ver"
        else
          printf '  WARN  %s: CLAUDE.md has managed-by marker but no version tag — run `clagentic-lite update --restamp`\n' "$_rpath"
        fi
      fi
      # Check builder-contract.md (local, gitignored).
      _contract_file="$_rpath/.clagentic/lite/builder-contract.md"
      if [ ! -f "$_contract_file" ]; then
        printf '  WARN  %s: .clagentic/lite/builder-contract.md missing — sessions lack full builder context (run `clagentic-lite enroll --force`)\n' "$_rpath"
      elif ! grep -q 'managed-by: clagentic' "$_contract_file" 2>/dev/null; then
        printf '  WARN  %s: .clagentic/lite/builder-contract.md not clagentic-managed\n' "$_rpath"
      else
        _repo_contract_ver=$(claude_contract_version "$_contract_file")
        if [ "$_repo_contract_ver" != "$CLAUDE_CONTRACT_VERSION" ]; then
          # Auto-restamp contract on doctor run — it's gitignored and cheap.
          _ra_default_branch="${CLAGENTIC_DEFAULT_BRANCH:-main}"
          _ra_ct="$SHARE_DIR/hook-shims/builder-contract.template"
          if [ -f "$_ra_ct" ]; then
            mkdir -p "$_rpath/.clagentic/lite" 2>/dev/null || true
            sed -e "s|__CLAGENTIC_LITE_HOME__|$CLAGENTIC_LITE_HOME|g" \
                -e "s|__CLAGENTIC_DEFAULT_BRANCH__|$_ra_default_branch|g" \
                "$_ra_ct" > "$_contract_file"
            _ok "$_rpath: .clagentic/lite/builder-contract.md auto-restamped to $CLAUDE_CONTRACT_VERSION"
          else
            printf '  WARN  %s: .clagentic/lite/builder-contract.md version %s (current: %s) — run `clagentic-lite update`\n' \
              "$_rpath" "$_repo_contract_ver" "$CLAUDE_CONTRACT_VERSION"
          fi
        else
          _ok "$_rpath: .clagentic/lite/builder-contract.md version $CLAUDE_CONTRACT_VERSION OK"
        fi
      fi
      # Check for stale command docs removed in v1.1.0.
      for _stale_cmd in ship.md review.md; do
        _stale_path="$_rpath/.claude/commands/$_stale_cmd"
        # Commands dir is a symlink to central install — stale docs only exist
        # when the symlink target is an old checkout that still has them.
        if [ -f "$_stale_path" ]; then
          _fail "$_rpath: stale command doc .claude/commands/$_stale_cmd found — run \`clagentic-lite update --restamp\`"
        fi
      done
      # Check for a rules-less .gitleaks.toml (lr-170808 advisory item).
      # gates.sh's own gate (_gitleaks_config_declares_rules, scripts/gates.sh)
      # now BLOCKS this at scan time — that is the correct, already-shipped
      # fix. This check exists so an operator sees the condition on a routine
      # `doctor` run, BEFORE it surfaces as a scan-time block on their next
      # push. Mirrors gates.sh's own detection contract (a `[[rules]]` table
      # header, or an `[extend]` block containing `useDefault = true`) with
      # the same anchored-regex heuristic gates.sh uses when python3 is
      # unavailable — sufficient here since this is advisory (WARN), not a
      # gate: a false WARN costs a re-read of a config file, not a wrongly
      # granted pass. No config file at all is unaffected (gitleaks runs
      # with its full built-in ruleset) and is intentionally not warned on.
      _gl_cfg="$_rpath/.gitleaks.toml"
      if [ -f "$_gl_cfg" ]; then
        _gl_has_rules=0
        if grep -qE '^[[:space:]]*\[\[rules\]\][[:space:]]*$' "$_gl_cfg" 2>/dev/null; then
          _gl_has_rules=1
        elif grep -qE '^[[:space:]]*\[extend\][[:space:]]*(#.*)?$' "$_gl_cfg" 2>/dev/null \
             && grep -qE '^[[:space:]]*useDefault[[:space:]]*=[[:space:]]*true[[:space:]]*(#.*)?$' "$_gl_cfg" 2>/dev/null; then
          _gl_has_rules=1
        fi
        if [ "$_gl_has_rules" -eq 1 ]; then
          _ok "$_rpath: .gitleaks.toml declares rules or extends the default ruleset"
        else
          printf '  WARN  %s: .gitleaks.toml defines no [[rules]] and has no [extend] useDefault = true.\n' "$_rpath"
          printf '        gitleaks --config REPLACES the built-in ruleset, so this configuration currently detects nothing — the secrets gate will now BLOCK on your next scan instead of silently passing.\n'
          printf '        Fix: add [extend] / useDefault = true to keep the built-in rules, or declare your own [[rules]].\n'
        fi
      fi
    done < "$REGISTRY"
    printf '  router token/credential fan-out: %s enrolled repo(s) hold a stamped literal credential, %s hold an apiKeyHelper (no literal copy)\n' \
      "$_dc_token_count" "$_dc_helper_count"
  fi


  # 7. Wrapper .clagentic-project pointer files
  printf '\nwrapper .clagentic-project pointers:\n'
  _wrapper_found=0
  if [ -f "$REGISTRY" ]; then
    while IFS= read -r _rpath; do
      [ -z "$_rpath" ] && continue
      _parent=$(dirname "$_rpath")
      _ptr="$_parent/.clagentic-project"
      [ -f "$_ptr" ] || continue
      _wrapper_found=1
      printf '  checking %s\n' "$_ptr"
      while IFS= read -r _ppath; do
        [ -z "$_ppath" ] && continue
        if [ ! -d "$_ppath" ]; then
          _fail "stale pointer in $_ptr: '$_ppath' no longer exists"
        elif ! git -C "$_ppath" rev-parse --git-dir >/dev/null 2>&1; then
          _fail "stale pointer in $_ptr: '$_ppath' is not a git repo"
        elif ! grep -qxF "$_ppath" "$REGISTRY" 2>/dev/null; then
          printf '  WARN  pointer entry %s is not in registry (re-run enroll?)\n' "$_ppath"
        else
          _ok "wrapper pointer: $_ppath"
        fi
      done < "$_ptr"
    done < "$REGISTRY"
  fi
  [ "$_wrapper_found" -eq 0 ] && printf '  (no wrapper .clagentic-project files found)\n'

  # 8a. LLM CLI version detection — non-blocking; info/warn only.
  # Shows installed codex and claude versions so CLI drift is visible before
  # a gate run surfaces it as a cryptic step-failed. Uses the same
  # CODEX_MIN_VERSION constant that invoke_codex uses for flag-set selection.
  # Not a FAIL: missing CLIs are caught in auth probes below.
  printf '\nLLM CLI versions:\n'
  # Load CODEX_MIN_VERSION from llm-client.sh without executing it as a subprocess.
  # The constant is defined near the top of that file; grep it out directly so
  # doctor and invoke_codex share the same value without duplication.
  _SCRIPTS_DIR="$CLAGENTIC_LITE_HOME/scripts"
  _codex_min=$(grep -E '^CODEX_MIN_VERSION=' "$_SCRIPTS_DIR/llm-client.sh" 2>/dev/null \
    | head -1 | sed 's/CODEX_MIN_VERSION="\{0,1\}\([^"]*\)"\{0,1\}/\1/')
  [ -z "$_codex_min" ] && _codex_min="(unknown)"
  if command -v codex >/dev/null 2>&1; then
    _codex_ver_raw=$(codex --version 2>/dev/null || true)
    _codex_ver=$(printf '%s' "$_codex_ver_raw" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    if [ -z "$_codex_ver" ]; then
      printf '  INFO codex: on PATH but version unparseable (output: %s)\n' \
        "$(printf '%s' "$_codex_ver_raw" | head -1 | cut -c1-80)"
      printf '       Minimum required: %s — will use minimal codex exec form\n' "$_codex_min"
    else
      # Compare against CODEX_MIN_VERSION using the same sort -V approach as version_ge.
      _codex_ok=0
      if sort -V /dev/null 2>/dev/null; then
        _lowest=$(printf '%s\n%s\n' "$_codex_ver" "$_codex_min" | sort -V | head -1)
        [ "$_lowest" = "$_codex_min" ] && _codex_ok=1
      else
        # Arithmetic fallback: simple integer comparison on MAJOR.MINOR.PATCH.
        # Strip non-numeric suffixes (pre-release tags) to avoid arithmetic errors,
        # consistent with the version_ge() helper in llm-client.sh.
        _ci_maj=$(printf '%s' "$_codex_ver" | cut -d. -f1 | tr -cd '0-9'); _ci_maj="${_ci_maj:-0}"
        _ci_min=$(printf '%s' "$_codex_ver" | cut -d. -f2 | tr -cd '0-9'); _ci_min="${_ci_min:-0}"
        _ci_pat=$(printf '%s' "$_codex_ver" | cut -d. -f3 | tr -cd '0-9'); _ci_pat="${_ci_pat:-0}"
        _cm_maj=$(printf '%s' "$_codex_min" | cut -d. -f1 | tr -cd '0-9'); _cm_maj="${_cm_maj:-0}"
        _cm_min=$(printf '%s' "$_codex_min" | cut -d. -f2 | tr -cd '0-9'); _cm_min="${_cm_min:-0}"
        _cm_pat=$(printf '%s' "$_codex_min" | cut -d. -f3 | tr -cd '0-9'); _cm_pat="${_cm_pat:-0}"
        if   [ "$_ci_maj" -gt "$_cm_maj" ]; then _codex_ok=1
        elif [ "$_ci_maj" -lt "$_cm_maj" ]; then _codex_ok=0
        elif [ "$_ci_min" -gt "$_cm_min" ]; then _codex_ok=1
        elif [ "$_ci_min" -lt "$_cm_min" ]; then _codex_ok=0
        elif [ "$_ci_pat" -ge "$_cm_pat" ]; then _codex_ok=1
        fi
      fi
      if [ "$_codex_ok" -eq 1 ]; then
        printf '  INFO codex %s (>= required %s — full flag set enabled)\n' "$_codex_ver" "$_codex_min"
      else
        printf '  WARN codex %s < required %s — minimal codex exec form will be used; flag-set mismatch step-fails chain\n' \
          "$_codex_ver" "$_codex_min"
        printf '       Upgrade codex to >= %s to restore full flag support.\n' "$_codex_min"
      fi
    fi
  else
    printf '  INFO codex: not on PATH (minimum required: %s)\n' "$_codex_min"
  fi
  if command -v claude >/dev/null 2>&1; then
    _claude_ver_raw=$(claude --version 2>/dev/null || true)
    _claude_ver=$(printf '%s' "$_claude_ver_raw" | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
    if [ -n "$_claude_ver" ]; then
      printf '  INFO claude %s (on PATH)\n' "$_claude_ver"
    else
      printf '  INFO claude: on PATH (version: %s)\n' \
        "$(printf '%s' "$_claude_ver_raw" | head -1 | cut -c1-60)"
    fi
  else
    printf '  INFO claude: not on PATH\n'
  fi

  # 8. LLM CLI auth probes.
  # Checks that each configured primary CLI is present AND can make a real
  # call. A CLI on PATH that fails auth silently degrades to the chain
  # fallback — this surfaces that before it matters in a gate run.
  # The probe uses a minimal prompt ("ping") with a short timeout so doctor
  # doesn't stall on a slow network. Results are WARN (not FAIL) because a
  # missing or unconfigured CLI causes degraded output, not a hard crash.
  printf '\nLLM CLI auth probes:\n'
  _llm_probe_timeout=10
  # Collect the unique set of primary CLIs across all roles.
  _probed_clis=""
  for _role_pfx in BUILDER REVIEWER AUDITOR GATE SUMMARIZER; do
    _pcmd=$(eval "printf '%s' \"\${CLAGENTIC_${_role_pfx}_CMD:-}\"")
    [ -z "$_pcmd" ] && continue
    # Skip duplicates.
    case " $_probed_clis " in
      *" $_pcmd "*) continue ;;
    esac
    _probed_clis="$_probed_clis $_pcmd"

    if ! command -v "$_pcmd" >/dev/null 2>&1; then
      printf '  WARN %s: not on PATH (roles: %s)\n' "$_pcmd" "$_role_pfx"
      continue
    fi

    # CLI is present — probe auth with a minimal call.
    _probe_out=$(mktemp -t clagentic-doctor-probe.XXXXXX)
    _probe_err=$(mktemp -t clagentic-doctor-probe-err.XXXXXX)
    _probe_ok=0
    case "$_pcmd" in
      claude)
        # claude --print "ping" — succeeds on any auth path (OAuth or API key).
        # CLAGENTIC_DISABLE_RECALL=1 avoids triggering session-start hooks.
        CLAGENTIC_DISABLE_RECALL=1 \
          $DS_TIMEOUT_CMD "$_llm_probe_timeout" claude --print "ping" \
          > "$_probe_out" 2> "$_probe_err" && _probe_ok=1 || true
        ;;
      codex)
        # Mirror the production invoke_codex path: use -o to capture the
        # response (stdout is spinner/progress noise). The prior approach
        # captured stdout, which exercises a different output channel than
        # every real gate call — causing false PASS or false FAIL.
        _probe_o=$(mktemp -t clagentic-doctor-codex-o.XXXXXX)
        $DS_TIMEOUT_CMD "$_llm_probe_timeout" codex exec --skip-git-repo-check \
          --color never -o "$_probe_o" "ping" \
          > "$_probe_err" 2>&1 && _probe_ok=1 || true
        # Strip ANSI from -o file, mirroring invoke_codex's post-processing.
        if [ -s "$_probe_o" ]; then
          sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' "$_probe_o" > "$_probe_out" 2>/dev/null \
            || cp "$_probe_o" "$_probe_out"
        fi
        rm -f "$_probe_o"
        ;;
      *)
        # Generic: try `-p ping`.
        $DS_TIMEOUT_CMD "$_llm_probe_timeout" "$_pcmd" -p "ping" \
          > "$_probe_out" 2> "$_probe_err" && _probe_ok=1 || true
        ;;
    esac

    if [ "$_probe_ok" = "1" ] && [ -s "$_probe_out" ]; then
      _ok "$_pcmd: auth probe passed"
    else
      # Strip ANSI from error output before showing it.
      _probe_hint=$(sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' "$_probe_err" 2>/dev/null \
        | grep -v '^[[:space:]]*$' | head -1 | cut -c1-120) || \
        _probe_hint=$(head -1 "$_probe_err" 2>/dev/null | cut -c1-120)
      [ -z "$_probe_hint" ] && _probe_hint="no output (auth expired or model unavailable?)"
      printf '  WARN %s: auth probe failed — %s\n' "$_pcmd" "$_probe_hint"
    fi
    rm -f "$_probe_out" "$_probe_err"
  done
  [ -z "$_probed_clis" ] && printf '  (no LLM CLIs configured — set CLAGENTIC_*_CMD in config)\n'

  # 9. Cross-vendor invariant check.
  # The whole point of clagentic-lite is that Builder and Reviewer are different
  # CLIs so they don't share blind spots. Warn (not fail) when they match —
  # a single-CLI setup still works, but the cross-vendor property is gone.
  #
  # ROUTER-BLIND FIX (lr-964f7f): CLAGENTIC_REVIEWER_CMD names the
  # direct-CLI FALLBACK only. When CLAGENTIC_REVIEWER_VIA_ROUTER=1 and
  # CLAGENTIC_ROUTER_URL is set, the live reviewer vendor is decided by
  # scripts/llm-client.sh's router path (_llm_role_routable + role_chain,
  # dispatched as model: role:reviewer-chain) instead — comparing
  # *_CMD alone produced a false "same vendor" WARN on a genuinely
  # cross-vendor routed setup (and, in 9b below, an OK naming the wrong
  # CLI's tool-restriction posture).
  #
  # PREFERRED FIX WOULD BE: reuse role_chain/_llm_role_routable directly so
  # doctor and llm-client.sh resolve the chain identically, never a second
  # parser. NOT done: scripts/llm-client.sh is not safe to `.` source from
  # this bootstrap-early doctor path (same constraint the 9b comment below
  # already documented, now verified concretely, not just asserted). The
  # file runs `set -e` and unconditionally executes a
  # `case "${1:-}" in build|review|...|*) exit 1; esac` dispatch at the
  # bottom with NO guard against being sourced — sourcing it here would
  # dispatch on doctor's own "doctor" argument, fall to the `*)` arm, and
  # `exit 1` out of the entire `clagentic-lite doctor` run before any
  # further checks printed. (scripts/test_llm_client_sh.py's own
  # `_functions_only_source` helper works around this by writing a
  # dispatch-truncated COPY to a throwaway tempdir for test harnesses only
  # — replicating that at doctor runtime would mean doctor itself
  # text-searching llm-client.sh for the exact dispatch line and writing a
  # temp copy every run, which is a second, fragile parse of that file's
  # structure, not a reuse of it.) Falling back to the documented minimal
  # alternative instead: when a role is routed, SUPPRESS the *_CMD-based
  # assertion and print an INFO naming CLAGENTIC_<ROLE>_CHAIN as the
  # variable that actually governs the live vendor. This removes the false
  # negative/wrong-vendor-OK without teaching doctor a second chain parser.
  printf '\ncross-vendor check:\n'
  _builder_cmd="${CLAGENTIC_BUILDER_CMD:-}"
  _reviewer_cmd="${CLAGENTIC_REVIEWER_CMD:-}"
  _reviewer_routed=0
  if [ -n "${CLAGENTIC_ROUTER_URL:-}" ] && [ "${CLAGENTIC_REVIEWER_VIA_ROUTER:-0}" = "1" ]; then
    _reviewer_routed=1
  fi
  if [ "$_reviewer_routed" = "1" ]; then
    printf '  INFO CLAGENTIC_REVIEWER_VIA_ROUTER=1 — the live Reviewer vendor is governed by CLAGENTIC_REVIEWER_CHAIN (dispatched as model: role:reviewer-chain via clagentic-router), not by CLAGENTIC_REVIEWER_CMD.\n'
    printf '       CLAGENTIC_REVIEWER_CHAIN=%s\n' "${CLAGENTIC_REVIEWER_CHAIN:-(unset)}"
    printf '       Cross-vendor status cannot be asserted from *_CMD alone on a routed role — compare CLAGENTIC_BUILDER_CMD (%s) against the chain above yourself, or against clagentic-router'"'"'s own /logs backend_id for a live call.\n' "${_builder_cmd:-(unset)}"
    printf '       CLAGENTIC_REVIEWER_CMD=%s remains configured as the direct-CLI FALLBACK for when the router is unreachable at call time.\n' "${_reviewer_cmd:-(unset)}"
  elif [ -z "$_builder_cmd" ] || [ -z "$_reviewer_cmd" ]; then
    printf '  (Builder or Reviewer CMD not configured — skipping cross-vendor check)\n'
  elif [ "$_builder_cmd" = "$_reviewer_cmd" ]; then
    printf '  WARN Builder and Reviewer both use "%s" — cross-vendor review is disabled.\n' "$_builder_cmd"
    printf '       Set CLAGENTIC_REVIEWER_CMD to a different CLI (e.g. codex vs claude).\n'
    printf '       Or set CLAGENTIC_REVIEWER_REQUIRED=1 to make same-vendor fallback a hard failure.\n'
    printf '       See docs/DESIGN.md §"The three roles" for rationale.\n'
  else
    _ok "Builder=$_builder_cmd / Reviewer=$_reviewer_cmd (cross-vendor OK)"
  fi

  # 9b. Reviewer tool-restriction check (lr-49df97 fold-in, BOBBIE finding
  # 1; UPDATED lr-37282a, UPDATED lr-964f7f). invoke_claude's
  # --allowedTools/--disallowedTools restriction (AGENTS.md INV-2) enforces
  # on the claude CLI path. invoke_codex now ALSO enforces (--disable
  # shell_tool -s read-only, verified against the installed codex CLI,
  # codex-cli 0.142.5 — see that function's own doc comment in
  # scripts/llm-client.sh for the full verification record), but only on
  # codex's version-gated flag-surface path (CODEX_MIN_VERSION,
  # scripts/llm-client.sh) — an installed codex older than that, or a third
  # CLI outside claude/codex entirely, is still genuinely unrestricted.
  # Doctor cannot cheaply re-run llm-client.sh's own cached version_ge
  # comparison here without sourcing that file (which this bootstrap-early
  # code path deliberately does not do — see the concrete "why" in the
  # cross-vendor check's comment above), so this check names codex as
  # restricted-when-current and points at the authoritative per-call
  # warning (llm-client.sh's own stderr warning, which DOES run the real
  # version check) for the precise version-gated case. Warn loudly here,
  # not just at call time, so the exposure is visible on a `doctor` run
  # before any review ever executes — same "fail-safe, not silent" posture
  # as the cross-vendor check above.
  #
  # ROUTER-BLIND FIX (lr-964f7f): same false-positive family as 9 above,
  # but security-relevant rather than merely informational — this check
  # exists to warn when a reviewer reading an attacker-influenceable diff
  # may hold unrestricted Bash, and branching on _reviewer_cmd answered
  # that question for the FALLBACK CLI, not the live routed reviewer, whose
  # tool-restriction posture is governed by the router adapter, not by
  # invoke_claude/invoke_codex's flag logic at all. When routed, this
  # doctor process has no visibility into the router adapter's own
  # tool-restriction posture — asserting either OK or WARN about it would
  # be a guess. Under-claim instead: suppress the *_CMD-keyed assertion and
  # name the router adapter as the thing that actually governs posture.
  printf '\nreviewer tool-restriction check:\n'
  if [ "$_reviewer_routed" = "1" ]; then
    printf '  INFO CLAGENTIC_REVIEWER_VIA_ROUTER=1 — tool-restriction posture for the live routed Reviewer is delegated to the clagentic-router adapter, not to invoke_claude/invoke_codex'"'"'s --allowedTools/--disallowedTools or --disable shell_tool flags (those apply only to the direct-CLI fallback below).\n'
    printf '       Backend: CLAGENTIC_REVIEWER_CHAIN=%s. Verify this backend'"'"'s own Bash/tool-execution posture against clagentic-router'"'"'s own docs/config — doctor cannot see inside the router adapter from here.\n' "${CLAGENTIC_REVIEWER_CHAIN:-(unset)}"
    if [ -n "$_reviewer_cmd" ]; then
      if [ "$_reviewer_cmd" = "claude" ]; then
        printf '       Direct-CLI FALLBACK (used only if the router is unreachable at call time): Reviewer=%s (tool-restriction enforced: --allowedTools Read,Grep,Glob --disallowedTools Bash)\n' "$_reviewer_cmd"
      elif [ "$_reviewer_cmd" = "codex" ]; then
        printf '       Direct-CLI FALLBACK (used only if the router is unreachable at call time): Reviewer=%s (tool-restriction enforced when codex >= CODEX_MIN_VERSION: --disable shell_tool -s read-only)\n' "$_reviewer_cmd"
      else
        printf '       Direct-CLI FALLBACK (used only if the router is unreachable at call time): Reviewer=%s has no known tool-restriction flag.\n' "$_reviewer_cmd"
      fi
    fi
  elif [ -z "$_reviewer_cmd" ]; then
    printf '  (Reviewer CMD not configured — skipping)\n'
  elif [ "$_reviewer_cmd" = "claude" ]; then
    _ok "Reviewer=$_reviewer_cmd (tool-restriction enforced: --allowedTools Read,Grep,Glob --disallowedTools Bash)"
  elif [ "$_reviewer_cmd" = "codex" ]; then
    _ok "Reviewer=$_reviewer_cmd (tool-restriction enforced when codex >= CODEX_MIN_VERSION: --disable shell_tool -s read-only)"
    printf '       On an older/unrecognized codex version, this call falls back to an unrestricted minimal flag set -- llm-client.sh prints a per-call stderr warning naming the installed version in that case.\n'
  else
    printf '  WARN Reviewer CLI is "%s" — no known tool-restriction flag; Bash is UNRESTRICTED on reviewer calls through this CLI.\n' "$_reviewer_cmd"
    printf '       The claude and codex CLI paths restrict the reviewer (--disallowedTools Bash / --disable shell_tool -s read-only); %s has no confirmed equivalent.\n' "$_reviewer_cmd"
    printf '       A --print/exec reviewer holding unrestricted Bash while reading an attacker-influenceable diff is a live prompt-injection-to-execution path.\n'
    printf '       See AGENTS.md Invariants INV-2 and docs/DESIGN.md "The five roles" for the known limitation.\n'
  fi

  # 9c. clagentic-router reachability probe. Silent (no output at all) when
  # CLAGENTIC_ROUTER_URL is unset — this is the operator's primary validation
  # tool for the router integration on a real machine, so failure output names
  # the exact URL probed and what to check, not a bare ok/fail.
  if [ -n "${CLAGENTIC_ROUTER_URL:-}" ]; then
    printf '\nclagentic-router probe:\n'
    ds_router_url_classify "${CLAGENTIC_ROUTER_URL}"

    if [ "$DS_ROUTER_URL_CLASS" = "malformed" ]; then
      _fail "CLAGENTIC_ROUTER_URL is not a well-formed http:// or https:// URL: ${CLAGENTIC_ROUTER_URL}"
      printf '       enroll/update will refuse to stamp this into settings.json until it is fixed.\n'
      printf '       Fix CLAGENTIC_ROUTER_URL in ~/.config/clagentic/lite/config, then re-run '"'"'clagentic-lite update'"'"' and '"'"'clagentic-lite doctor'"'"'.\n'
    else
      if [ "$DS_ROUTER_URL_CLASS" = "nonlocal" ]; then
        printf '  WARN CLAGENTIC_ROUTER_URL points at a NON-LOCAL host: %s (host: %s)\n' "$CLAGENTIC_ROUTER_URL" "$DS_ROUTER_URL_HOST"
        printf '       This redirects the ENTIRE Claude Code session (interactive + gate-path) through that host.\n'
        printf '       In the router'"'"'s passthrough mode, this session'"'"'s real Anthropic credentials are forwarded to it verbatim.\n'
        printf '       Allowed (clagentic-router can run on another box on your own network) but not the common case -- setup docs assume 127.0.0.1.\n'
      fi

      _router_url="${CLAGENTIC_ROUTER_URL%/}"
      _router_version_url="$_router_url/version"
      if ! command -v curl >/dev/null 2>&1; then
        printf '  WARN curl not on PATH — cannot probe %s\n' "$_router_version_url"
        printf '       Install curl, or verify manually: curl %s\n' "$_router_version_url"
      else
        # BUG (PR #152 fold-in): a bare assignment whose RHS is a command
        # substitution over a FAILING command aborts the whole script under
        # `set -e` on a strict POSIX `sh` (dash) -- unlike bash, dash treats
        # the assignment statement itself as the "simple command" that
        # failed, propagating the substituted command's exit status to the
        # assignment. curl exits non-zero on the single most common real
        # case here (connection refused -- the configured router simply
        # isn't running yet), which used to kill `doctor` mid-report with
        # no diagnostic at all, well before check #11 and the final
        # "== doctor summary ==" line ever printed. Wrapping the assignment
        # in `if ... ; then ... fi` makes the substitution's exit status the
        # CONDITION of a guarded statement rather than the exit status of a
        # bare simple command, so `set -e` never sees it as a top-level
        # failure -- the existing `_router_probe_rc` capture pattern
        # (used for the exact same reason immediately below) is the
        # established idiom in this codebase; this fixes the ONE call site
        # that predated it.
        _router_probe_body=$(mktemp -t clagentic-doctor-router.XXXXXX)
        if _router_probe_http=$($DS_TIMEOUT_CMD 10 curl -s -o "$_router_probe_body" -w '%{http_code}' "$_router_version_url" 2>/dev/null); then
          _router_probe_rc=0
        else
          _router_probe_rc=$?
        fi
        if [ "$_router_probe_rc" -eq 0 ] && [ "$_router_probe_http" = "200" ]; then
          _ok "clagentic-router reachable at $_router_url (GET /version -> 200)"
          if [ -s "$_router_probe_body" ]; then
            printf '       response: %s\n' "$(head -c 200 "$_router_probe_body" 2>/dev/null | tr -d '\n')"
          fi
        elif [ "$_router_probe_rc" -eq 0 ] && [ -n "$_router_probe_http" ]; then
          _fail "clagentic-router at $_router_url responded but not with 200 (GET /version -> $_router_probe_http)"
          printf '       Check that %s is actually a clagentic-router instance (not a different service on that port).\n' "$_router_url"
        else
          _fail "clagentic-router unreachable at $_router_url (GET /version — connection failed or timed out)"
          printf '       Check that clagentic-router is running and listening at %s.\n' "$_router_url"
          printf '       Start it from the clagentic-router checkout (see that repo'"'"'s README), then re-run '"'"'clagentic-lite doctor'"'"'.\n'
          printf '       If CLAGENTIC_ROUTER_URL points at the wrong host/port, fix it in ~/.config/clagentic/lite/config and re-run '"'"'clagentic-lite update'"'"'.\n'
        fi
        rm -f "$_router_probe_body"
      fi
    fi
    if [ -z "${CLAGENTIC_ROUTER_TOKEN:-}" ]; then
      printf '  INFO CLAGENTIC_ROUTER_TOKEN is unset — routed-mode roles (role:<chain>) will fail auth; passthrough mode does not need it.\n'
    fi
    if [ "${CLAGENTIC_ROUTER_BEDROCK_MODE:-0}" = "1" ]; then
      printf '  INFO CLAGENTIC_ROUTER_BEDROCK_MODE=1 — settings.json also carries ANTHROPIC_BEDROCK_BASE_URL/AWS_BEARER_TOKEN_BEDROCK, required for CLAUDE_CODE_USE_BEDROCK=1 sessions to route through the router.\n'
    elif [ "${CLAUDE_CODE_USE_BEDROCK:-}" = "1" ]; then
      printf '  WARN CLAUDE_CODE_USE_BEDROCK=1 is set in this environment but CLAGENTIC_ROUTER_BEDROCK_MODE is not — Bedrock-mode sessions ignore ANTHROPIC_BASE_URL/ANTHROPIC_AUTH_TOKEN entirely and will NOT route through clagentic-router.\n'
      printf '       This is an advisory check of the environment doctor runs in, not a durable stamp-time decision -- set CLAGENTIC_ROUTER_BEDROCK_MODE=1 and re-run enroll/update if your Claude Code sessions use Bedrock auth.\n'
    fi
    if [ "${CLAGENTIC_ROUTER_INJECT_AGENT_MODEL:-0}" = "1" ]; then
      printf '  INFO CLAGENTIC_ROUTER_INJECT_AGENT_MODEL=1 — reviewer/auditor/merge-gate agents install with model: role:<role>-chain in frontmatter.\n'
      printf '       This injection point is UNVERIFIED against a live interactive session (claude-code GH#44385 territory). See README "Verifying on your machine".\n'
    fi

    # GATE-PATH ROUTER OPT-IN, per-role (lr-02f048; gate carved out by
    # lr-250d9d): CLAGENTIC_<ROLE>_VIA_ROUTER=1 for reviewer/auditor makes
    # scripts/llm-client.sh POST to this router instead of shelling out to
    # a CLI directly — a SEPARATE opt-in from
    # CLAGENTIC_ROUTER_INJECT_AGENT_MODEL above (that one is the
    # interactive-subagent frontmatter injection; this one is the
    # gate-path, one-shot llm-client.sh call). CLAGENTIC_<ROLE>_CHAIN/_TIER
    # become no-ops for a routed role — surfaced here so that is visible
    # rather than silently ignored (task lr-02f048 acceptance criterion),
    # never enforced/refused: an operator who leaves both configured (e.g.
    # mid-migration) still gets a working gate, just with the CHAIN/TIER
    # values unused for that role.
    #
    # GATE IS DELIBERATELY NOT IN THE LOOP LIST BELOW (lr-250d9d): unlike
    # reviewer/auditor, the merge-gate role holds unrestricted Bash and does
    # real multi-turn tool-calling on the direct-CLI path
    # (ds_llm_role_is_bash_unrestricted, scripts/platform.sh) — routing it
    # would silently swap that for a one-shot, tool-free router call.
    # _llm_role_routable (scripts/llm-client.sh) never routes gate
    # regardless of this env var's value, so CLAGENTIC_GATE_VIA_ROUTER=1 is
    # ALWAYS a no-op, not merely "no-op when CHAIN/TIER also set" the way
    # reviewer/auditor's no-op case is. Reporting it via the same INFO line
    # the routable roles get ("this role's gate-path calls POST to
    # clagentic-router") would be actively false for gate, so it gets its
    # own, differently-worded check instead of joining the loop.
    if [ "${CLAGENTIC_GATE_VIA_ROUTER:-0}" = "1" ]; then
      printf '  WARN CLAGENTIC_GATE_VIA_ROUTER=1 is set but has NO EFFECT — the merge-gate role is never routed through clagentic-router (it holds unrestricted Bash and does real multi-turn tool-calling; routing it would silently drop both). Gate-path calls for this role always use CLAGENTIC_GATE_CMD/_TIER/_CHAIN directly. Unset this var to avoid the false impression that gate is being routed.\n'
    fi
    for _vr_role in REVIEWER AUDITOR; do
      _vr_key="CLAGENTIC_${_vr_role}_VIA_ROUTER"
      _vr_on=$(eval "printf '%s' \"\${${_vr_key}:-0}\"")
      [ "$_vr_on" = "1" ] || continue
      _vr_chain_key="CLAGENTIC_${_vr_role}_CHAIN"
      _vr_tier_key="CLAGENTIC_${_vr_role}_TIER"
      _vr_chain=$(eval "printf '%s' \"\${${_vr_chain_key}:-}\"")
      _vr_tier=$(eval "printf '%s' \"\${${_vr_tier_key}:-}\"")
      _vr_role_lc=$(printf '%s' "$_vr_role" | tr '[:upper:]' '[:lower:]')
      printf '  INFO %s=1 — this role'"'"'s gate-path calls POST to clagentic-router (model: role:%s-chain) instead of shelling out to a CLI; falls back to the direct-CLI chain, loudly, if the router is unreachable at call time.\n' \
        "$_vr_key" "$_vr_role_lc"
      if [ -n "$_vr_chain" ] || [ -n "$_vr_tier" ]; then
        _vr_also_set=""
        [ -n "$_vr_chain" ] && _vr_also_set="${_vr_chain_key}=${_vr_chain}"
        if [ -n "$_vr_tier" ]; then
          [ -n "$_vr_also_set" ] && _vr_also_set="${_vr_also_set} "
          _vr_also_set="${_vr_also_set}${_vr_tier_key}=${_vr_tier}"
        fi
        printf '  WARN %s is also set: %s — CHAIN/TIER are NO-OPS for a routed role, only consulted by the direct-CLI FALLBACK path (when the router itself is unreachable), never by the router path itself. This is visible-but-inert, not an error; unset CHAIN/TIER for this role if you no longer want them configuring anything but the fallback.\n' \
          "$_vr_key" "$_vr_also_set"
      fi
    done
  fi

  # 9c2. Host auth-mode declaration contradiction check (lr-6d4a1f, AC 6).
  # CLAGENTIC_AUTH_MODE is a host-declared claim, not something doctor can
  # verify is TRUE — but it CAN check whether the declaration contradicts
  # observed ambient env in the shell doctor itself runs in, and name both
  # sources when it does, rather than silently trusting a stale or wrong
  # declaration. Advisory (WARN, not FAIL): the ambient env doctor observes
  # is only this one shell's snapshot, not necessarily what a real gate-path
  # invocation will see (the same caveat the existing
  # CLAUDE_CODE_USE_BEDROCK/CLAGENTIC_ROUTER_BEDROCK_MODE check above
  # already carries).
  printf '\nhost auth-mode declaration:\n'
  case "${CLAGENTIC_AUTH_MODE:-}" in
    "")
      _ok "CLAGENTIC_AUTH_MODE is UNDECLARED (default — every gate-path call behaves exactly as it did before this key existed)"
      ;;
    anthropic-oauth|enterprise|bedrock-sso|bedrock-api-key)
      _ok "CLAGENTIC_AUTH_MODE=${CLAGENTIC_AUTH_MODE}"
      case "$CLAGENTIC_AUTH_MODE" in
        anthropic-oauth|enterprise)
          if [ "${CLAUDE_CODE_USE_BEDROCK:-}" = "1" ]; then
            printf '  WARN contradiction: CLAGENTIC_AUTH_MODE=%s (a direct-API mode) but CLAUDE_CODE_USE_BEDROCK=1 is set in this shell — the declaration says this host is not using Bedrock auth, but the ambient env doctor observes says it is.\n' "$CLAGENTIC_AUTH_MODE"
            printf '       Fix whichever source is wrong: update CLAGENTIC_AUTH_MODE if this host has actually moved to Bedrock auth, or unset CLAUDE_CODE_USE_BEDROCK in this shell if it was set by mistake.\n'
          fi
          ;;
        bedrock-sso|bedrock-api-key)
          if [ -n "${ANTHROPIC_API_KEY:-}" ] && [ "${CLAUDE_CODE_USE_BEDROCK:-}" != "1" ]; then
            printf '  WARN contradiction: CLAGENTIC_AUTH_MODE=%s (a Bedrock mode) but ANTHROPIC_API_KEY is set and CLAUDE_CODE_USE_BEDROCK is not "1" in this shell — the declaration says this host uses Bedrock auth, but the ambient env doctor observes looks like direct-API auth instead.\n' "$CLAGENTIC_AUTH_MODE"
            printf '       Fix whichever source is wrong: update CLAGENTIC_AUTH_MODE if this host has actually moved to direct-API auth, or check this shell'"'"'s own auth setup if it should be Bedrock.\n'
          fi
          if [ "$CLAGENTIC_AUTH_MODE" = "bedrock-sso" ]; then
            _amsc_dir="${CLAGENTIC_AUTH_MODE_SSO_CACHE_DIR:-$HOME/.aws/sso/cache}"
            if [ ! -d "$_amsc_dir" ]; then
              printf '  WARN CLAGENTIC_AUTH_MODE=bedrock-sso but no AWS SSO token cache directory found at %s — every gate-path call will fail the readiness preflight until this is fixed (run `aws sso login`, or set CLAGENTIC_AUTH_MODE_SSO_CACHE_DIR if the cache lives elsewhere).\n' "$_amsc_dir"
            fi
          fi
          ;;
      esac
      ;;
    *)
      printf '  WARN CLAGENTIC_AUTH_MODE="%s" is not a recognized value — treated as UNDECLARED (no-op) everywhere it is consumed. Recognized values: anthropic-oauth, enterprise, bedrock-sso, bedrock-api-key. Check for a typo.\n' "$CLAGENTIC_AUTH_MODE"
      ;;
  esac

  # 9d. Same-agent-name plugin collision check (generic backstop, lr-1b5a31),
  # 9e. render-stamp staleness check, and 9f. orphaned-but-resolvable legacy
  # router plugin check (lr-35315f). All factored into standalone functions
  # (below _RNB_V1_BLOCK_LINES / near update helpers) so they are
  # independently unit-testable against constructed `claude plugin list`
  # fixtures / fixture cache directories without executing cmd_doctor's own
  # dispatch. Each takes the caller's _ok/_fail closures by name (same
  # convention cmd_doctor already uses internally) so doctor's running
  # OK/FAIL tally stays accurate.
  printf '\nplugin agent-name collision check:\n'
  _doctor_check_plugin_collision _ok _fail

  printf '\nrendered plugin stamp:\n'
  _doctor_check_render_stamp_staleness _ok _fail

  printf '\norphaned legacy router plugin check:\n'
  _doctor_check_orphaned_router_plugin _ok _fail

  # 10. Memory tunables.
  printf '\nmemory tunables:\n'
  _ok "CLAGENTIC_RECALL_LIMIT=${CLAGENTIC_RECALL_LIMIT:-5 (default)}"
  _ok "CLAGENTIC_RECALL_MAX_CHARS=${CLAGENTIC_RECALL_MAX_CHARS:-1500 (default)}"
  _ok "CLAGENTIC_MEMORY_MAX_ROWS=${CLAGENTIC_MEMORY_MAX_ROWS:-5000 (default)}"

  # 10b. Global config drift check (lr-e33f73): compares the key set in
  # share/config.example against the installed global config. `update`
  # never refreshes an existing config (see CONFIG_SCHEMA_VERSION comment,
  # top of file) — this is the only place a missing-but-shipped key becomes
  # visible short of manually diffing the two files.
  printf '\nglobal config drift:\n'
  _doctor_check_config_drift _ok

  # 11. Stale env/config var check: warn when CLAGENTIC_HOME is still set.
  printf '\nenv var migration:\n'
  if [ -n "${CLAGENTIC_HOME:-}" ]; then
    printf '  WARN CLAGENTIC_HOME is set (deprecated) — migrate to CLAGENTIC_LITE_HOME.\n'
    printf '       Current value: %s\n' "$CLAGENTIC_HOME"
    printf '       In your shell profile, replace:\n'
    printf '         export CLAGENTIC_HOME=...\n'
    printf '       with:\n'
    printf '         export CLAGENTIC_LITE_HOME=...\n'
    printf '       Old var is still honored (with a one-time warning) for back-compat.\n'
  else
    _ok "CLAGENTIC_LITE_HOME in use (no deprecated CLAGENTIC_HOME set)"
  fi
  # Warn if config still has an old ~/.clagentic-lite default path.
  if [ -n "${CLAGENTIC_LITE_HOME:-}" ]; then
    case "$CLAGENTIC_LITE_HOME" in
      */\.clagentic-lite*)
        printf '  WARN CLAGENTIC_LITE_HOME points at a path containing .clagentic-lite: %s\n' "$CLAGENTIC_LITE_HOME"
        printf '       The canonical default is ~/.clagentic/lite — consider moving and updating your config.\n'
        ;;
    esac
  fi
  # lr-7939f8: warn if the global config still lives at the pre-migration
  # brand-root path. Names paths only, never a value from either file.
  if [ -f "$OLD_GLOBAL_CONFIG" ]; then
    if [ -f "$GLOBAL_CONFIG" ]; then
      printf '  WARN legacy global config still present at %s alongside the current one at %s.\n' "$OLD_GLOBAL_CONFIG" "$GLOBAL_CONFIG"
      printf '       %s is authoritative (read by every command); run `clagentic-lite update` to clean up the legacy copy if it is identical, or reconcile by hand if it differs.\n' "$GLOBAL_CONFIG"
    else
      printf '  WARN global config is still at the deprecated brand-root path: %s\n' "$OLD_GLOBAL_CONFIG"
      printf '       Run `clagentic-lite update` to migrate it to %s (brand/product namespace split).\n' "$GLOBAL_CONFIG"
      printf '       The old path is still honored as a read fallback during the deprecation window.\n'
    fi
  else
    _ok "global config at product path (no legacy brand-root config found)"
  fi

  printf '\n== doctor summary: %s OK, %s FAIL ==\n\n' "$_ok" "$_fail"
  [ "$_fail" -eq 0 ]
}

# ---------------------------------------------------------------- rotate

# cmd_rotate
# lr-684947, concern 1: no rotate subcommand existed. Rotating
# CLAGENTIC_ROUTER_TOKEN/CLAGENTIC_ROUTER_BEDROCK_TOKEN meant re-stamping
# every enrolled repo by hand, per repo, with nothing enumerating the
# copies or detecting a stale one. Builds on the registry machinery `list`/
# `doctor` already walk — see REGISTRY (top of file).
#
# SCOPE: re-stamps ONLY .claude/settings.json (the one artifact that can
# carry the credential), never CLAUDE.md/builder-contract.md — a narrower
# operation than _restamp_repo_artifacts (used by `update --restamp`),
# deliberately, so `rotate` does exactly one thing and its exit code means
# exactly one thing: every reachable enrolled repo's settings.json now
# reflects the CURRENT CLAGENTIC_ROUTER_TOKEN/CLAGENTIC_ROUTER_BEDROCK_TOKEN
# (or apiKeyHelper — see CLAGENTIC_ROUTER_USE_API_KEY_HELPER, which makes
# rotation a single-file GLOBAL_CONFIG edit that needs no restamp at all,
# the stronger property _render_api_key_helper_command's doc comment names).
#
# UNBOUNDED N, NOT THE REPORTING HOST'S ELEVEN (lr-684947, agnostic-tool
# hardening): no assumption about registry size, and every member is
# checked independently — one unreachable/deleted repo never stops the
# sweep over the rest (mirrors cmd_doctor's own per-repo continue-on-
# failure loop, not a fail-fast one).
#
# EXIT STATUS: non-zero if ANY registry member could not be re-stamped
# (missing directory, not a git repo, or not clagentic-managed) — the
# member's path is always named on stderr, never silently skipped. Zero
# only when every reachable, clagentic-managed member was re-stamped
# successfully (an empty registry is zero — nothing to rotate is not a
# failure).
cmd_rotate() {
  _rot_ok=0
  _rot_stale=0
  _rot_total=0

  if [ ! -f "$REGISTRY" ]; then
    say "no enrolled repos (registry not found at $REGISTRY) — nothing to rotate"
    return 0
  fi

  while IFS= read -r _rot_path; do
    [ -z "$_rot_path" ] && continue
    _rot_total=$((_rot_total+1))

    if [ ! -d "$_rot_path" ]; then
      printf '  STALE %s: registered path no longer exists\n' "$_rot_path" 1>&2
      _rot_stale=$((_rot_stale+1))
      continue
    fi
    if ! git -C "$_rot_path" rev-parse --git-dir >/dev/null 2>&1; then
      printf '  STALE %s: not a git repo\n' "$_rot_path" 1>&2
      _rot_stale=$((_rot_stale+1))
      continue
    fi

    _rot_cs="$_rot_path/.claude/settings.json"
    if [ ! -f "$_rot_cs" ]; then
      printf '  STALE %s: .claude/settings.json missing (run `clagentic-lite enroll --force`)\n' "$_rot_path" 1>&2
      _rot_stale=$((_rot_stale+1))
      continue
    fi
    if ! grep -q 'managed-by: clagentic' "$_rot_cs" 2>/dev/null; then
      printf '  STALE %s: .claude/settings.json is not clagentic-managed\n' "$_rot_path" 1>&2
      _rot_stale=$((_rot_stale+1))
      continue
    fi

    _rot_cs_template="$SHARE_DIR/hook-shims/claude-settings.template"
    if [ ! -f "$_rot_cs_template" ]; then
      printf '  STALE %s: claude-settings.template missing from this install\n' "$_rot_path" 1>&2
      _rot_stale=$((_rot_stale+1))
      continue
    fi

    if _stamp_claude_settings "$_rot_cs_template" "$_rot_cs"; then
      say "rotated: $_rot_cs"
      _rot_ok=$((_rot_ok+1))
    else
      printf '  STALE %s: settings.json re-stamp failed\n' "$_rot_path" 1>&2
      _rot_stale=$((_rot_stale+1))
    fi

    # Wrapper .claude/settings.json, if this repo has a .clagentic-project
    # parent — same credential, same rotation obligation, not counted as a
    # SECOND registry member (it is derived from this one's parent dir, the
    # same relationship cmd_doctor's own wrapper-pointer check (§7) uses).
    _rot_wrapper_dir=$(dirname "$_rot_path")
    _rot_wrapper_ptr="$_rot_wrapper_dir/.clagentic-project"
    if [ -f "$_rot_wrapper_ptr" ] && [ -f "$_rot_wrapper_dir/.claude/settings.json" ]; then
      if ENROLL_FORCE=1 _stamp_wrapper_settings "$_rot_wrapper_dir"; then
        say "rotated wrapper: $_rot_wrapper_dir/.claude/settings.json"
      else
        printf '  STALE %s: wrapper settings.json re-stamp failed\n' "$_rot_wrapper_dir" 1>&2
        _rot_stale=$((_rot_stale+1))
      fi
    fi
  done < "$REGISTRY"

  printf '[clagentic-lite] rotate complete: %s rotated, %s stale, %s total enrolled repo(s)\n' \
    "$_rot_ok" "$_rot_stale" "$_rot_total"
  [ "$_rot_stale" -eq 0 ]
}

# ---------------------------------------------------------------- update

# _restamp_notice_block FILE TEMPLATE
# Replace the clagentic-managed notice block at the top of FILE with the
# contents of TEMPLATE, preserving any user content that follows it.
#
# Boundary detection (in priority order):
#   1. Closing sentinel "<!-- /clagentic-notice -->" in the first 20 lines —
#      authoritative end-of-block marker present in v2+ templates.
#   2. File is short (< v1 block length) — replace whole file; no user content.
#   3. v1 fallback: no sentinel found. Use the fixed v1 block length (8 lines)
#      as the split boundary. v1 block was exactly 8 lines (the current template
#      minus the sentinel line). User content starts at line 9.
#      IMPORTANT: do not substitute _rnb_tmpl_lines here — the current template
#      is 9 lines (v2), but the installed file is 8-line v1. Using the current
#      template length is off by one and silently drops the first user line.
#
# V1_BLOCK_LINES is the fixed line count of the CLAUDE.md.template at v1.
# It must not be changed. If the template grows, bump CLAUDE_NOTICE_VERSION and
# add a new sentinel-based path; never change this constant.
_RNB_V1_BLOCK_LINES=8
_restamp_notice_block() {
  _rnb_file="$1"
  _rnb_template="$2"
  _rnb_total=$(wc -l < "$_rnb_file" 2>/dev/null || echo 0)

  # Short path: file has fewer lines than the v1 block — nothing follows the
  # managed block regardless of version.
  if [ "$_rnb_total" -lt "$_RNB_V1_BLOCK_LINES" ]; then
    cp "$_rnb_template" "$_rnb_file"
    return 0
  fi

  # Find the closing sentinel "<!-- /clagentic-notice -->" in the first 20 lines.
  _rnb_sentinel_line=0
  _rnb_lineno=0
  while IFS= read -r _rnb_line; do
    _rnb_lineno=$((_rnb_lineno+1))
    [ "$_rnb_lineno" -gt 20 ] && break
    case "$_rnb_line" in
      '<!-- /clagentic-notice -->'*) _rnb_sentinel_line="$_rnb_lineno"; break ;;
    esac
  done < "$_rnb_file"

  if [ "$_rnb_sentinel_line" -eq 0 ]; then
    # No sentinel — v1 install. Split at the fixed v1 block boundary.
    # User content starts at line _RNB_V1_BLOCK_LINES + 1 = 9.
    _rnb_user_start=$((_RNB_V1_BLOCK_LINES + 1))
    _rnb_user=""
    if [ "$_rnb_user_start" -le "$_rnb_total" ]; then
      _rnb_user=$(tail -n "+${_rnb_user_start}" "$_rnb_file" 2>/dev/null || true)
    fi
    if [ -n "$_rnb_user" ]; then
      {
        cat "$_rnb_template"
        printf '%s\n' "$_rnb_user"
      } > "$_rnb_file"
    else
      cp "$_rnb_template" "$_rnb_file"
    fi
    return 0
  fi

  # Sentinel found — split at sentinel line; user content follows.
  _rnb_user_start=$((_rnb_sentinel_line+1))
  _rnb_user=""
  if [ "$_rnb_user_start" -le "$_rnb_total" ]; then
    _rnb_user=$(tail -n "+${_rnb_user_start}" "$_rnb_file" 2>/dev/null || true)
  fi

  # Write: notice block from template (includes sentinel), then user content.
  if [ -n "$_rnb_user" ]; then
    {
      cat "$_rnb_template"
      printf '%s\n' "$_rnb_user"
    } > "$_rnb_file"
  else
    cp "$_rnb_template" "$_rnb_file"
  fi
  return 0
}

# _restamp_repo_artifacts PATH LABEL
# Re-stamp the enrollment notice in CLAUDE.md, builder-contract.md,
# .claude/settings.json, and wrapper CLAUDE.md for PATH.
# LABEL is appended to each say message (e.g. "" for version-mismatch path,
# " (--restamp)" for the force pass) so callers can distinguish log lines.
# Prints the number of artifacts written to stdout; caller adds to _restamped.
# Version checking is the caller's responsibility — this function always writes.
_restamp_repo_artifacts() {
  _ra_path="$1"
  _ra_label="$2"
  _ra_count=0

  # Re-stamp CLAUDE.md notice block only, preserving user content below.
  # The committed repo CLAUDE.md is now a thin notice (~9 lines) that is true
  # for any teammate regardless of whether clagentic-lite is installed.
  #
  # Old-style fat files (clagentic-claude-md-version marker, pre-5eb8dd6) are
  # fully replaced — their entire content was managed, no user content follows
  # the block. _restamp_notice_block would misidentify the fat block's own
  # rules content (lines 9+) as user content and re-append it after the new
  # thin template, producing an inconsistent committed file that tells
  # non-clagentic contributors "these are binding rules" unconditionally.
  _ra_cm="$_ra_path/CLAUDE.md"
  if [ -f "$_ra_cm" ] && grep -q 'managed-by: clagentic' "$_ra_cm" 2>/dev/null; then
    _ra_cm_template="$SHARE_DIR/hook-shims/CLAUDE.md.template"
    if [ -f "$_ra_cm_template" ]; then
      if grep -q 'clagentic-claude-md-version' "$_ra_cm" 2>/dev/null; then
        # Old fat template — full replace; no user content to preserve.
        cp "$_ra_cm_template" "$_ra_cm"
      else
        _restamp_notice_block "$_ra_cm" "$_ra_cm_template"
      fi
      say "re-stamped${_ra_label}: $_ra_path/CLAUDE.md" >&2
      _ra_count=$((_ra_count+1))
    fi
  fi

  # Re-stamp .clagentic/lite/builder-contract.md — always a full restamp (gitignored,
  # no user content, local only).
  _ra_contract="$_ra_path/.clagentic/lite/builder-contract.md"
  if [ -f "$_ra_contract" ] && grep -q 'managed-by: clagentic' "$_ra_contract" 2>/dev/null; then
    _ra_contract_template="$SHARE_DIR/hook-shims/builder-contract.template"
    if [ -f "$_ra_contract_template" ]; then
      _ra_default_branch="${CLAGENTIC_DEFAULT_BRANCH:-main}"
      sed -e "s|__CLAGENTIC_LITE_HOME__|$CLAGENTIC_LITE_HOME|g" \
          -e "s|__CLAGENTIC_DEFAULT_BRANCH__|$_ra_default_branch|g" \
          "$_ra_contract_template" > "$_ra_contract"
      say "re-stamped${_ra_label}: $_ra_path/.clagentic/lite/builder-contract.md" >&2
      _ra_count=$((_ra_count+1))
    fi
  fi

  # Re-stamp .claude/settings.json.
  _ra_cs="$_ra_path/.claude/settings.json"
  if [ -f "$_ra_cs" ] && grep -q 'managed-by: clagentic' "$_ra_cs" 2>/dev/null; then
    _ra_cs_template="$SHARE_DIR/hook-shims/claude-settings.template"
    if [ -f "$_ra_cs_template" ]; then
      _stamp_claude_settings "$_ra_cs_template" "$_ra_cs"
      say "re-stamped${_ra_label}: $_ra_path/.claude/settings.json" >&2
      _ra_count=$((_ra_count+1))
    fi
  fi

  # Agent files and skills are installed globally via the clagentic-lite plugin.
  # cmd_update bumps plugin.json version and calls 'claude plugin update'
  # to refresh agents and skills on the user's machine — no per-repo copy to maintain.

  # Re-stamp wrapper CLAUDE.md and .claude/settings.json if the parent dir has
  # a .clagentic-project pointer.
  _ra_wrapper_dir=$(dirname "$_ra_path")
  _ra_wrapper_ptr="$_ra_wrapper_dir/.clagentic-project"
  _ra_wrapper_cm="$_ra_wrapper_dir/CLAUDE.md"
  if [ -f "$_ra_wrapper_ptr" ]; then
    # Re-stamp wrapper CLAUDE.md only when it is clagentic-managed.
    if [ -f "$_ra_wrapper_cm" ] && grep -q 'managed-by: clagentic' "$_ra_wrapper_cm" 2>/dev/null; then
      _ra_wcm_template="$SHARE_DIR/hook-shims/CLAUDE.md.wrapper.template"
      if [ -f "$_ra_wcm_template" ]; then
        # Re-build the project table from the pointer file.
        _ra_wcm_repos=$(tr '\n' ' ' < "$_ra_wrapper_ptr" 2>/dev/null || true)
        ENROLL_FORCE=1 _stamp_wrapper_claude_md "$_ra_wrapper_dir" "$_ra_wcm_repos" && {
          say "re-stamped wrapper${_ra_label}: $_ra_wrapper_cm" >&2
          _ra_count=$((_ra_count+1))
        }
      fi
    fi
    # Re-stamp wrapper .claude/settings.json whenever the pointer exists —
    # independent of whether wrapper CLAUDE.md is managed.  Wrappers enrolled
    # before wrapper CLAUDE.md stamping was introduced have no managed CLAUDE.md
    # but still need hook wiring; gating on CLAUDE.md caused the restamp to be
    # silently skipped for those installs.
    ENROLL_FORCE=1 _stamp_wrapper_settings "$_ra_wrapper_dir" && {
      say "re-stamped wrapper settings${_ra_label}: $_ra_wrapper_dir/.claude/settings.json" >&2
      _ra_count=$((_ra_count+1))
    }
  fi

  printf '%d\n' "$_ra_count"
}

# _mgcb_checkpoint STEP_NAME
# Test-only instrumentation point, called at each step boundary inside
# _migrate_global_config_brand_path below. In production this is exactly a
# no-op (defined once, here, as a plain `:`) -- zero behavior/perf change on
# every real invocation. A test that needs to prove atomicity across a
# process kill at a specific step boundary (lore task lr-7939f8 comment #1
# requirement: "test process-kill mid-migration at every step boundary")
# defines its OWN _mgcb_checkpoint before sourcing the extracted function
# (same extraction technique as scripts/test_unified_plugin_render.py) that
# writes a readiness marker and then sends itself SIGKILL at the named step
# -- deterministic, no sleep-and-race timing. This function is intentionally
# defined unconditionally (not `command -v` guarded) so a stale/missing
# override in a future test still calls a real, harmless no-op rather than
# an undefined-function shell error.
_mgcb_checkpoint() { :; }

# _migrate_global_config_brand_path
# lr-7939f8: migrate the global config from the brand root
# $OLD_GLOBAL_CONFIG (~/.config/clagentic/config) to the product path
# $GLOBAL_CONFIG (~/.config/clagentic/lite/config) -- see the header
# comment above the two constant definitions (top of file) for why.
#
# SAFETY BAR (this file holds live credentials -- CLAGENTIC_ROUTER_TOKEN,
# CLAGENTIC_ROUTER_BEDROCK_TOKEN):
#   - chmod 600 before/during/after, no window -- every temp file this
#     function creates goes through _secret_tmp_create (umask 077 subshell,
#     mode 600 from the single creating syscall), never `cmd > file` then
#     chmod after the fact. Reusing that existing helper rather than a
#     second primitive is a binding requirement (lore task lr-7939f8
#     comment #1) -- see _secret_tmp_create's own doc comment for why a
#     truncate-then-chmod pattern is a real, previously-caught race.
#   - No configured VALUE is ever printed/logged/echoed on any path,
#     including error paths -- every message below names paths only.
#   - Never a state where both locations exist with different content:
#     if $GLOBAL_CONFIG already exists, this function never overwrites it
#     from $OLD_GLOBAL_CONFIG. If the two differ, it says so explicitly
#     (byte-diff, not content) and leaves both in place -- the operator
#     reconciles by hand. Precedence when both exist (matches
#     ds_load_global_env, scripts/platform.sh): the NEW path always wins
#     at read time; the OLD path is never consulted once the new one
#     exists, migrated or not.
#   - Old path is a symlink: content is read through the symlink (cat
#     follows it transparently) into the new location; only the symlink
#     itself is removed afterward, never whatever it pointed at.
#   - Old path is read-only (mode without owner-write): still migrates --
#     migrating only ever READS the old file and later unlinks it (which
#     needs write permission on the parent directory, not the file itself).
#   - New path's parent directory ($HOME/.config/clagentic/lite) is
#     created at mode 700 if missing, mirroring _write_global_config's own
#     directory-creation discipline for the same class of file.
#   - Idempotent: a second call with the new path already present and
#     identical content, or with the old path already gone, is a silent
#     no-op (nothing left to migrate).
#   - ATOMICITY ACROSS A KILL: content lands in a 600 temp file in the
#     NEW directory first, then a single `mv` (same-filesystem rename,
#     since both live under $HOME/.config/clagentic/) installs it at
#     $GLOBAL_CONFIG. The old file is removed only AFTER that mv succeeds.
#     A process kill before the mv leaves the config fully intact and
#     unchanged at the OLD path only (temp file is orphaned, never
#     world-readable, harmless to leave or clean up on a re-run). A kill
#     AFTER the mv but before the old-file removal leaves the config fully
#     intact at BOTH paths (new is authoritative per the precedence rule
#     above; a re-run sees the new path already populated and simply
#     finishes the cleanup by removing the now-redundant old copy). There
#     is no step where the config is held ONLY in a temp file with the
#     real path holding nothing, and no step where neither path has the
#     full content.
_migrate_global_config_brand_path() {
  [ -f "$OLD_GLOBAL_CONFIG" ] || return 0

  if [ -f "$GLOBAL_CONFIG" ]; then
    if cmp -s "$OLD_GLOBAL_CONFIG" "$GLOBAL_CONFIG" 2>/dev/null; then
      # Already migrated, identical content -- finish the cleanup (a prior
      # run's kill window between mv and old-file removal, or a config
      # manually copied into place) by removing the now-redundant old copy.
      _mgcb_checkpoint before-cleanup-rm
      rm -f "$OLD_GLOBAL_CONFIG"
      say "removed redundant legacy config at $OLD_GLOBAL_CONFIG (already migrated to $GLOBAL_CONFIG)"
    else
      warn "both $OLD_GLOBAL_CONFIG and $GLOBAL_CONFIG exist with DIFFERENT content -- not migrating."
      warn "  $GLOBAL_CONFIG is authoritative (every command reads it, never the old path, once it exists)."
      warn "  Review $OLD_GLOBAL_CONFIG by hand and merge or remove it; this step will not touch either file until you do."
    fi
    return 0
  fi

  _mgcb_new_dir="$(dirname "$GLOBAL_CONFIG")"
  if [ ! -d "$_mgcb_new_dir" ]; then
    mkdir -p "$_mgcb_new_dir" && chmod 700 "$_mgcb_new_dir" \
      || { warn "could not create $_mgcb_new_dir -- skipping global config migration (old path still honored)"; return 1; }
  fi
  _mgcb_checkpoint after-mkdir

  _mgcb_tmp="$GLOBAL_CONFIG.migrate.$$"
  _secret_tmp_create "$_mgcb_tmp" || { warn "could not chmod 600 migration temp file -- skipping global config migration (old path still honored)"; return 1; }
  _mgcb_checkpoint after-tmp-create
  if ! cat "$OLD_GLOBAL_CONFIG" >> "$_mgcb_tmp" 2>/dev/null; then
    warn "could not read $OLD_GLOBAL_CONFIG -- skipping global config migration"
    rm -f "$_mgcb_tmp"
    return 1
  fi
  _mgcb_checkpoint after-content-copied

  mv "$_mgcb_tmp" "$GLOBAL_CONFIG" \
    || { warn "could not install migrated config at $GLOBAL_CONFIG -- skipping (old path still honored)"; rm -f "$_mgcb_tmp"; return 1; }
  chmod 600 "$GLOBAL_CONFIG"
  _mgcb_checkpoint after-mv-before-old-rm

  rm -f "$OLD_GLOBAL_CONFIG"
  say "migrated global config: $OLD_GLOBAL_CONFIG -> $GLOBAL_CONFIG (brand/product namespace split, chmod 600)"
}

cmd_update() {
  RESTAMP=0
  REFRESH_CONFIG=0
  for _arg in "$@"; do
    case "$_arg" in
      --restamp) RESTAMP=1 ;;
      --refresh-config) REFRESH_CONFIG=1 ;;
    esac
  done

  # Migration: ~/.clagentic-lite -> ~/.clagentic/lite
  # Detect old default home and offer to migrate. Only runs when:
  #   - the old path exists
  #   - the new path does NOT exist (clean migration, not already done)
  #   - CLAGENTIC_LITE_HOME is either the old default (binary running from old path,
  #     user has not yet updated their shell profile) OR the new default (user
  #     updated shell profile but the directory hasn't been moved yet).
  #   Custom CLAGENTIC_LITE_HOME values that are neither old nor new default are left
  #   alone — user manages their own install location.
  _old_home="$HOME/.clagentic-lite"
  _new_home="$HOME/.clagentic/lite"
  if [ -d "$_old_home" ] && [ ! -d "$_new_home" ] && \
     { [ "$CLAGENTIC_LITE_HOME" = "$_old_home" ] || [ "$CLAGENTIC_LITE_HOME" = "$_new_home" ]; }; then
    say "migration available: ~/.clagentic-lite -> ~/.clagentic/lite (brand namespace standardization)"
    _migrate_reply="y"
    if [ -t 0 ]; then
      printf '[clagentic-lite] Move %s to %s? [Y/n]: ' "$_old_home" "$_new_home"
      read -r _migrate_reply || _migrate_reply="y"
      [ -z "$_migrate_reply" ] && _migrate_reply="y"
    fi
    case "$_migrate_reply" in
      n|N) warn "skipping home migration — hooks will fail until CLAGENTIC_LITE_HOME is updated" ;;
      *)
        mkdir -p "$(dirname "$_new_home")"
        mv "$_old_home" "$_new_home" && say "moved: $_old_home -> $_new_home" || \
          die "failed to move $_old_home to $_new_home"
        # Update CLAGENTIC_LITE_HOME for the rest of this run.
        CLAGENTIC_LITE_HOME="$_new_home"
        export CLAGENTIC_LITE_HOME
        SCRIPTS_DIR="$CLAGENTIC_LITE_HOME/scripts"
        SHARE_DIR="$CLAGENTIC_LITE_HOME/share"
        say "note: update your shell profile if you have CLAGENTIC_LITE_HOME set explicitly"
        say "  export CLAGENTIC_LITE_HOME=\"\$HOME/.clagentic/lite\""
        ;;
    esac
  fi

  # Global config migration: ~/.config/clagentic/config -> ~/.config/clagentic/lite/config
  # (lr-7939f8, brand/product namespace split -- see _migrate_global_config_brand_path's
  # own doc comment for the full safety contract). Unlike the two migrations above,
  # this one holds live credentials and runs with no interactive prompt -- it is
  # additive/non-destructive by construction (never overwrites an existing
  # $GLOBAL_CONFIG, never deletes the old file until the new one is confirmed on
  # disk), so it does not need the tty confirmation gate the home-directory move above
  # uses for a plain directory rename.
  _migrate_global_config_brand_path

  # Per-repo migration: .clagentic/<ephemeral> -> .clagentic/lite/<ephemeral>
  _EPHEMERAL_FILES="audit.db memory.db builder-contract.md last-review.json last-adversarial.md last-merge-gate.json gate-summary.json stop-summarize.lock report.html"
  if [ -f "$REGISTRY" ]; then
    while IFS= read -r _mpath; do
      [ -z "$_mpath" ] && continue
      [ -d "$_mpath" ] || continue
      _old_dot="$_mpath/.clagentic"
      _new_dot="$_mpath/.clagentic/lite"
      # Check if any old-path ephemeral files exist and new dir doesn't
      _needs_migrate=0
      for _ef in $_EPHEMERAL_FILES; do
        [ -f "$_old_dot/$_ef" ] && [ ! -d "$_new_dot" ] && _needs_migrate=1 && break
      done
      if [ "$_needs_migrate" -eq 1 ]; then
        mkdir -p "$_new_dot"
        for _ef in $_EPHEMERAL_FILES; do
          [ -f "$_old_dot/$_ef" ] && mv "$_old_dot/$_ef" "$_new_dot/$_ef" && \
            say "migrated: $_mpath/.clagentic/$_ef -> .clagentic/lite/$_ef"
        done
        # Update gitignore: replace old per-file patterns with single blanket.
        # Skip if a blanket .clagentic/ line already covers .clagentic/lite/.
        _gi="$_mpath/.gitignore"
        if [ -f "$_gi" ]; then
          if grep -qxF '.clagentic/' "$_gi" 2>/dev/null; then
            say "note: $_mpath/.gitignore has blanket .clagentic/ — already covers .clagentic/lite/"
          else
            _updated=$(grep -v "^\.clagentic/audit\.db$\|^\.clagentic/memory\.db$\|^\.clagentic/builder-contract\.md$\|^\.clagentic/last-review\.json$\|^\.clagentic/last-adversarial\.md$\|^\.clagentic/last-merge-gate\.json$\|^\.clagentic/gate-summary\.json$\|^\.clagentic/stop-summarize\.lock$\|^\.clagentic/report\.html$" "$_gi" 2>/dev/null || true)
            if ! printf '%s\n' "$_updated" | grep -qxF '.clagentic/lite/'; then
              { printf '%s\n' "$_updated" | grep -v '^$'; printf '.clagentic/lite/\n'; } > "$_gi"
              say "updated .gitignore: replaced per-file patterns with .clagentic/lite/ blanket"
            else
              printf '%s\n' "$_updated" | grep -v '^$' > "$_gi"
            fi
          fi
        fi
      fi
    done < "$REGISTRY"
  fi

  say "updating clagentic-lite at $CLAGENTIC_LITE_HOME..."

  # If CLAGENTIC_LITE_HOME has uncommitted changes, prompt before discarding them.
  # Local edits to CLAGENTIC_LITE_HOME are tool internals, not user work — but the
  # user should confirm before we silently discard them.
  #
  # lr-55a27a: the non-tty branch used to warn-and-discard unconditionally via
  # `git stash push` + `git stash drop`. That sequence destroys working-tree
  # content IRRECOVERABLY and leaves NO reflog entry once the stash is
  # dropped. Every crew-agent/CI invocation is non-tty, so the interactive
  # confirmation above was never reached in practice — the destructive branch
  # was the only branch an automated caller could take, and CLAGENTIC_LITE_HOME
  # can be repointed at a real dev checkout (see the bootstrap block at the
  # top of this file). Fail closed instead: non-tty now REFUSES by default
  # and requires an explicit opt-in (CLAGENTIC_UPDATE_ALLOW_DISCARD=1) to
  # proceed with the destructive stash-drop path. A genuine unattended
  # install (CLAGENTIC_LITE_HOME pointing at a disposable install dir) sets
  # the opt-in once in its own environment/config; this preserves unattended
  # updates for that case without leaving every non-tty caller destructive
  # by default.
  if ! git -C "$CLAGENTIC_LITE_HOME" diff --quiet 2>/dev/null; then
    _dirty=$(git -C "$CLAGENTIC_LITE_HOME" diff --name-only 2>/dev/null)
    if [ -t 0 ]; then
      printf '[clagentic-lite] WARN: uncommitted changes in %s:\n' "$CLAGENTIC_LITE_HOME" >&2
      printf '%s\n' "$_dirty" | sed 's/^/  /' >&2
      printf 'These changes will be discarded to proceed with update. Continue? [y/N]: '
      read -r _stash_reply || _stash_reply=""
      case "$_stash_reply" in
        y|Y|yes|YES)
          git -C "$CLAGENTIC_LITE_HOME" stash push -q -m "clagentic-lite update discard" 2>/dev/null
          git -C "$CLAGENTIC_LITE_HOME" stash drop -q 2>/dev/null || true
          ;;
        *)
          die "update cancelled — stash or commit changes in $CLAGENTIC_LITE_HOME first"
          ;;
      esac
    elif [ "${CLAGENTIC_UPDATE_ALLOW_DISCARD:-0}" = "1" ]; then
      # Explicit opt-in: proceed with the same discard behavior as before.
      warn "non-tty: CLAGENTIC_UPDATE_ALLOW_DISCARD=1 set — discarding uncommitted changes in $CLAGENTIC_LITE_HOME to proceed with update"
      warn "dirty files: $(git -C "$CLAGENTIC_LITE_HOME" diff --name-only 2>/dev/null | tr '\n' ' ')"
      git -C "$CLAGENTIC_LITE_HOME" stash push -q -m "clagentic-lite update discard" 2>/dev/null
      git -C "$CLAGENTIC_LITE_HOME" stash drop -q 2>/dev/null || true
    else
      # Non-tty, no opt-in: fail closed rather than silently destroy
      # uncommitted work (lr-55a27a). Name the resolved path so a
      # misdirected CLAGENTIC_LITE_HOME is visible in output.
      die "update cancelled — non-tty run found uncommitted changes in $CLAGENTIC_LITE_HOME and CLAGENTIC_UPDATE_ALLOW_DISCARD is not set. Dirty files: $(git -C "$CLAGENTIC_LITE_HOME" diff --name-only 2>/dev/null | tr '\n' ' '). Commit or stash them yourself, or set CLAGENTIC_UPDATE_ALLOW_DISCARD=1 only if $CLAGENTIC_LITE_HOME is a disposable install dir."
    fi
  fi

  # ff-only pull.
  _pre_pull_sha=$(git -C "$CLAGENTIC_LITE_HOME" rev-parse HEAD 2>/dev/null || true)
  if ! git -C "$CLAGENTIC_LITE_HOME" pull --ff-only; then
    die "git pull --ff-only failed (non-fast-forward divergence or no upstream)"
  fi
  _post_pull_sha=$(git -C "$CLAGENTIC_LITE_HOME" rev-parse HEAD 2>/dev/null || true)

  # Re-exec with the freshly-pulled binary so version constants (CLAUDE_MD_VERSION,
  # CLAUDE_SETTINGS_VERSION, SHIM_VERSION) reflect the new code before the restamp
  # check runs. Without re-exec the variables are baked in at script startup and
  # the restamp comparison uses the pre-pull values — meaning a version bump in the
  # pull is invisible to the running process and enrolled repos are never restamped.
  if [ "$_pre_pull_sha" != "$_post_pull_sha" ]; then
    say "re-executing updated binary to pick up new version constants..."
    exec "$CLAGENTIC_LITE_HOME/bin/clagentic-lite" update "$@"
  fi

  # Re-run the same prereq sweep that init runs — pre-PR-#6 this only
  # checked sqlite3 + git, so a clagentic-lite update on a host that had since
  # uninstalled e.g. semgrep would silently leave the gate broken.
  say "checking prerequisites post-update..."
  _run_prereq_checks update

  # Render and install the ONE clagentic-lite plugin (config-aware —
  # lr-1b5a31). Runs before the registry check so it works on machines with
  # no enrolled repos. Always re-renders and re-installs: _render_stamp
  # inside the render function reflects current config on every run, so a
  # config change (e.g. flipping CLAGENTIC_ROUTER_INJECT_AGENT_MODEL, or
  # rotating a CLAGENTIC_<ROLE>_CMD) is picked up automatically without a
  # separate version-compare gate here — the render itself is cheap and
  # idempotent when nothing changed. Also runs the legacy-router-plugin
  # migration (inside _install_clagentic_lite_plugin) unconditionally, so a
  # machine with a stale clagentic-lite-router install converges in one run.
  _base_plugin_json="$CLAGENTIC_LITE_HOME/plugins/clagentic-lite/.claude-plugin/plugin.json"
  if [ -f "$_base_plugin_json" ]; then
    # plugin.json version is bumped by maintainer PRs that change agent or skill files.
    # cmd_update does not touch the checked-in version — local bumps drift from
    # upstream and break cache invalidation when the repo ships a real version change.
    _install_clagentic_lite_plugin
  else
    warn "plugin manifest not found: $_base_plugin_json — skipping plugin update"
  fi

  # Re-stamp $CLAGENTIC_LITE_HOME/.claude/hooks/*.sh if any hook template
  # changed (lr-57db23). Self-targeted — not per-enrolled-repo, since
  # enrolled repos call back into this ONE materialized copy by absolute
  # path rather than holding their own. Version-checked per script so an
  # unrelated hook's unchanged content is not needlessly rewritten.
  _hooks_need_restamp=0
  for _uh_name in $CLAGENTIC_HOOK_SCRIPTS; do
    _uh_installed="$CLAGENTIC_LITE_HOME/.claude/hooks/$_uh_name"
    if [ ! -f "$_uh_installed" ]; then
      _hooks_need_restamp=1
      break
    fi
    _uh_ver=$(claude_hooks_version "$_uh_installed")
    if [ "$_uh_ver" != "$CLAUDE_HOOKS_VERSION" ]; then
      _hooks_need_restamp=1
      break
    fi
  done
  if [ "$_hooks_need_restamp" -eq 1 ]; then
    _uh_count=$(_stamp_claude_hooks)
    say "re-stamped $_uh_count Claude Code hook script(s): $CLAGENTIC_LITE_HOME/.claude/hooks/ (-> $CLAUDE_HOOKS_VERSION)"
  else
    say "Claude Code hook scripts up to date ($CLAUDE_HOOKS_VERSION)"
  fi

  # Global config drift report / refresh (lr-25e73e, amending lr-e33f73 items
  # 3-4). OPERATOR DECISION (task thread comment #2): NOT silent-automatic on
  # every update, NOT warn-only-and-hand-edit either. `update` always LOUDLY
  # reports missing keys and names the one-command remedy; the append itself
  # only runs behind the explicit --refresh-config flag. Appended keys are
  # ALWAYS commented out — the flag controls whether keys are appended, never
  # whether they arrive active. Runs here, BEFORE the no-registry early
  # return below, so a machine with zero enrolled repos still gets this
  # (config refresh has nothing to do with repo enrollment).
  _update_report_or_refresh_config

  # Re-stamp shims in registered repos if the template version changed.
  if [ ! -f "$REGISTRY" ]; then
    say "no enrolled repos to re-stamp"
    return 0
  fi

  _restamped=0
  _would_restamp=0           # set when any shim or artifact is out of version
  _would_restamp_artifacts=0 # set only when a CLAUDE.md/settings artifact is out of version
  while IFS= read -r _rpath; do
    [ -z "$_rpath" ] && continue
    [ -d "$_rpath" ] || continue
    _git_dir=$(git -C "$_rpath" rev-parse --git-dir 2>/dev/null || true)
    [ -z "$_git_dir" ] && continue
    case "$_git_dir" in
      /*) _hd="$_git_dir/hooks" ;;
      *)  _hd="$_rpath/$_git_dir/hooks" ;;
    esac
    for _hook in pre-commit pre-push; do
      _hf="$_hd/$_hook"
      _installed_ver=$(shim_version "$_hf")
      if [ "$_installed_ver" != "$SHIM_VERSION" ]; then
        _would_restamp=1
        ENROLL_FORCE=0 stamp_shim "$_hook" "$_hd" && {
          say "re-stamped: $_rpath .git/hooks/$_hook ($_installed_ver -> $SHIM_VERSION)"
          _restamped=$((_restamped+1))
        }
      fi
    done

    # Re-stamp .claude/settings.json, CLAUDE.md notice, builder-contract.md,
    # and wrapper CLAUDE.md if any version changed.
    # _restamp_repo_artifacts handles all writes; we check versions here to
    # decide whether to call it and to set _would_restamp.
    # Guards mirror the originals: only compare version when the file exists and
    # carries the managed-by marker (or, for wrapper, when the pointer exists).
    _need_restamp=0
    _cs_file="$_rpath/.claude/settings.json"
    if [ -f "$_cs_file" ] && grep -q 'managed-by: clagentic' "$_cs_file" 2>/dev/null; then
      _cs_ver=$(claude_settings_version "$_cs_file")
      [ "$_cs_ver" != "$CLAUDE_SETTINGS_VERSION" ] && _need_restamp=1
    fi
    _cm_file="$_rpath/CLAUDE.md"
    if [ ! -f "$_cm_file" ]; then
      # CLAUDE.md entirely absent — restamp unconditionally.
      _need_restamp=1
    elif ! grep -q 'managed-by: clagentic' "$_cm_file" 2>/dev/null; then
      # managed-by marker stripped (user removed the notice). On a TTY, prompt
      # before re-adding; on non-TTY, warn but do not auto-restamp (user may
      # have intentionally replaced it). --restamp overrides and restores it.
      if [ "$RESTAMP" -eq 1 ]; then
        _need_restamp=1
      elif [ -t 0 ]; then
        printf '[clagentic-lite] WARN: %s/CLAUDE.md enrollment notice is missing or was removed.\n' "$_rpath" >&2
        printf 'Re-add the enrollment notice? [y/N]: '
        read -r _notice_reply || _notice_reply=""
        case "$_notice_reply" in
          y|Y|yes|YES) _need_restamp=1 ;;
          *) warn "$_rpath: skipping CLAUDE.md notice re-add (run \`clagentic-lite update --restamp\` to restore)" ;;
        esac
      else
        warn "$_rpath: CLAUDE.md enrollment notice missing — run \`clagentic-lite update --restamp\` to restore"
      fi
    else
      # Support both old marker (clagentic-claude-md-version) and new notice
      # marker (clagentic-notice-version) so the comparison works during transition.
      _cm_notice_ver=$(claude_notice_version "$_cm_file")
      _cm_old_ver=$(claude_md_version "$_cm_file")
      if [ -n "$_cm_notice_ver" ]; then
        # New-style notice file.
        [ "$_cm_notice_ver" != "$CLAUDE_NOTICE_VERSION" ] && _need_restamp=1
      elif [ -n "$_cm_old_ver" ]; then
        # Old-style fat CLAUDE.md — always restamp to migrate to thin notice.
        _need_restamp=1
      fi
    fi
    _contract_file="$_rpath/.clagentic/lite/builder-contract.md"
    if [ -f "$_contract_file" ] && grep -q 'managed-by: clagentic' "$_contract_file" 2>/dev/null; then
      _contract_ver=$(claude_contract_version "$_contract_file")
      [ "$_contract_ver" != "$CLAUDE_CONTRACT_VERSION" ] && _need_restamp=1
    fi
    _vck_wrapper_dir=$(dirname "$_rpath")
    _vck_wrapper_ptr="$_vck_wrapper_dir/.clagentic-project"
    _vck_wrapper_cm="$_vck_wrapper_dir/CLAUDE.md"
    if [ -f "$_vck_wrapper_ptr" ]; then
      # Check wrapper CLAUDE.md version only when it is clagentic-managed.
      if [ -f "$_vck_wrapper_cm" ] && grep -q 'managed-by: clagentic' "$_vck_wrapper_cm" 2>/dev/null; then
        _wcm_ver=$(claude_wrapper_version "$_vck_wrapper_cm")
        [ "$_wcm_ver" != "$CLAUDE_WRAPPER_VERSION" ] && _need_restamp=1
      fi
      # Check wrapper settings.json version independent of wrapper CLAUDE.md —
      # wrappers enrolled before wrapper CLAUDE.md stamping existed have no
      # managed CLAUDE.md but still need hook wiring detected and restamped.
      _vck_wrapper_sj="$_vck_wrapper_dir/.claude/settings.json"
      _wsj_ver=$(claude_wrapper_settings_version "$_vck_wrapper_sj")
      [ "$_wsj_ver" != "$CLAUDE_WRAPPER_SETTINGS_VERSION" ] && _need_restamp=1
    fi
    if [ "$_need_restamp" -eq 1 ]; then
      _would_restamp=1
      _would_restamp_artifacts=1
      # Only auto-stamp when --restamp was not passed; if it was, the force
      # pass below handles all repos uniformly (avoids double-stamp).
      if [ "$RESTAMP" -eq 0 ]; then
        _n=$(_restamp_repo_artifacts "$_rpath" "")
        _restamped=$((_restamped+_n))
      fi
    fi

  done < "$REGISTRY"

  # Interactive prompt: if no artifact (CLAUDE.md/settings) was out of version
  # and --restamp not passed, offer to re-stamp anyway when running on a tty.
  # Uses _would_restamp_artifacts (not _would_restamp) so a shim-only update
  # does not suppress the prompt for CLAUDE.md/settings artifacts.
  if [ "$_would_restamp_artifacts" -eq 0 ] && [ "$RESTAMP" -eq 0 ] && [ -t 0 ] && [ -f "$REGISTRY" ]; then
    _managed_count=0
    while IFS= read -r _rpath; do
      [ -z "$_rpath" ] && continue
      [ -d "$_rpath" ] || continue
      [ -f "$_rpath/CLAUDE.md" ] && grep -q 'managed-by: clagentic' "$_rpath/CLAUDE.md" 2>/dev/null && \
        _managed_count=$((_managed_count+1))
    done < "$REGISTRY"
    if [ "$_managed_count" -gt 0 ]; then
      printf '[clagentic-lite] All %d enrolled repo(s) already at current artifact versions.\n' "$_managed_count"
      printf 'Re-stamp CLAUDE.md notice, builder-contract.md, settings.json, and wrapper CLAUDE.md anyway? [y/N]: '
      read -r _restamp_reply || _restamp_reply=""
      case "$_restamp_reply" in
        y|Y|yes|YES) RESTAMP=1 ;;
      esac
    fi
  fi

  # --restamp pass: force re-stamp all managed artifacts AND shims regardless of version.
  if [ "$RESTAMP" -eq 1 ] && [ -f "$REGISTRY" ]; then
    while IFS= read -r _rpath; do
      [ -z "$_rpath" ] && continue
      [ -d "$_rpath" ] || continue
      # Re-stamp hook shims unconditionally under --restamp.
      _rs_git_dir=$(git -C "$_rpath" rev-parse --git-dir 2>/dev/null || true)
      if [ -n "$_rs_git_dir" ]; then
        case "$_rs_git_dir" in
          /*) _rs_hd="$_rs_git_dir/hooks" ;;
          *)  _rs_hd="$_rpath/$_rs_git_dir/hooks" ;;
        esac
        for _hook in pre-commit pre-push; do
          ENROLL_FORCE=1 stamp_shim "$_hook" "$_rs_hd" && {
            say "re-stamped (--restamp): $_rpath .git/hooks/$_hook"
            _restamped=$((_restamped+1))
          }
        done
      fi
      _n=$(_restamp_repo_artifacts "$_rpath" " (--restamp)")
      _restamped=$((_restamped+_n))
    done < "$REGISTRY"
  fi

  say "update complete (re-stamped $_restamped artifact(s))"
}

# _update_report_or_refresh_config
# lr-25e73e: called from cmd_update BEFORE the no-registry early return
# (config refresh has nothing to do with repo enrollment) — reuses
# _config_key_set / _config_missing_keys (shared with
# _doctor_check_config_drift, above) so this never carries a
# second, divergent notion of "what is a config key" or "what counts as
# missing". No-op paths (missing example, missing/absent config) mirror the
# doctor check's own skip behavior.
_update_report_or_refresh_config() {
  _urrc_example="$SHARE_DIR/config.example"
  [ -f "$_urrc_example" ] || return 0
  [ -f "$GLOBAL_CONFIG" ] || return 0

  _urrc_example_keys=$(_config_key_set "$_urrc_example")
  _urrc_installed_keys=$(_config_key_set "$GLOBAL_CONFIG")
  _urrc_missing=$(_config_missing_keys "$_urrc_example_keys" "$_urrc_installed_keys")
  _urrc_missing_count=$(printf '%s\n' "$_urrc_missing" | sed '/^$/d' | wc -l | tr -d ' ')

  if [ "$_urrc_missing_count" -eq 0 ]; then
    say "global config: all keys from share/config.example present (no drift)"
    return 0
  fi

  if [ "$REFRESH_CONFIG" -eq 1 ]; then
    _append_missing_config_keys "$_urrc_missing" "$_urrc_missing_count"
  else
    printf '[clagentic-lite] WARN: global config at %s is missing %s key(s) present in share/config.example:\n' \
      "$GLOBAL_CONFIG" "$_urrc_missing_count" 1>&2
    printf '%s\n' "$_urrc_missing" | while IFS= read -r _urrc_m; do
      [ -z "$_urrc_m" ] && continue
      printf '  %s\n' "$_urrc_m" 1>&2
    done
    printf 'Run `clagentic-lite update --refresh-config` to append them as commented-out lines (never activated).\n' 1>&2
  fi
}

# _append_missing_config_keys MISSING_KEYS MISSING_COUNT
# lr-25e73e item 3: appends each key in MISSING_KEYS to $GLOBAL_CONFIG, always
# COMMENTED OUT (non-negotiable — see the function this is called from). Only
# ever ADDS lines; never rewrites, reorders, or touches an existing line, so
# user comments/ordering/formatting survive untouched and a malformed or
# unparseable existing line is never an error, just inert content the append
# pass does not look at.
#
# SECRETS: reads $GLOBAL_CONFIG only to extract key NAMES (via _config_key_set,
# which matches up to and including the first '=' and never captures a
# value) and to append fixed template lines pulled from config.example that
# are themselves comments (no value substitution) — no configured VALUE from
# either file is ever read into a shell variable or printed here.
#
# chmod 600 discipline: the temp file is truncated-created (`: >`) then
# chmod 600'd BEFORE any content is written to it, so it is never briefly
# world-readable regardless of umask; content is only appended to
# $GLOBAL_CONFIG itself (never rewritten wholesale here), and $GLOBAL_CONFIG
# is explicitly chmod 600'd again immediately after, matching every other
# write path in this file.
_append_missing_config_keys() {
  _amck_missing="$1"
  _amck_count="$2"
  _amck_example="$SHARE_DIR/config.example"

  # Symlink handling: append to the RESOLVED target, not the link itself, so
  # a config that is a symlink is refreshed the same way $GLOBAL_CONFIG is
  # always read (every consumer here reads/writes through the $GLOBAL_CONFIG
  # path, which the shell/kernel resolve transparently) — no special-casing
  # needed for the append itself, only for the readability/writability probe
  # below, which must check the resolved target, not just link presence.
  if [ ! -w "$GLOBAL_CONFIG" ]; then
    warn "global config at $GLOBAL_CONFIG is not writable — skipping --refresh-config append ($_amck_count key(s) still missing; see above)"
    return 1
  fi

  # Build the append block in a 600 temp file first (never world-readable,
  # even momentarily — via _secret_tmp_create), then append it to the live
  # config in one write.
  _amck_tmp="$GLOBAL_CONFIG.refresh.$$"
  _secret_tmp_create "$_amck_tmp" || { warn "could not chmod 600 temp refresh file — skipping --refresh-config append"; rm -f "$_amck_tmp"; return 1; }

  {
    printf '\n# ---------- appended by `clagentic-lite update --refresh-config` ----------\n'
    printf '# Keys shipped after this config was written, in share/config.example but\n'
    printf '# missing here. COMMENTED OUT — nothing below is active. Uncomment and set\n'
    printf '# a value to opt in to any of these.\n'
  } >> "$_amck_tmp"

  printf '%s\n' "$_amck_missing" | while IFS= read -r _amck_key; do
    [ -z "$_amck_key" ] && continue
    # Pull the key's own line(s) verbatim from config.example: its immediately
    # preceding contiguous comment block (documentation) plus the key's own
    # line (active or already commented), so the appended copy carries the
    # same explanation a fresh `init` would have given the operator. Grep
    # -qxF-style exact key match on the assignment/comment-assignment forms
    # only — no shell eval of file content.
    awk -v key="$_amck_key" '
      BEGIN { active_pat = "^" key "="; comment_pat = "^# ?" key "=" }
      $0 ~ active_pat || $0 ~ comment_pat { print buf $0; buf=""; found=1; next }
      /^#/ { buf = buf $0 "\n"; next }
      /^$/ { buf = ""; next }
      { buf = "" }
      END { if (!found) print "# " key "=" }
    ' "$_amck_example" >> "$_amck_tmp"
    printf '\n' >> "$_amck_tmp"
  done

  # Ensure every appended assignment line is actually commented out,
  # regardless of whether it was active or already-commented in
  # config.example — this is the non-negotiable half of the requirement.
  # A line already starting with '#' is left as-is; an active
  # CLAGENTIC_*=... line gets a leading '# ' inserted. Documentation
  # comment lines (already '#'-prefixed) pass through untouched either way.
  # _amck_tmp.cmt is _secret_tmp_create'd (600 from creation) before the awk
  # output ever reaches it. Content here is pulled only from config.example
  # (the checked-in template — never a live secret value; $_amck_missing
  # carries KEY NAMES only), so this specific site was lower severity than
  # the _write_global_config sites BOBBIE/PEACHES found — but it was still
  # a `command > newfile` on the secrets-adjacent append path PEACHES named
  # directly (amos.code-craft.12, site 3), so it goes through the same
  # sanctioned pattern for consistency rather than being the one exception.
  _amck_cmt="$_amck_tmp.cmt.$$"
  _secret_tmp_create "$_amck_cmt" || { warn "could not chmod 600 comment-pass temp file — skipping --refresh-config append"; rm -f "$_amck_tmp" "$_amck_cmt"; return 1; }
  awk '
    /^CLAGENTIC_[A-Za-z0-9_]*=/ { print "# " $0; next }
    { print }
  ' "$_amck_tmp" >> "$_amck_cmt"
  mv "$_amck_cmt" "$_amck_tmp"

  cat "$_amck_tmp" >> "$GLOBAL_CONFIG"
  chmod 600 "$GLOBAL_CONFIG"
  rm -f "$_amck_tmp"

  say "appended $_amck_count missing key(s) to $GLOBAL_CONFIG as commented-out lines (review and uncomment any you want)"
}

# ---------------------------------------------------------------- show

cmd_show() {
  _show_sub="${1:-}"
  _show_n="${2:-10}"
  # validate _show_n is a positive integer
  case "$_show_n" in
    ''|*[!0-9]*) die "show: N must be a positive integer, got: $_show_n" ;;
  esac

  _show_root="${CLAGENTIC_PROJECT_ROOT:-$PWD}"
  # walk up from _show_root to find a directory containing .clagentic/lite/
  _show_search="$_show_root"
  while [ -n "$_show_search" ] && [ "$_show_search" != "/" ]; do
    if [ -d "$_show_search/.clagentic/lite" ]; then
      _show_root="$_show_search"
      break
    fi
    _show_search="$(dirname "$_show_search")"
  done

  case "$_show_sub" in
    memory)
      _db="$_show_root/.clagentic/lite/memory.db"
      [ -f "$_db" ] || die "show: no memory.db at $_db — is this an enrolled repo?"
      printf '\n=== session memory (last %s) ===\n\n' "$_show_n"
      sqlite3 -separator ' | ' "$_db" \
        "SELECT substr(ts,1,16), source, substr(summary,1,120)
         FROM turns
         ORDER BY CASE source WHEN 'manual' THEN 0 ELSE 1 END, ts DESC
         LIMIT $_show_n;" 2>/dev/null \
        | while IFS= read -r _row; do printf '  %s\n' "$_row"; done
      printf '\n'
      ;;
    gates)
      _db="$_show_root/.clagentic/lite/audit.db"
      [ -f "$_db" ] || die "show: no audit.db at $_db — is this an enrolled repo?"
      printf '\n=== gate runs (last %s) ===\n\n' "$_show_n"
      sqlite3 -separator ' | ' "$_db" \
        "SELECT substr(ts,1,16), gate, outcome, substr(coalesce(details,''),1,80)
         FROM gate_runs
         ORDER BY ts DESC
         LIMIT $_show_n;" 2>/dev/null \
        | while IFS= read -r _row; do printf '  %s\n' "$_row"; done
      printf '\n'
      ;;
    '')
      die "show: subcommand required — use: show memory [N] | show gates [N]"
      ;;
    *)
      die "show: unknown subcommand '$_show_sub' — use: memory | gates"
      ;;
  esac
}

# ---------------------------------------------------------------- export

cmd_export() {
  _export_output=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --output) shift; _export_output="$1" ;;
      *)        _export_output="$1" ;;
    esac
    shift
  done

  _export_root="${CLAGENTIC_PROJECT_ROOT:-$PWD}"
  # walk up from _export_root to find a directory containing .clagentic/lite/
  _export_search="$_export_root"
  while [ -n "$_export_search" ] && [ "$_export_search" != "/" ]; do
    if [ -d "$_export_search/.clagentic/lite" ]; then
      _export_root="$_export_search"
      break
    fi
    _export_search="$(dirname "$_export_search")"
  done

  _mem_db="$_export_root/.clagentic/lite/memory.db"
  _audit_db="$_export_root/.clagentic/lite/audit.db"

  [ -f "$_mem_db" ]   || die "export: no memory.db at $_mem_db — is this an enrolled repo?"
  [ -f "$_audit_db" ] || die "export: no audit.db at $_audit_db — is this an enrolled repo?"

  [ -z "$_export_output" ] && _export_output="$_export_root/.clagentic/lite/report.html"

  # serialize memory rows to JSON via python3
  _mem_json=$(python3 -c "
import sqlite3, json, sys
db = sqlite3.connect(sys.argv[1])
rows = db.execute(
  'SELECT ts, source, summary, tags FROM turns'
  ' ORDER BY CASE source WHEN \"manual\" THEN 0 ELSE 1 END, ts DESC LIMIT 500'
).fetchall()
print(json.dumps([{'ts': r[0], 'source': r[1], 'summary': r[2] or '', 'tags': r[3] or ''} for r in rows]))
db.close()
" "$_mem_db" 2>/dev/null) || _mem_json='[]'

  # serialize gate_runs rows to JSON via python3
  _gates_json=$(python3 -c "
import sqlite3, json, sys
db = sqlite3.connect(sys.argv[1])
rows = db.execute(
  'SELECT ts, gate, outcome, coalesce(details,\"\") FROM gate_runs ORDER BY ts DESC LIMIT 500'
).fetchall()
print(json.dumps([{'ts': r[0], 'gate': r[1], 'outcome': r[2], 'details': r[3]} for r in rows]))
db.close()
" "$_audit_db" 2>/dev/null) || _gates_json='[]'

  _export_ts=$(python3 -c "import datetime; print(datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ'))" 2>/dev/null) || _export_ts="unknown"

  say "export: writing $_export_output"

  # Write HTML to a temp file first, then move into place atomically.
  _export_tmp="${_export_output}.tmp.$$"

  cat > "$_export_tmp" << HTMLEOF
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>clagentic-lite report</title>
<style>
  body { font-family: monospace; background: #1a1a1a; color: #d4d4d4; margin: 0; padding: 1rem 2rem; }
  h1 { font-size: 1.1rem; color: #9cdcfe; margin-bottom: 0.2rem; }
  .meta { font-size: 0.8rem; color: #6a9955; margin-bottom: 1.5rem; }
  .tabs { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
  .tab { padding: 0.3rem 1rem; cursor: pointer; background: #2d2d2d; border: 1px solid #444; color: #d4d4d4; font-family: monospace; font-size: 0.9rem; }
  .tab.active { background: #0e639c; border-color: #0e639c; color: #fff; }
  .panel { display: none; }
  .panel.active { display: block; }
  .controls { margin-bottom: 0.75rem; }
  input[type=text] { background: #2d2d2d; border: 1px solid #555; color: #d4d4d4; padding: 0.3rem 0.6rem; font-family: monospace; font-size: 0.85rem; width: 30rem; }
  .filter-btn { padding: 0.25rem 0.75rem; cursor: pointer; background: #2d2d2d; border: 1px solid #555; color: #d4d4d4; font-family: monospace; font-size: 0.85rem; margin-right: 0.3rem; }
  .filter-btn.active { border-color: #9cdcfe; color: #9cdcfe; }
  table { border-collapse: collapse; width: 100%; font-size: 0.82rem; }
  th { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #555; color: #9cdcfe; }
  td { padding: 0.35rem 0.6rem; border-bottom: 1px solid #2d2d2d; vertical-align: top; white-space: pre-wrap; word-break: break-word; }
  tr:hover td { background: #252526; }
  .src-manual { color: #4ec9b0; }
  .src-stop-hook { color: #6a9955; }
  .outcome-pass { color: #4ec9b0; }
  .outcome-block { color: #f44747; }
  .outcome-skip { color: #808080; }
  .outcome-warn { color: #dcdcaa; }
  .empty { color: #808080; padding: 1rem; }
</style>
</head>
<body>
<h1>clagentic-lite report</h1>
<div class="meta">repo: $_export_root &nbsp;|&nbsp; generated: $_export_ts</div>
<div class="tabs">
  <button class="tab active" onclick="switchTab('memory')">Memory</button>
  <button class="tab" onclick="switchTab('gates')">Gates</button>
</div>

<div id="panel-memory" class="panel active">
  <div class="controls">
    <input type="text" id="mem-search" placeholder="search memory..." oninput="filterMemory()">
  </div>
  <table id="mem-table">
    <thead><tr><th>ts</th><th>source</th><th>summary</th><th>tags</th></tr></thead>
    <tbody id="mem-body"></tbody>
  </table>
</div>

<div id="panel-gates" class="panel">
  <div class="controls">
    <button class="filter-btn active" onclick="filterGates('all',this)">all</button>
    <button class="filter-btn" onclick="filterGates('pass',this)">pass</button>
    <button class="filter-btn" onclick="filterGates('block',this)">block</button>
    <button class="filter-btn" onclick="filterGates('skip',this)">skip</button>
  </div>
  <table id="gates-table">
    <thead><tr><th>ts</th><th>gate</th><th>outcome</th><th>details</th></tr></thead>
    <tbody id="gates-body"></tbody>
  </table>
</div>

<script>
var MEM = $_mem_json;
var GATES = $_gates_json;
var _gatesFilter = 'all';

function esc(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function srcClass(s) {
  if (s === 'manual') return 'src-manual';
  if (s === 'stop-hook' || s === 'summarize-turn') return 'src-stop-hook';
  return '';
}

function outcomeClass(o) {
  if (o === 'pass')  return 'outcome-pass';
  if (o === 'block') return 'outcome-block';
  if (o === 'skip')  return 'outcome-skip';
  if (o === 'warn')  return 'outcome-warn';
  return '';
}

function renderMemory(rows) {
  var tb = document.getElementById('mem-body');
  if (!rows.length) { tb.innerHTML = '<tr><td colspan="4" class="empty">(no rows)</td></tr>'; return; }
  var html = '';
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    html += '<tr><td>' + esc(r.ts) + '</td>'
          + '<td class="' + srcClass(r.source) + '">' + esc(r.source) + '</td>'
          + '<td>' + esc(r.summary) + '</td>'
          + '<td>' + esc(r.tags) + '</td></tr>';
  }
  tb.innerHTML = html;
}

function filterMemory() {
  var q = document.getElementById('mem-search').value.toLowerCase();
  if (!q) { renderMemory(MEM); return; }
  var filtered = MEM.filter(function(r) {
    return (r.summary || '').toLowerCase().indexOf(q) !== -1
        || (r.tags    || '').toLowerCase().indexOf(q) !== -1
        || (r.source  || '').toLowerCase().indexOf(q) !== -1;
  });
  renderMemory(filtered);
}

function renderGates(rows) {
  var tb = document.getElementById('gates-body');
  if (!rows.length) { tb.innerHTML = '<tr><td colspan="4" class="empty">(no rows)</td></tr>'; return; }
  var html = '';
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    html += '<tr><td>' + esc(r.ts) + '</td>'
          + '<td>' + esc(r.gate) + '</td>'
          + '<td class="' + outcomeClass(r.outcome) + '">' + esc(r.outcome) + '</td>'
          + '<td>' + esc(r.details) + '</td></tr>';
  }
  tb.innerHTML = html;
}

function filterGates(outcome, btn) {
  _gatesFilter = outcome;
  var btns = document.querySelectorAll('.filter-btn');
  for (var i = 0; i < btns.length; i++) btns[i].classList.remove('active');
  if (btn) btn.classList.add('active');
  var rows = outcome === 'all' ? GATES : GATES.filter(function(r) { return r.outcome === outcome; });
  renderGates(rows);
}

function switchTab(name) {
  var tabs = document.querySelectorAll('.tab');
  var panels = document.querySelectorAll('.panel');
  for (var i = 0; i < tabs.length; i++) tabs[i].classList.remove('active');
  for (var i = 0; i < panels.length; i++) panels[i].classList.remove('active');
  var idx = name === 'memory' ? 0 : 1;
  tabs[idx].classList.add('active');
  document.getElementById('panel-' + name).classList.add('active');
}

renderMemory(MEM);
renderGates(GATES);
</script>
</body>
</html>
HTMLEOF

  mv "$_export_tmp" "$_export_output"
  say "export complete: $_export_output"
  say "open with: open $_export_output  (macOS) or xdg-open $_export_output  (Linux)"
}

# ---------------------------------------------------------------- dispatch

# Trust-gated repo-local config load (_cli_maybe_load_repo_env, above) —
# called ONCE here, before the subcommand case below, for every subcommand
# that stays in this process and might read a repo-scoped CLAGENTIC_* value
# for the enrolled repo at cwd. `init` and `enroll` are the deliberate
# exceptions (see _cli_maybe_load_repo_env's own docstring for why enroll
# specifically must not load it); recall/remember/gates exec into
# memory.sh/gates.sh, which load it themselves via the unchanged combined
# ds_load_env — calling it here too would be a harmless but pointless
# second (idempotent) load, so it is skipped for those to keep this call
# scoped to the subcommands that actually need it in THIS process.
case "${1:-}" in
  init|enroll|recall|remember|gates) : ;;
  *) _cli_maybe_load_repo_env ;;
esac

case "${1:-}" in
  init)     shift; cmd_init "$@" ;;
  enroll)   shift; cmd_enroll "$@" ;;
  unenroll) shift; cmd_unenroll "$@" ;;
  list)     cmd_list ;;
  doctor)   cmd_doctor ;;
  rotate)   cmd_rotate ;;
  update)   shift; cmd_update "$@" ;;
  recall)
    # recall <keywords...>  — search session memory for matching summaries.
    # Thin dispatch to scripts/memory.sh recall; honors CLAGENTIC_RECALL_LIMIT
    # and CLAGENTIC_RECALL_MAX_CHARS.
    shift
    exec "$SCRIPTS_DIR/memory.sh" recall "$@"
    ;;
  remember)
    # remember "<note>" [tags]  — store a manual memory entry.
    # Thin dispatch to scripts/memory.sh log-turn with source='manual'.
    # Does NOT add new plumbing; 'manual' source is already supported.
    shift
    if [ $# -eq 0 ]; then
      printf 'usage: clagentic-lite remember "<note>" [tags]\n' 1>&2
      exit 1
    fi
    _note="$1"; shift
    _tags="${*:-}"
    exec "$SCRIPTS_DIR/memory.sh" log-turn "$_note" "$_tags" "manual"
    ;;
  show)   shift; cmd_show "$@" ;;
  export) shift; cmd_export "$@" ;;
  gates)
    # gates <subcmd> [args...]  — proxy to the gate orchestrator.
    # gates.sh lives in CLAGENTIC_LITE_HOME/scripts/ and is not on PATH, so all
    # enrolled-repo command docs and CLAUDE.md files route through this
    # subcommand rather than referencing the bare scripts/ relative path.
    shift
    # lr-bdddcf: gates.sh is exec'd as a script here, never sourced. An
    # ambiently exported CLAGENTIC_GATES_SOURCE_ONLY (e.g. from a
    # developer's shell profile) would otherwise reach gates.sh's own
    # fail-closed check and abort this subcommand instead of running the
    # requested gate.
    unset CLAGENTIC_GATES_SOURCE_ONLY CLAGENTIC_GATES_DELIBERATE_SOURCE
    exec "$SCRIPTS_DIR/gates.sh" "$@"
    ;;
  "")
    printf 'usage: clagentic-lite <subcommand> [args]\n'
    printf 'subcommands: init, enroll, unenroll, list, doctor, rotate, update [--restamp] [--refresh-config], recall, remember, show, export, gates\n'
    exit 1
    ;;
  *)
    printf 'clagentic-lite: unknown subcommand: %s\n' "$1" 1>&2
    printf 'usage: clagentic-lite <subcommand> [args]\n'
    printf 'subcommands: init, enroll, unenroll, list, doctor, rotate, update [--restamp] [--refresh-config], recall, remember, show, export, gates\n'
    exit 1
    ;;
esac
