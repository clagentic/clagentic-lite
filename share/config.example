# clagentic-lite — global config template.
# Written to ~/.config/clagentic/lite/config by `clagentic-lite init`.
# Per-repo .clagentic/config is OPTIONAL and SPARSE — only override keys.
# Load order at gate-run time: global config → per-repo .clagentic/config → env vars.
#
# TIMING: a repo-local .clagentic/config does not take effect until AFTER
# the repo has been enrolled — it is not read during the very first
# `clagentic-lite enroll` call on that repo, only from the next invocation
# onward (doctor, update, a re-enroll, or a hook firing on your next
# commit). This is deliberate: the CLI will not execute a repo's own
# config before that repo is enrolled/trusted. The global config above is
# unaffected and applies at enroll time as normal.
#
# Per-role contract: each role has its own primary CLI+model and an ordered
# fallback chain. The chain is walked left-to-right when the primary fails
# (non-zero exit, parse failure, timeout). Each entry is "cmd:tier" where
# tier resolves to a concrete model via the CLAGENTIC_MODEL_* table below.
#
# Roles are independent. Codex does not implicitly fall back to Claude (or
# vice versa) — every fallback step is something you wrote down on purpose.

# ---------- config schema version ----------
# Set automatically by `clagentic-lite init` (or `init --reconfigure`) to the
# CONFIG_SCHEMA_VERSION constant in bin/clagentic-lite at write time. Records
# which schema this file was materialized from — a plain `update` never
# touches this file's key set; run `update --refresh-config` to append any
# missing keys (always commented out) without losing your customizations, or
# `init --reconfigure` to merge in new keys while preserving every value you
# have already set. Do not hand-edit this line.
CLAGENTIC_CONFIG_SCHEMA_VERSION=

# ---------- tool home ----------
# Set automatically by `clagentic-lite init`. Edit only if you move the install.
# CLAGENTIC_HOME is the deprecated name — still honored with a one-time warning for
# back-compat. Migrate to CLAGENTIC_LITE_HOME.
CLAGENTIC_LITE_HOME=

# ---------- model tier table ----------
# Resolve symbolic tier names to concrete model strings for each CLI.
# This is the only place model version literals live. Agent files and the
# wrapper script reference tier names only.
#
# Format: CLAGENTIC_MODEL_<CLI>_<TIER>=<model-id-for-that-cli>
# Tiers (suggested): flagship, default, cheap
#
# Claude tiers
CLAGENTIC_MODEL_CLAUDE_FLAGSHIP=opus
CLAGENTIC_MODEL_CLAUDE_DEFAULT=sonnet
CLAGENTIC_MODEL_CLAUDE_CHEAP=haiku
#
# Codex tiers — by default, intentionally left blank so codex uses whatever
# model is configured in ~/.codex/models.json (the live runtime tier map).
# That file is the canonical source; clagentic-lite reads it automatically via
# resolve_step. Do not hardcode model version strings here — they rot silently
# when OpenAI renames models. Update ~/.codex/models.json instead.
#
# Tier name alignment: ~/.codex/models.json uses "flagship", "mini", "spark".
# clagentic-lite resolves "default" → default_tier in models.json, and looks
# up "mini"/"spark" directly. Env vars win if set, so you can override a
# specific tier without touching models.json:
# CLAGENTIC_MODEL_CODEX_FLAGSHIP=<specific-model-id>
# CLAGENTIC_MODEL_CODEX_MINI=<specific-model-id>
# CLAGENTIC_MODEL_CODEX_SPARK=<specific-model-id>
# CLAGENTIC_MODEL_CODEX_CHEAP=<same-as-spark, for legacy :cheap chains>
#
# Add more CLI tables here if you point a role at a different CLI.
# Example for a local ollama-backed entry:
# CLAGENTIC_MODEL_OLLAMA_DEFAULT=llama3.1:8b

# ---------- roles ----------
# Each role: PRIMARY (cmd + tier) and CHAIN (comma-separated cmd:tier list).
# Empty CHAIN means "no fallback — fail to degraded envelope on primary failure".

# Builder = primary author. Most edits go through this.
CLAGENTIC_BUILDER_CMD=claude
CLAGENTIC_BUILDER_TIER=default
CLAGENTIC_BUILDER_CHAIN=codex:default,claude:flagship

# Reviewer = cross-vendor reviewer. A different CLI from Builder is recommended;
# `clagentic-lite init` warns when they match.
# Tier names in chains: use flagship/mini/spark for codex (matching models.json),
# or flagship/default/cheap for claude. Both work; models.json names are canonical
# for codex since that file is the live source of model strings.
CLAGENTIC_REVIEWER_CMD=codex
CLAGENTIC_REVIEWER_TIER=flagship
CLAGENTIC_REVIEWER_CHAIN=claude:default,codex:flagship

# Auditor = LLM narration on top of deterministic scans (gitleaks/semgrep/osv).
# The Auditor never gates. Local tools own the security path.
CLAGENTIC_AUDITOR_CMD=codex
CLAGENTIC_AUDITOR_TIER=flagship
CLAGENTIC_AUDITOR_CHAIN=claude:default

# Merge-gate = final pre-merge sanity check. Reads all green-gate output,
# either approves or refuses. Never opens a PR, never pushes.
CLAGENTIC_GATE_CMD=claude
CLAGENTIC_GATE_TIER=default
CLAGENTIC_GATE_CHAIN=codex:flagship

# Summarizer = cheap model used for per-turn Stop-hook summaries.
# Uses :spark (codex) / :cheap (claude) — the lightest available tier.
CLAGENTIC_SUMMARIZER_CMD=claude
CLAGENTIC_SUMMARIZER_TIER=cheap
CLAGENTIC_SUMMARIZER_CHAIN=codex:spark

# ---------- role enforcement ----------
# By default, when every step in a role's chain fails, the wrapper emits a
# "degraded" envelope (parseable output, non-blocking) and the gate continues.
# Set CLAGENTIC_<ROLE>_REQUIRED=1 to make full-chain failure a hard error
# (non-zero exit, gate blocks). Use this when the cross-vendor property is
# non-negotiable: e.g. setting CLAGENTIC_REVIEWER_REQUIRED=1 ensures a
# same-vendor fallback is a detectable gate failure rather than a silent
# degradation. ROLE names: BUILDER, REVIEWER, AUDITOR, GATE, SUMMARIZER.
# CLAGENTIC_REVIEWER_REQUIRED=0
# CLAGENTIC_AUDITOR_REQUIRED=0
# CLAGENTIC_GATE_REQUIRED=0

# ---------- gates ----------
# Comma-separated list of gates to run on /ship. Omit to run all.
# Available: secrets,deps,sast,review,adversarial,merge-gate
CLAGENTIC_GATES=secrets,deps,sast,review,adversarial,merge-gate

# Severity threshold for blocking on /review findings.
# Values: low | medium | high | critical
CLAGENTIC_BLOCK_SEVERITY=high

# Space-separated directory paths to exclude from osv-scanner (v2.x only, passed as
# --experimental-exclude per entry). Use for demo fixtures, vendored examples, or dirs
# that are not deployed. Paths are relative to the repo root.
# CLAGENTIC_OSV_EXCLUDE=examples vendor

# osv-scanner severity threshold. Only vulnerabilities at this level or above block the gate.
# Options: CRITICAL, HIGH, MEDIUM, LOW. Default: CRITICAL. Newer osv-scanner
# releases expose severity in JSON; clagentic-lite applies this threshold locally.
# Set to LOW to restore the original block-on-any-finding behavior.
CLAGENTIC_OSV_SEVERITY=CRITICAL

# Stop-hook debounce: only summarize after N seconds of quiet.
CLAGENTIC_SUMMARIZE_DEBOUNCE_SEC=20

# Disable memory recall injection entirely (UserPromptSubmit hook).
CLAGENTIC_DISABLE_RECALL=0

# Disable FTS5 full-text search for recall and force the LIKE fallback.
# Set =1 on platforms where SQLite was compiled without FTS5 (rare; most SQLite
# builds since 2015 include it), or if you prefer the simpler LIKE behavior.
# When unset or 0, recall uses FTS5 MATCH for filtering if turns_fts exists,
# falling back to LIKE silently when FTS5 is unavailable.
# CLAGENTIC_DISABLE_FTS=0

# Disable on-disk handoff frame: Stop hook will not write .clagentic/lite/handoff.md
# and SessionStart hook will not inject it. Set =1 if you prefer auto-compact only,
# or if the handoff file is causing noise in your workflow.
CLAGENTIC_DISABLE_HANDOFF=0

# Minimum keyword count required to trigger recall injection (UserPromptSubmit hook).
# If fewer than this many keywords survive prompt extraction (after stopword filtering
# and dedup), injection is skipped entirely for that turn. Gating is on the count of
# the user's own prompt tokens — not on any corpus-derived score — so the SQL query,
# result set, and ORDER BY are unchanged when the gate allows injection.
# Raise to suppress noisy injection on short or low-signal prompts (e.g. "ok", "yes").
# CLAGENTIC_RECALL_MIN_KEYWORDS=2

# Suppress the session-start update alert (set =1 if you manage updates manually
# or the network fetch is unwanted — e.g. air-gapped environments). Left unset
# (commented out) by default, not =0 — an explicit "0" here was harmless
# (the guard only checks for "1") but meant every fresh install carried this
# var in its config from day one, which is why it went unscrutinized for so
# long (lr-716012).
# CLAGENTIC_SKIP_UPDATE_ALERT=0

# `clagentic-lite update` non-tty safety (lr-55a27a). When CLAGENTIC_LITE_HOME
# has uncommitted changes and update runs non-interactively (CI, a script, or
# any agent invocation — every automated caller is non-tty), update now
# REFUSES by default rather than silently discarding them via `git stash
# push` + `git stash drop` (a sequence that destroys working-tree content
# irrecoverably and leaves no reflog entry once dropped). Set =1 only if
# CLAGENTIC_LITE_HOME is a genuinely disposable install directory you are
# comfortable having discarded automatically on every unattended update.
# Never set this in a config that CLAGENTIC_LITE_HOME might resolve to a
# real development checkout (see the bootstrap block at the top of
# bin/clagentic-lite for how CLAGENTIC_LITE_HOME can get repointed).
# CLAGENTIC_UPDATE_ALLOW_DISCARD=0

# Context-budget monitor (PostToolUse hook).
# Estimates token cost of each tool result (4 bytes ≈ 1 token) and warns via
# additionalContext when a single result or the cumulative session total crosses
# the configured threshold. Totals are persisted in audit.db (context_budget table).
# Set CLAGENTIC_DISABLE_BUDGET=1 to opt out entirely.
# CLAGENTIC_DISABLE_BUDGET=0
# CLAGENTIC_RESULT_TOKEN_WARN=8000    # warn if a single tool result exceeds ~N tokens (default 8000, ~32 KB)
# CLAGENTIC_SESSION_TOKEN_WARN=50000  # warn if cumulative session tool output exceeds ~N tokens (default 50000, ~200 KB)

# Auto-summarize large tool results (PostToolUse hook).
# When a tool result exceeds the byte threshold, pipes it through the Summarizer
# role (llm-client.sh) and stores a digest in memory.db. Emits the first 100
# chars of the digest as additionalContext so the session sees a summary hint.
# The LLM call is best-effort with a 10-second timeout; any failure is silent.
# Set CLAGENTIC_DISABLE_AUTOSUMMARIZE=1 to opt out entirely.
# CLAGENTIC_AUTOSUMMARIZE_BYTES=32768  # auto-summarize tool results larger than N bytes (default 32768 = 32KB)
# CLAGENTIC_DISABLE_AUTOSUMMARIZE=0    # set to 1 to disable auto-summarize

# Memory recall row limit: max turns returned by recall (default 5).
# CLAGENTIC_RECALL_LIMIT=5

# Memory recall char budget: total chars injected per recall call (default 1500).
# Whole rows are dropped when the budget would be exceeded — no mid-row splits.
# CLAGENTIC_RECALL_MAX_CHARS=1500

# Memory row cap: oldest rows beyond this limit are pruned after each INSERT (default 5000).
# Housekeeping is opportunistic and silent — no scheduler, no daemon, one DELETE.
# CLAGENTIC_MEMORY_MAX_ROWS=5000

# Per-LLM-call timeout (seconds). Hung CLI → step failure → chain advances.
CLAGENTIC_LLM_TIMEOUT_SEC=180

# Input-size-proportional timeout scaling. When CLAGENTIC_LLM_TIMEOUT_AUTO_SCALE=1
# (the default), the per-call timeout is computed as:
#   timeout = BASE + ceil(input_bytes / BYTES_PER_SEC), capped at MAX_SEC.
# This prevents 180s from firing on very large diffs (200 KB+) while keeping
# short calls at the base timeout. Set AUTO_SCALE=0 to disable and use BASE only.
# BYTES_PER_SEC is ~300 B/s conservatively calibrated for large review diffs:
# a 156KB diff produces ceil(156251/300)=521s budget beyond the 180s base (701s total,
# well within MAX). The old default (500) timed out on that diff at 493s.
CLAGENTIC_LLM_TIMEOUT_MAX_SEC=1800
CLAGENTIC_LLM_TIMEOUT_BYTES_PER_SEC=300
CLAGENTIC_LLM_TIMEOUT_AUTO_SCALE=1
# Per-role overrides (optional — takes precedence over the global BASE/MAX):
# CLAGENTIC_REVIEWER_TIMEOUT_SEC=240
# CLAGENTIC_REVIEWER_TIMEOUT_MAX_SEC=1800  # per-role override; global max is now 1800

# Claude invocation surface: by default the wrapper does NOT pass --bare,
# because --bare disables OAuth/keychain reads and requires ANTHROPIC_API_KEY.
# Set =1 only if you authenticate Claude via API key — the --bare invocation
# is slightly tighter (skips hooks/auto-memory) but unusable on OAuth setups.
CLAGENTIC_CLAUDE_BARE=0

# Merge Gate: blocking by default. Set to 0 to make it advisory (the gate
# still runs and logs, but a 'refuse' decision won't stop /ship).
CLAGENTIC_MERGE_GATE_BLOCKING=1

# Fail-closed overrides for missing deterministic security tools. The default
# is to BLOCK if the tool isn't installed (the gate can't run, so it can't
# pass). Set =1 only when you've deliberately chosen to run without it.
CLAGENTIC_ALLOW_MISSING_GITLEAKS=0
CLAGENTIC_ALLOW_MISSING_OSV=0
CLAGENTIC_ALLOW_MISSING_SEMGREP=0

# SAST baseline-scoping fetch/freshness timeout (seconds). Bounds both the
# `git fetch origin <default-branch>` and the `git ls-remote` freshness
# check cmd_sast uses to resolve a trustworthy --baseline-commit (lr-06b87e).
# Expiry is treated identically to a fetch failure: falls back to a
# full-tree semgrep scan, which still blocks on findings. An unreachable
# remote (offline/air-gapped) always falls back to full-tree regardless of
# this value -- raising the timeout only helps a fetch that would otherwise
# eventually succeed.
CLAGENTIC_SAST_FETCH_TIMEOUT_SEC=30

# SQLite busy-retry timeout (milliseconds) for every sqlite3 call against
# .clagentic/lite/audit.db (ds_sqlite3, scripts/platform.sh, lr-c71845).
# When two gate runs write to audit.db at the same moment, the second writer
# retries for up to this many milliseconds instead of failing immediately
# with SQLITE_BUSY. Non-numeric, empty, or zero falls back to the default.
CLAGENTIC_SQLITE_BUSY_TIMEOUT_MS=5000

# Strict preflight: make `clagentic-lite init` exit non-zero if any required
# tool is missing. Off by default so scripted init runs don't fail spuriously.
CLAGENTIC_STRICT_PREFLIGHT=0

# ---------- repo host ----------
# github | gitlab | gitea | none
CLAGENTIC_REPO_HOST=github

# Default branch (assumed protected — writes blocked by pre-write-guard).
CLAGENTIC_DEFAULT_BRANCH=main

# ---------- security gate bypass controls ----------
# These vars let you work around pre-existing issues without modifying harness
# source code. Use config, not code edits. See docs/GATES.md for context.

# Comma-separated bash-guard rule IDs to skip (e.g. R-005,R-011).
# Only use for rules that conflict with legitimate workflows in your project.
# Unset means no rules are skipped.
# CLAGENTIC_ALLOW_BASH_RULES=

# Allow writes to the default branch (disables W-001 in pre-write-guard).
# Only set this if you are intentionally working directly on the default branch.
# CLAGENTIC_ALLOW_DEFAULT_BRANCH_WRITE=1

# Skip the staleness check on gate output files (last-review.json,
# last-adversarial.md). Use when artifacts were produced in a prior CI step
# or an air-gapped environment where the files are known-fresh despite a
# HEAD SHA mismatch (e.g. the gate ran on the same diff in a different
# working tree). Without this flag, build_gate_summary refuses to feed a
# stale payload to the merge-gate LLM.
# CLAGENTIC_ALLOW_STALE_PAYLOAD=1

# ---------- reviewer-consulted deferrals ----------
# File: .clagentic/deferrals.json in the enrolled repo (gitignored — already
# under .clagentic/ which gates.sh gitignores, so no extra config needed).
#
# When present, every deferral object is first reduced to ONLY the nine
# documented schema fields below — any other key is DROPPED entirely, not
# forwarded in any form (see _llm_json_array_allowlist_fields in
# scripts/platform.sh) — then each surviving field is sanitized (control
# bytes stripped, forged fence-label markers defanged — see
# _llm_json_array_sanitize_fields, same file) and injected, fenced as data,
# into the reviewer system prompt before the diff is reviewed.
#
# lr-2ebc41: an entry with scope "stable-contract" and a valid file_sha256
# is ALSO mechanically re-checked in gate code (severity_blockers(),
# scripts/gates.sh) after the reviewer responds — matching on (file,
# category, message) and requiring the named file's current content hash to
# still equal file_sha256. That check does not depend on the model's
# compliance: it excludes a matching finding from the block count whether or
# not the model itself also chose to honor the deferral. An entry WITHOUT
# scope "stable-contract" behaves exactly as before lr-2ebc41 — suppression
# happens inside model reasoning only, the gate does not post-filter it.
# Treat this file as untrusted, external text even though it is
# operator-facing: gitignored means untracked and unreviewed, not
# write-restricted, and an attacker who can write this file could otherwise
# smuggle an arbitrary extra key (or a non-string value under a real key
# name) past a sanitizer that only inspects the fields it is told to look at.
#
# Fail-open (prompt path): if the file is absent, empty, or unreadable, the
# review proceeds as if no deferrals exist. Fail-closed (gate-code path,
# lr-2ebc41): anything ambiguous, malformed, or unhashable about a
# stable-contract entry retains the finding as blocking rather than
# suppressing it — see docs/GATES.md "Gate-code deferral enforcement".
#
# Schema (JSON array):
# [
#   {
#     "id": "def-001",              # stable identifier (required)
#     "category": "sql",            # finding category this applies to (optional)
#     "file": "scripts/seed.sh",    # exact path this applies to (required for gate-code matching)
#     "message": "...",             # the Reviewer finding's own message, VERBATIM (required for gate-code matching — the match key)
#     "description": "...",         # human-readable reason (required)
#     "expires": "2026-12-31",      # ISO date — LLM reasons about expiry; gate does not parse (optional)
#     "acknowledged_by": "you",     # who approved the deferral (optional)
#     "scope": "stable-contract",   # ONLY supported value for gate-code matching; omit for prompt-context-only (optional)
#     "file_sha256": "abc123..."    # sha256 of `file`'s content at grant time; required when scope is set (optional otherwise)
#   }
# ]
#
# The `expires` field is passed verbatim to the LLM. The gate does not compute
# or enforce expiry dates — the LLM reasons about whether the deferral is still
# valid given its expiry and the diff under review. `expires` is unrelated to
# the gate-code lapse mechanism, which is `file_sha256` freshness only.
#
# Lint an existing file (refuses loudly on a malformed stable-contract entry):
#   clagentic-lite gates deferrals-lint
#
# Deferrals vs. accepted-risks.md:
#   accepted-risks.md  — architectural risk decisions; read by the merge-gate
#                        (Gate 6); deterministic gate plumbing post-filters.
#   deferrals.json     — operator guidance injected into the reviewer prompt
#                        (Gate 3); LLM-judgment-only unless scope is
#                        "stable-contract", in which case gate code also
#                        mechanically enforces it (lr-2ebc41).
# No new env var is needed — the feature is always active when the file exists.

# ---------- cross-round finding dedup ----------
# Default-on: suppress findings already reported in a prior review round when the
# relevant diff lines are unchanged since. Key strategy is content-hash (sha256
# of a 5-line context window), so the key survives line shifts. Default: on (1).
# Seen-keys are persisted in .clagentic/lite/review-seen-keys (gitignored).
# Reset with: clagentic-lite gates review --reset-dedup
# Set =0 to opt out and see all findings on every round.
# CLAGENTIC_CROSS_ROUND_DEDUP=1

# ---------- cross-round finding recurrence demotion ----------
# Second use of the same content-hash key space as cross-round dedup, above
# (finding_content_keys, scripts/review-merge.sh): instead of only testing
# "have we seen this key before" (dedup's boolean membership check), this
# tracks HOW MANY rounds a finding's key has been reported in. Persisted
# counts: .clagentic/lite/review-recurrence.json (gitignored, key -> integer
# count, same directory convention as review-seen-keys and invariants.json).
#
# A finding that recurs at or above the configured threshold (default 2 --
# "reported before AND reported again") is DEMOTED to advisory: it is
# excluded from severity_blockers()' block count but stays fully visible in
# the review findings array, cmd_render_review's terminal output ("reported
# N rounds running — decide"), and the audit trail (gate='review-recurrence'
# row with demoted:N threshold:T). This is a THRESHOLD change, never
# suppression — nothing is hidden or dropped, only whether it can gate /ship
# on its own.
#
# Runs only when CLAGENTIC_CROSS_ROUND_DEDUP=1 (the same flag gates both —
# recurrence tracking depends on the same per-round content-hash-keying pass
# dedup already performs on the diff). `gates review --reset-dedup` clears
# BOTH review-seen-keys AND review-recurrence.json, so a reset means "treat
# every finding as fresh" in both senses (not suppressed AND not
# recurrence-demoted).
#
# Conservative bias, same posture as cross-round dedup: a finding whose
# content-hash key cannot be computed (empty key, no diff window, no sha256
# tool) is retained and never demoted; a splice failure or missing JSON tool
# leaves the review output untouched (full passthrough).
#
# CLAGENTIC_RECURRENCE_THRESHOLD=2

# ---------- review ledger (lr-01ae73) ----------
# Append-only, per-branch history of every `gates.sh review` verdict:
# base_sha, head_sha, pass/block/unanchored outcome, structured findings,
# timestamp, and the gate config in effect. File:
# .clagentic/lite/review-ledger.jsonl (gitignored, JSON-Lines, one entry per
# line, oldest first). Always on -- there is no opt-out flag, since the
# ledger is what makes a review verdict anchored to a specific commit state
# at all (see docs/GATES.md "Review ledger and anchored verdicts").
#
# Cap the number of retained entries PER BRANCH (oldest dropped first).
# Unset/0 (default) means unlimited -- the ledger exists to make finding
# recurrence and verdict history visible across a branch's full review
# lifetime, so unbounded is the correct default for most repos; set this on
# a repo with unusually long-lived branches and many review rounds.
# CLAGENTIC_LEDGER_MAX_PER_BRANCH=0

# ---------- adversarial invariant-feed ----------
# File: .clagentic/lite/invariants.json in the enrolled repo (gitignored —
# already under .clagentic/lite/, same convention as last-review.json,
# review-seen-keys, and audit.db).
#
# When present AND CLAGENTIC_ADVERSARIAL_INVARIANTS=1, the file is injected
# verbatim into the adversarial (Auditor) system prompt before the diff is
# analyzed, with an instruction to verify the diff against each invariant —
# the inverse of the reviewer deferrals injection above ("must still hold and
# be re-checked" instead of "already reviewed, do not re-report"). This gives
# the adversarial pass forward-invariant memory across rounds: findings
# resolved in an earlier round become invariants the Auditor actively checks
# for reintroduction, including at a wider scope than where they were
# originally fixed.
#
# Opt-in default: off (0). Set =1 to enable.
# CLAGENTIC_ADVERSARIAL_INVARIANTS=0
#
# Fail-open: if the file is absent, empty, or unreadable, the adversarial
# pass proceeds as if no invariants exist. The gate never blocks on a missing
# invariants file — the adversarial pass is non-blocking by design regardless.
#
# Schema (JSON array):
# [
#   {
#     "id": "inv-001",                    # stable identifier (required)
#     "category": "security",             # finding category (optional)
#     "file": "scripts/example.sh",       # exact path or path glob (optional)
#     "statement": "..."                  # the invariant to verify (required)
#   }
# ]
#
# Population is automatic (lr-63359e). When a finding resolves -- present in
# one round's findings, absent from the next round's on the same content-hash
# key the review/adversarial cross-round dedup machinery already tracks --
# the writer distills its message+category into an invariant line and appends
# it to the file. Dedupes on (file, statement) at append time and caps total
# entries at CLAGENTIC_INVARIANT_FEED_MAX (default 200, oldest dropped first)
# so the feed's own storage cannot grow unboundedly. See docs/GATES.md
# "Invariant-feed writer" for the full resolve-signal mechanics.
# CLAGENTIC_INVARIANT_FEED_MAX=200

# Per-field length cap (chars) applied at the write boundary, before a
# category/file/statement field is written to invariants.json (lr-cda4b9).
# All three fields trace back to adversarial/review LLM finding text, so this
# guards against a single planted finding ballooning invariants.json or the
# prompt it is later re-injected into. Truncates rather than drops the entry.
# CLAGENTIC_INVARIANT_FEED_MAX_FIELD_CHARS=500

# ---------- chunked review ----------
# Opt-in diff chunking for the review gate. When enabled (=1) and the diff
# exceeds the threshold, the diff is split into chunks and reviewed per-chunk.
# Per-chunk audit rows use gate='review-chunk'. A merged envelope is assembled
# from all chunks and stamped as the final last-review.json output.
# Warning: N chunks = N LLM calls. For large diffs this can be costly.
# Opt-in default: off (0). Enable when single-pass review times out on very
# large diffs where per-chunk context is sufficient.
# CLAGENTIC_REVIEW_CHUNKING=1

# Chunking threshold in bytes. When CLAGENTIC_REVIEW_CHUNKING=1 and the diff
# is larger than this value, the chunking path is taken. Default: 262144 (256 KB).
# CLAGENTIC_REVIEW_CHUNK_BYTES=262144

# Operator-facing alias for the chunking threshold (in KB, not bytes).
# When set, overrides CLAGENTIC_REVIEW_CHUNK_BYTES. Use whichever unit is more
# natural for your workflow.
# CLAGENTIC_REVIEWER_MAX_DIFF_KB=256

# ---------- smoke test ----------
# CLAGENTIC_SMOKE_NO_LLM=1
# When set, smoke.sh skips live LLM calls and substitutes a stub JSON envelope.
# Use for in-session smoke runs or CI environments without LLM access.
# Default: unset (live LLM calls enabled).

# ---------- clagentic-router integration (optional) ----------
# Opt-in only. Both keys unset (the default) is byte-for-byte identical to a
# checkout without this section: no settings.json env block is stamped, no
# doctor probe runs, no agent frontmatter is touched. See README.md
# "Optional: clagentic-router integration" for the full setup walkthrough and
# docs/DESIGN.md for why the interactive Agent-tool dispatch path needs a
# router at all (the gap `CLAGENTIC_<ROLE>_CMD` alone cannot close).
#
# clagentic-router (github.com/clagentic/clagentic-router) is a separate,
# optionally-run local proxy. It is not started, installed, or required by
# clagentic-lite — you run it yourself if you want this integration.
#
# CLAGENTIC_ROUTER_URL: base URL of a running clagentic-router instance,
# e.g. http://127.0.0.1:8765. When set, `clagentic-lite enroll`/`update`
# stamps an `env` block into the enrolled repo's .claude/settings.json
# (ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN) so an INTERACTIVE Claude Code
# session — not just gate-path LLM calls — routes through it. This is the
# only channel that reaches the interactive session: clagentic-lite is not
# Claude Code's parent process, so exporting the var at shell-startup time
# reaches nothing.
#
# VALIDATED before it is ever stamped or probed (bin/clagentic-lite,
# _validate_router_url / _router_url_classify): this value is a
# traffic-interception primitive — it redirects the entire Claude Code
# session, and in the router's passthrough mode your real Anthropic
# credentials are forwarded to whatever host it names. A malformed value
# (not a well-formed http:// or https:// URL) is REFUSED at enroll/update
# time rather than silently stamped — a bad value here breaks every session
# opened against the enrolled repo, so failing loudly at stamp time is far
# cheaper than debugging that later. A well-formed but NON-LOCAL host
# (anything other than exactly localhost/0.0.0.0/a real 127.0.0.0/8 address/
# ::1 or [::1]) is allowed but WARNED loudly at both stamp time and every
# `doctor` run, naming exactly what gets forwarded — the router is designed
# to run locally, but someone legitimately running it on another LAN box is
# not wrong, only unusual enough to deserve an unmissable flag rather than a
# silent accept.
#
# The host check is structural, not string-matched: RFC 3986 userinfo
# (user:pass@ before the real host) is stripped before the host is ever
# read, and 127.0.0.0/8 membership is a real numeric-octet-range check, not
# a "starts with 127." prefix test -- both "http://127.0.0.1:x@evil.com/"
# and "http://127.0.0.1.evil.com/" correctly classify as the non-local host
# evil.com, not as local. Any host shape this check does not confidently
# recognize (IPv4-mapped IPv6 such as [::ffff:127.0.0.1], octal/decimal/hex
# IP encodings) is classified non-local rather than guessed at -- a false
# "non-local" costs one warning line, a false "local" would silently
# forward real credentials, so ambiguity always resolves toward the warning.
# CLAGENTIC_ROUTER_URL=http://127.0.0.1:8765

# CLAGENTIC_ROUTER_TOKEN: router inference token. Sent as
# `Authorization: Bearer <token>` (ANTHROPIC_AUTH_TOKEN in the stamped
# settings.json env block) — clagentic-router's routed-mode auth accepts
# either that header or `x-api-key`; Claude Code sends the Bearer form for
# ANTHROPIC_AUTH_TOKEN, so that is the variable clagentic-lite stamps. Must
# match the `proxy.token` / CLAGENTIC_ROUTER_TOKEN the router itself was
# started with (router.example.yaml, clagentic-router repo). Required
# whenever CLAGENTIC_ROUTER_URL is set to a routed-mode chain (role:*); the
# router's own passthrough mode does not check this token, but clagentic-lite
# always stamps it when present so routed roles (reviewer/auditor by default)
# work without a second manual step.
# CLAGENTIC_ROUTER_TOKEN=

# CLAGENTIC_ROUTER_INJECT_AGENT_MODEL: separate opt-in, OFF by default even
# when CLAGENTIC_ROUTER_URL is set. Setting CLAGENTIC_ROUTER_URL alone gets
# you the settings.json env-block passthrough and the doctor probe with zero
# additional risk. This second key additionally renders a per-role-injected
# copy of the reviewer/auditor/merge-gate subagent definitions (model:
# role:<role>-chain in frontmatter, chain names matching clagentic-router's
# router.example.yaml) and installs THAT rendered plugin instead of the
# checked-in one — checked-in agent .md files under plugins/clagentic-lite/
# are never modified on disk.
#
# UNVERIFIED: whether Claude Code actually honors a subagent frontmatter
# `model:` field set to a non-standard string like "role:reviewer-chain" —
# vs. silently ignoring it and falling back to the parent session's model —
# has NOT been confirmed against a live interactive session from this
# codebase (claude-code GH#44385 territory; see README "Verifying on your
# machine" for the exact steps to confirm or refute this on a real machine).
# Leave this key unset until you have run that verification once.
# CLAGENTIC_ROUTER_INJECT_AGENT_MODEL=0

# CLAGENTIC_ROUTER_BEDROCK_MODE: separate opt-in, OFF by default even when
# CLAGENTIC_ROUTER_URL is set. Required for any Claude Code session that runs
# with CLAUDE_CODE_USE_BEDROCK=1 (Amazon Bedrock auth, e.g. an AWS SSO
# profile) to actually route through clagentic-router at all.
#
# WHY THIS IS NOT OPTIONAL FOR BEDROCK-MODE SESSIONS: CLAUDE_CODE_USE_BEDROCK=1
# makes Claude Code ignore ANTHROPIC_BASE_URL/ANTHROPIC_AUTH_TOKEN entirely —
# it speaks the AWS Bedrock Runtime InvokeModel wire protocol instead. The
# router integration above is SILENTLY inert for such a session: no error,
# no warning, `doctor` reports the router reachable while the session never
# talks to it. Setting CLAGENTIC_ROUTER_BEDROCK_MODE=1 additionally stamps
# ANTHROPIC_BEDROCK_BASE_URL (the Bedrock-mode equivalent of
# ANTHROPIC_BASE_URL) and AWS_BEARER_TOKEN_BEDROCK (a bearer-token
# alternative to full AWS SigV4 signing, per Claude Code's documented
# "Option E: Amazon Bedrock API keys",
# https://code.claude.com/docs/en/amazon-bedrock) into the same env block.
# CLAGENTIC_ROUTER_TOKEN is reused verbatim as AWS_BEARER_TOKEN_BEDROCK —
# same token, different variable name; clagentic-router's auth check does
# not distinguish which header/variable carried it.
#
# SUPPLEMENTS, DOES NOT REPLACE, the direct-API pair: both
# ANTHROPIC_BASE_URL/ANTHROPIC_AUTH_TOKEN AND
# ANTHROPIC_BEDROCK_BASE_URL/AWS_BEARER_TOKEN_BEDROCK are stamped together,
# because a single settings.json may be opened by sessions running in
# either auth mode (direct API/OAuth vs. Bedrock) -- each mode only reads
# the pair it understands and ignores the other, so stamping both is safe
# and correct regardless of which mode a given session uses. Replacing the
# direct-API pair instead would silently break any non-Bedrock session
# opened against the same repo.
#
# Requires CLAGENTIC_ROUTER_URL also set -- this key alone does nothing.
# CLAGENTIC_ROUTER_BEDROCK_MODE=0

# CLAGENTIC_ROUTER_BEDROCK_TOKEN: dedicated bearer-token source for the
# Bedrock pair (AWS_BEARER_TOKEN_BEDROCK) stamped above, DISTINCT from
# CLAGENTIC_ROUTER_TOKEN (which continues to feed only ANTHROPIC_AUTH_TOKEN,
# the direct-API pair). Prior to this key, CLAGENTIC_ROUTER_TOKEN was reused
# verbatim for both variable names -- nothing could distinguish a router
# admin token from a real AWS Bedrock bearer token by value alone (this was
# the root cause of an incident where the router's own local token was sent
# straight to a real Bedrock endpoint and 401'd). Leave unset to stamp an
# empty AWS_BEARER_TOKEN_BEDROCK (matching the pre-existing behavior for an
# unset CLAGENTIC_ROUTER_TOKEN) -- clagentic-lite never falls back to
# CLAGENTIC_ROUTER_TOKEN's value for this key.
# CLAGENTIC_ROUTER_BEDROCK_TOKEN=

# ---------- host auth-mode declaration (CLAGENTIC_AUTH_MODE) ----------
# ONE declared value, consumed everywhere a Bedrock-vs-direct-API auth
# decision is made, instead of every consumption site re-deriving it from
# ambient env. Unset by default (UNDECLARED) -- and UNDECLARED is defined to
# be exactly today's behavior for every existing install: no code path in
# this repo branches on CLAGENTIC_AUTH_MODE being unset, only on it matching
# one of the four values below.
#
# Values (closed set -- any other value is treated as UNDECLARED and
# `doctor` warns about the typo):
#   anthropic-oauth  — direct Anthropic API via OAuth (the common case;
#                       Claude Code's default auth, no router, no Bedrock).
#   enterprise       — direct Anthropic API via an Enterprise/API-key setup.
#   bedrock-sso      — Amazon Bedrock auth via an AWS SSO profile
#                       (CLAUDE_CODE_USE_BEDROCK=1, credentials sourced from
#                       an AWS SSO token cache -- see the SSO-cache
#                       preflight below).
#   bedrock-api-key  — Amazon Bedrock auth via a Bedrock API key/bearer
#                       token (Claude Code's documented "Option E"), no SSO
#                       cache involved.
#
# WHAT THIS DOES NOT DO: this key is deliberately NOT a value you should
# copy from documentation or another machine. It describes what auth THIS
# HOST actually uses. Set it once, on the machine where it is true, in
# ~/.config/clagentic/config or the enrolled repo's .clagentic/config --
# never hardcode a value here in a committed file, and never propagate one
# host's value to another host's config by copy-paste without checking it
# is still true there (AGENTS.md invariant 6: nothing host-specific
# hardcoded in code or shared defaults).
#
# CONSUMERS:
#   - scripts/llm-client.sh's invoke_claude: when CLAGENTIC_AUTH_MODE is
#     bedrock-sso or bedrock-api-key, every claude --print gate-path call
#     ensures CLAUDE_CODE_USE_BEDROCK=1 regardless of the calling session's
#     own ambient value -- this REPLACES the earlier, narrower predicate
#     (keying off ANTHROPIC_BEDROCK_BASE_URL being non-empty), which is
#     inert under an Enterprise/OAuth session-blanking payload that sets
#     the sentinel var to an EMPTY (but present) string.
#   - scripts/llm-client.sh's walk_chain: a mode-implied readiness preflight
#     runs before any review/gate LLM call. bedrock-sso reads the AWS SSO
#     token cache's expiresAt and fails fast (a degraded envelope, not a
#     hang) naming the expiry timestamp when it has already passed. Every
#     other mode (including UNDECLARED) is a no-op -- this preflight never
#     runs at all unless CLAGENTIC_AUTH_MODE=bedrock-sso specifically.
#   - `clagentic-lite doctor`: reports a contradiction when the declared
#     mode does not match observed ambient env (e.g. declared
#     anthropic-oauth but CLAUDE_CODE_USE_BEDROCK=1 is set in the shell
#     doctor runs in), naming both sources so the mismatch is visible
#     instead of silently trusted.
#
# CLAGENTIC_AUTH_MODE=

# CLAGENTIC_AUTH_MODE_SSO_CACHE_DIR: override the directory the bedrock-sso
# preflight scans for AWS SSO token cache files (each a JSON file with an
# "expiresAt" ISO-8601 field -- the standard `aws sso login` cache shape,
# https://docs.aws.amazon.com/cli/latest/userguide/sso-configure-profile-token.html).
# Defaults to $HOME/.aws/sso/cache, the AWS CLI's own default location.
# Override only if your SSO cache lives somewhere non-standard on this host
# (AGENTS.md invariant 6 -- never hardcode a host-specific path in code).
# CLAGENTIC_AUTH_MODE_SSO_CACHE_DIR=

# ---------- gate-path routing (optional, lr-02f048) ----------
# CLAGENTIC_<ROLE>_VIA_ROUTER: separate opt-in, OFF by default even when
# CLAGENTIC_ROUTER_URL is set. A THIRD, distinct integration point from
# both keys above (those affect an INTERACTIVE Claude Code session; this
# affects the GATE-PATH one-shot scripts/llm-client.sh call). Scoped to
# exactly two roles: reviewer, auditor. Builder AND Merge-Gate are both
# deliberately excluded -- both hold unrestricted Bash and do real
# multi-turn tool-calling, and every clagentic-router adapter currently
# declares SupportsTools=false (a routed request carrying tools gets
# refused with a 422, not silently degraded -- see clagentic-router's own
# adapter-capability work). Setting CLAGENTIC_GATE_VIA_ROUTER=1 below is a
# harmless no-op, not a working opt-in -- see docs/ROUTER.md §3
# "Merge-Gate is excluded" (lr-250d9d) for why it stays that way even
# though the key still exists for doctor to warn about a stale config.
# Reviewer/Auditor never carry a tools field on either CLI carrier today,
# so routing them is safe.
#
# When set to 1 for a role, that role's llm-client.sh calls POST to
# CLAGENTIC_ROUTER_URL's /v1/messages (model: role:<role>-chain, matching
# router.example.yaml's chain-name convention) instead of shelling out to
# CLAGENTIC_<ROLE>_CMD. Requires CLAGENTIC_ROUTER_URL to be set -- this key
# alone does nothing.
#
# CLAGENTIC_<ROLE>_CHAIN/_TIER become NO-OPS for a routed role -- they are
# only consulted by the FALLBACK path below, never by the router path
# itself. `clagentic-lite doctor` warns when both are configured for the
# same role, so this is visible rather than silently ignored.
#
# CLAGENTIC_ROUTER_URL IS VALIDATED BEFORE EVERY GATE-PATH POST (lr-02f048):
# invoke_router runs it through the same ds_router_url_classify
# (scripts/platform.sh) bin/clagentic-lite uses at stamp/probe time. A
# malformed URL, or a well-formed URL pointing at a non-local host, is
# REFUSED for the gate path -- stricter than the interactive-session stamp,
# which warns-but-allows a non-local host, because the gate path runs
# unattended with no operator to read that warning. Refusal never blocks
# the gate (falls through to the direct-CLI chain, same as Layer 2 below)
# but is always logged and loud -- see "THREE-WAY" below.
#
# THREE-WAY OUTCOME, all non-blocking, all logged, distinguishable:
#   Layer 0 -- invoke_router refused to POST at all (malformed/non-local
#     CLAGENTIC_ROUTER_URL). No request was sent; the bearer token was
#     never placed in a curl argument. Logged to audit.db with outcome
#     "router-refused" -- a distinct label from Layer 2's "router-fallback"
#     so "we refused this URL" is never indistinguishable from "the router
#     happened to be down."
#   Layer 1 -- the router's own scored/health-aware advance between
#     backends within its role:<role>-chain. Internal to the router
#     process; not observable from clagentic-lite at all (query the
#     router's own /logs for that signal).
#   Layer 2 -- the router itself is unreachable or degraded at call time,
#     so THIS gate falls back to the direct-CLI chain
#     (CLAGENTIC_<ROLE>_CMD/_CHAIN/_TIER) instead of blocking. Logged to
#     audit.db with outcome "router-fallback" (distinct from Layer 0 and
#     from the direct path's own pass/fallback/step-failed/degraded labels)
#     and printed loudly to stderr. No self-healing: the gate never
#     restarts or retries the router process, only probes once and reports.
# CLAGENTIC_REVIEWER_VIA_ROUTER=0
# CLAGENTIC_AUDITOR_VIA_ROUTER=0
# CLAGENTIC_GATE_VIA_ROUTER=0
