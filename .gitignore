# clagentic-lite local state
# NOTE: .clagentic/* (not .clagentic/) so git still descends into the
# directory to evaluate the loadout carve-out below -- a trailing-slash
# .clagentic/ pattern excludes the directory from traversal entirely and
# negation patterns for paths inside it are never evaluated.
.clagentic/*
# loadout enrollment config is tracked repo config, not local runtime state
!.clagentic/loadout
!.clagentic/loadout/config.yaml

# adversarial-acks.json is committed, audited suppression (docs/GATES.md
# "adversarial-acks.json" section) -- it must be un-ignored the same way the
# loadout config above is, or it can never be committed to the repo.
!.clagentic/adversarial-acks.json

# semgrep-exclude is a committed, per-repo SAST rule-exclusion ladder entry
# (docs/GATES.md Gate 4c "SAST", lr-321e18) -- same un-ignore treatment as
# adversarial-acks.json above, for the same reason: it's tracked policy, not
# local runtime state.
!.clagentic/semgrep-exclude
.env
.env.local

# editor
.vscode/
.idea/
*.swp
.DS_Store

# language ecosystems (example projects)
__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
*.log

# LORE local state (we use lore during dev but don't ship it)
.lore

# Claude Code lifecycle hooks + settings.json are installer-materialized
# (lr-57db23) from share/hook-shims/*.template via `clagentic-lite init` /
# `update` / `enroll --self` — never tracked source. .claude/commands/ stays
# tracked: it is the real symlink source enrolled repos point back to, not a
# generated artifact. See AGENTS.md file map + docs/DESIGN.md.
/.claude/hooks/
/.claude/settings.json
